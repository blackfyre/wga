package components

import (
	"strconv"

	"github.com/blackfyre/wga/internal/assets/templ/dto"
	"github.com/blackfyre/wga/internal/assets/templ/utils"
	itineraryworkflow "github.com/blackfyre/wga/internal/itineraries"
)

// ItineraryTray is the persistent itinerary tray rendered by the shared
// layout. It always mounts an #itinerary-tray element so add controls can
// target it, and only presents the dark-inverted fixed bar once the draft has
// stops, with the reference CLEAR and ARRANGE & NARRATE actions. Set oob to
// render the element as an HTMX out-of-band swap for mutation responses.
//
	// The shared bottom-stack observer measures the fixed region after full-page
	// and HTMX out-of-band renders, then reserves the same exact height for page
	// content, cookie notices, and toasts.
templ ItineraryTray(tray dto.ItineraryTrayView, oob bool) {
	<div
		id="itinerary-tray"
		if oob {
			hx-swap-oob="true"
		}
	>
		if tray.Count > 0 {
			<div data-wga-bottom-stack-item="itinerary" data-wga-bottom-stack-order="10" class="wga-bottom-stack-item fixed inset-x-0 z-[45] border-t border-wga-inv-fg/20 bg-wga-inv-bg animate-[wga-rise_240ms_cubic-bezier(0.22,0.61,0.36,1)]" role="region" aria-label="Itinerary draft">
				<div class="container mx-auto flex items-center gap-4 px-5 py-3 md:gap-7 md:px-10 md:py-3.5">
					<div class="min-w-0 flex-1">
						<p class="mb-1.5 font-mono text-(length:--t-10) tracking-[1.5px] text-wga-inv-fg/60">ITINERARY DRAFT · { strconv.Itoa(tray.Count) } OF { strconv.Itoa(itineraryworkflow.MaxStops) }</p>
						<div class="flex items-center gap-1.5" aria-hidden="true">
							for _, thumb := range tray.Thumbs {
								if thumb != "" {
									<img src={ thumb } alt="" class="h-7 w-7 border border-wga-inv-fg/25 bg-wga-inv-fg/10 object-cover"/>
								}
							}
						</div>
					</div>
					<div class="flex shrink-0 items-center gap-2">
						if csrf := utils.GetItineraryCSRF(ctx); csrf != "" {
							<form method="post" action="/itineraries/draft/clear" hx-post="/itineraries/draft/clear" hx-target="#itinerary-tray" hx-swap="outerHTML" hx-select="unset" hx-confirm="Clear all stops from this itinerary?">
								<input type="hidden" name="_csrf" value={ csrf }/>
								<button type="submit" class="px-1 py-2.5 font-mono text-(length:--t-11) tracking-[1.5px] text-wga-inv-fg/40 transition-colors hover:text-wga-inv-fg/90">CLEAR</button>
							</form>
						}
						<a href={ tray.BuilderURL } class="bg-wga-bg px-4 py-2.5 font-mono text-(length:--t-11) tracking-[1.5px] text-wga-ink transition-colors hover:bg-wga-surface-2">ARRANGE &amp; NARRATE →</a>
					</div>
				</div>
			</div>
		}
	</div>
}
