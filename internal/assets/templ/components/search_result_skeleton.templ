package components

// SearchResultSkeleton renders nine inert placeholders while HTMX refreshes an
// artwork or artist result set. aria-hidden keeps the live result count as the
// only announcement source.
templ SearchResultSkeleton(id string, view string) {
	<div id={ id } class="wga-search-skeleton" aria-hidden="true" data-search-result-skeleton data-skeleton-count="9">
		if view == "list" {
			<div class="border-t border-wga-ink/15">
				for i := 0; i < 9; i++ {
					<div class="flex min-h-[72px] items-center gap-4 border-b border-wga-ink/15 py-3">
						<span class="h-[54px] w-11 shrink-0 animate-pulse bg-wga-surface-2"></span>
						<span class="min-w-0 flex-1 space-y-2"><span class="block h-3 w-2/3 animate-pulse bg-wga-surface-2"></span><span class="block h-2.5 w-1/2 animate-pulse bg-wga-surface-2"></span></span>
					</div>
				}
			</div>
		} else {
			<div class="grid grid-cols-2 gap-x-4 gap-y-9 md:grid-cols-3 md:gap-x-7">
				for i := 0; i < 9; i++ {
					<div>
						<div class="aspect-[4/5] animate-pulse bg-wga-surface-2"></div>
						<div class="mt-3 h-3 w-3/4 animate-pulse bg-wga-surface-2"></div>
						<div class="mt-2 h-2.5 w-1/2 animate-pulse bg-wga-surface-2"></div>
					</div>
				}
			</div>
		}
	</div>
}
