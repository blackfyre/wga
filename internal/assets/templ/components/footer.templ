package components

templ Footer() {
	<footer class="site-footer">
		<div class="site-footer__inner">
			<a class="site-footer__brand" href="/" hx-get="/">
				<span>Web Gallery of Art</span>
				<small>Providing experience since 1992</small>
			</a>
			<nav class="site-footer__links" aria-label="Footer navigation">
				<a href="/contributors" hx-get="/contributors">Contributors</a>
				<a href="/pages/privacy-policy" hx-get="/pages/privacy-policy">Privacy policy</a>
				<a data-cc="show-preferencesModal" href="#">Cookie settings</a>
				<a href="/open-source-licences" hx-get="/open-source-licences">Open-source licences</a>
			</nav>
			<div class="site-footer__meta">
				<p>© Web Gallery of Art, created by Emil Krén and Daniel Marx.</p>
				<p>Support the Gallery on <a href="https://ko-fi.com/blackfyre" target="_blank" rel="noreferrer">Ko-fi</a> or <a href="https://github.com/sponsors/blackfyre" target="_blank" rel="noreferrer">GitHub Sponsors</a>.</p>
				<p>Open source on <a href="https://github.com/blackfyre/wga" target="_blank" rel="noreferrer" aria-label="GitHub">GitHub</a>.</p>
			</div>
		</div>
	</footer>
}
