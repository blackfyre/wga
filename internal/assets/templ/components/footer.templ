package components

import (
	"context"

	"github.com/blackfyre/wga/internal/assets/templ/dto"
	"github.com/blackfyre/wga/internal/assets/templ/utils"
)

templ Footer() {
	<footer class="border-t border-base-content/15 pb-15 pt-10">
		<div class="container mx-auto grid grid-cols-2 gap-[32px] px-4 text-sm lg:grid-cols-[1.6fr_1fr_1fr_1fr] md:px-0">
			<div class="min-w-0">
				<p class="mb-3 font-mono text-[11px] tracking-[1.5px]">WEB GALLERY OF ART</p>
				<p class="max-w-full wrap-anywhere text-sm leading-relaxed text-base-content/70">A searchable archive of European fine art, decorative art and architecture, 3rd century to the early 20th. Open source, maintained by contributors.</p>
			</div>
			<div class="min-w-0">
				<p class="mb-3 font-mono text-[11px] tracking-[1.5px] text-base-content/60">BROWSE</p>
				<ul class="space-y-1 wrap-anywhere text-sm leading-[2.1] text-base-content/70">
					<li>
						<a
							class={ "hover:text-primary", templ.KV("text-primary", footerPathActive(ctx, "/artists")) }
							href="/artists"
							hx-get="/artists"
							if footerPathActive(ctx, "/artists") {
								aria-current="page"
							}
						>Artists</a>
					</li>
					<li>
						<a
							class={ "hover:text-primary", templ.KV("text-primary", footerPathActive(ctx, "/artworks")) }
							href="/artworks"
							hx-get="/artworks"
							if footerPathActive(ctx, "/artworks") {
								aria-current="page"
							}
						>Artworks</a>
					</li>
					<li>
						<a
							class={ "hover:text-primary", templ.KV("text-primary", footerPathActive(ctx, "/timeline")) }
							href="/timeline"
							if footerPathActive(ctx, "/timeline") {
								aria-current="page"
							}
						>Timeline</a>
					</li>
					<li>
						<a
							class={ "hover:text-primary", templ.KV("text-primary", footerPathActive(ctx, "/inspire")) }
							href="/inspire"
							hx-get="/inspire"
							if footerPathActive(ctx, "/inspire") {
								aria-current="page"
							}
						>Inspiration</a>
					</li>
					<li>
						<a
							class={ "hover:text-primary", templ.KV("text-primary", footerPathActive(ctx, "/tours")) }
							href="/tours"
							if footerPathActive(ctx, "/tours") {
								aria-current="page"
							}
						>Guided tours</a>
					</li>
					<li>
						<a
							class={ "hover:text-primary", templ.KV("text-primary", footerPathActive(ctx, "/itineraries")) }
							href="/itineraries"
							if footerPathActive(ctx, "/itineraries") {
								aria-current="page"
							}
						>Itineraries</a>
					</li>
					<li>
						<a
							class={ "hover:text-primary", templ.KV("text-primary", footerPathActive(ctx, "/glossary")) }
							href="/glossary"
							if footerPathActive(ctx, "/glossary") {
								aria-current="page"
							}
						>Glossary</a>
					</li>
				</ul>
			</div>
			<div class="min-w-0">
				<p class="mb-3 font-mono text-[11px] tracking-[1.5px] text-base-content/60">SERVICES</p>
				<ul class="space-y-1 wrap-anywhere text-sm leading-[2.1] text-base-content/70">
					<li>
						<a
							class={ "hover:text-primary", templ.KV("text-primary", footerPathActive(ctx, "/postcard")) }
							href="/postcard"
							hx-get="/postcard"
							if footerPathActive(ctx, "/postcard") {
								aria-current="page"
							}
						>Postcards</a>
					</li>
					<li>Period music</li>
					<li>
						<a
							class={ "hover:text-primary", templ.KV("text-primary", footerPathActive(ctx, "/dual-mode")) }
							href="/dual-mode"
							hx-get="/dual-mode"
							if footerPathActive(ctx, "/dual-mode") {
								aria-current="page"
							}
						>Dual mode</a>
					</li>
					<li>
						<a
							class={ "hover:text-primary", templ.KV("text-primary", footerPathActive(ctx, "/guestbook")) }
							href="/guestbook"
							hx-get="/guestbook"
							if footerPathActive(ctx, "/guestbook") {
								aria-current="page"
							}
						>Guestbook</a>
					</li>
				</ul>
			</div>
			<div class="min-w-0">
				<p class="mb-3 font-mono text-[11px] tracking-[1.5px] text-base-content/60">ABOUT</p>
				<ul class="space-y-1 wrap-anywhere text-sm leading-[2.1] text-base-content/70">
					<li>
						<a
							class={ "hover:text-primary", templ.KV("text-primary", footerPathActive(ctx, "/pages/privacy-policy")) }
							href="/pages/privacy-policy"
							hx-get="/pages/privacy-policy"
							if footerPathActive(ctx, "/pages/privacy-policy") {
								aria-current="page"
							}
						>Privacy policy</a>
					</li>
					<li>
						<a
							class={ "hover:text-primary", templ.KV("text-primary", footerPathActive(ctx, "/pages/about")) }
							href="/pages/about"
							hx-get="/pages/about"
							if footerPathActive(ctx, "/pages/about") {
								aria-current="page"
							}
						>About the collection</a>
					</li>
					<li>
						<a
							class={ "hover:text-primary", templ.KV("text-primary", footerPathActive(ctx, "/statistics")) }
							href="/statistics"
							hx-get="/statistics"
							if footerPathActive(ctx, "/statistics") {
								aria-current="page"
							}
						>Statistics</a>
					</li>
					<li>
						<a
							class={ "hover:text-primary", templ.KV("text-primary", footerPathActive(ctx, "/contributors")) }
							href="/contributors"
							hx-get="/contributors"
							if footerPathActive(ctx, "/contributors") {
								aria-current="page"
							}
						>Contributors</a>
					</li>
					<li>
						<a
							class={ "hover:text-primary", templ.KV("text-primary", footerPathActive(ctx, "/open-source-licences")) }
							href="/open-source-licences"
							hx-get="/open-source-licences"
							if footerPathActive(ctx, "/open-source-licences") {
								aria-current="page"
							}
						>Open-source licences</a>
					</li>
					<li><a aria-hidden="true" class="hidden hover:text-primary" data-cc="show-preferencesModal" data-wga-cookie-settings href="#" tabindex="-1">Cookie settings</a></li>
					<li>Contact</li>
				</ul>
			</div>
		</div>
		<div class="container mx-auto mt-8 flex flex-wrap items-center justify-between gap-4 px-4 md:px-0">
			<p class="min-w-0 font-mono text-[10px] tracking-[0.5px] text-base-content/50">© WEB GALLERY OF ART, CREATED BY EMIL KRÉN AND DANIEL MARX</p>
			@PreferencesControl(utils.GetPreferences(ctx))
		</div>
	</footer>
}

var footerDestinations = []string{
	"/artists", "/artworks", "/timeline", "/inspire", "/tours", "/itineraries", "/glossary", "/postcard", "/dual-mode", "/guestbook", "/pages/privacy-policy", "/pages/about", "/statistics", "/contributors", "/open-source-licences",
}

func footerPathActive(ctx context.Context, href string) bool {
	return utils.IsPathActive(ctx, href, footerDestinations)
}

// PreferencesControl is the single footer preferences mount: a hidden-until-JS
// trigger whose summary and split swatch state the active settings, plus the
// native labelled dialog it opens. The dialog sits outside the hidden wrapper
// so it can open in the top layer without inheriting aria-hidden.
templ PreferencesControl(prefs dto.Preferences) {
	<div data-wga-preferences-control aria-hidden="true" class="hidden">
		<button
			type="button"
			data-wga-preferences-open
			aria-haspopup="dialog"
			class="flex min-h-[40px] shrink-0 cursor-pointer items-center gap-[10px] border border-base-content/25 px-[14px] py-[9px] font-mono text-[10px] tracking-[1.5px] text-base-content/60 transition-colors hover:border-base-content hover:text-base-content"
		>
			<span data-wga-preferences-swatch aria-hidden="true" class="h-3 w-3 shrink-0 outline outline-base-content/25" style={ dto.PaletteSwatchStyle(prefs.Palette) }></span>
			<span>PREFERENCES</span>
			<span data-wga-preferences-summary class="hidden text-[9px] text-base-content/50 md:inline">{ dto.PreferencesSummary(prefs) }</span>
		</button>
	</div>
	@PreferencesPanel(prefs)
}

templ PreferencesPanel(prefs dto.Preferences) {
	<dialog
		id="wga-preferences"
		data-wga-preferences-panel
		aria-label="Preferences"
		class="wga-preferences bg-base-100 p-0 text-base-content backdrop:bg-base-content/45"
	>
		<div class="sticky top-0 z-10 flex shrink-0 items-center justify-between gap-4 border-b border-base-content bg-base-100 px-6 py-5">
			<span class="font-mono text-[11px] tracking-[1.5px] text-base-content">PREFERENCES</span>
			<button
				type="button"
				data-wga-preferences-close
				class="flex min-h-11 min-w-11 cursor-pointer items-center justify-center border border-base-content/25 px-3 py-2 font-mono text-[10px] tracking-[1.5px] text-base-content/60 transition-colors hover:bg-base-300"
			>CLOSE</button>
		</div>
		<div class="flex flex-col gap-8 p-6">
			<section class="flex flex-col gap-3">
				<div class="flex flex-col gap-1">
					<h2 class="font-mono text-[10px] tracking-[1.5px] text-base-content/60">APPEARANCE</h2>
					<p data-wga-scheme-explanation class="text-[13px]/[1.5] text-pretty text-base-content/75">{ schemeExplanation(prefs) }</p>
				</div>
				<div class="flex w-fit shrink-0 gap-px bg-base-content/20" role="group" aria-label="Colour scheme">
					@SchemeSegment("light", "LIGHT", prefs)
					@SchemeSegment("dark", "DARK", prefs)
				</div>
			</section>
			<section class="flex flex-col gap-3">
				<div class="flex flex-col gap-1">
					<h2 class="font-mono text-[10px] tracking-[1.5px] text-base-content/60">PALETTE</h2>
					<p class="text-[13px]/[1.5] text-pretty text-base-content/75">Each palette is a light and dark pair. Choosing one keeps whichever half you are reading in.</p>
				</div>
				<div class="flex flex-col gap-[18px]" role="radiogroup" aria-label="Colour palette">
					for _, group := range dto.PaletteGroups() {
						<div class="flex flex-col gap-2">
							<h3 class="font-mono text-[9px] tracking-[1.5px] text-base-content/60">{ group }</h3>
							<div class="flex flex-col gap-px bg-base-content/15">
								for _, option := range dto.PaletteOptions {
									if option.Group == group {
										@PaletteRow(option, prefs.Palette)
									}
								}
							</div>
						</div>
					}
				</div>
			</section>
			<section class="flex flex-col gap-3">
				<div class="flex flex-col gap-1">
					<h2 class="font-mono text-[10px] tracking-[1.5px] text-base-content/60">READING</h2>
					<p class="text-[13px]/[1.5] text-pretty text-base-content/75">Bionic reading bolds the opening letters of each word in running text. Catalogue data and labels are left alone.</p>
				</div>
				@BionicReadingToggle(prefs.Bionic)
			</section>
			<p class="border-t border-base-content/15 pt-4 text-[12px]/[1.6] text-pretty text-base-content/60">Preferences are kept on this device only. Nothing here is sent to the archive.</p>
		</div>
	</dialog>
}

// SchemeSegment is one LIGHT/DARK choice. A dark-only palette disables LIGHT
// with a reason rather than deselecting it.
templ SchemeSegment(value string, label string, prefs dto.Preferences) {
	<button
		type="button"
		data-wga-scheme={ value }
		aria-pressed={ boolAttr(schemePressed(value, prefs)) }
		disabled?={ dto.DarkOnlyPalette(prefs.Palette) && value == "light" }
		if dto.DarkOnlyPalette(prefs.Palette) && value == "light" {
			title={ dto.PaletteLabel(prefs.Palette) + " is a dark-only palette" }
		}
		class={ "flex min-h-[44px] items-center px-5 font-mono text-[10px] tracking-[1.5px] transition-colors disabled:cursor-not-allowed disabled:opacity-40",
			templ.KV("cursor-pointer bg-primary text-primary-content", schemePressed(value, prefs)),
			templ.KV("cursor-pointer bg-base-100 text-base-content/75 hover:text-base-content", !schemePressed(value, prefs)) }
	>{ label }</button>
}

// PaletteRow is one grouped provenance radio choice, identified by label plus a
// split paper/ink swatch so colour is not its sole identifier.
templ PaletteRow(option dto.PaletteOption, current string) {
	<button
		type="button"
		role="radio"
		data-wga-palette={ option.Key }
		data-wga-palette-label={ option.Label }
		aria-checked={ boolAttr(paletteActive(option, current)) }
		class={ "flex min-h-[44px] cursor-pointer items-center gap-[14px] px-4 py-[14px] text-left transition-colors",
			templ.KV("bg-primary/10 shadow-[inset_3px_0_0_var(--color-primary)]", paletteActive(option, current)),
			templ.KV("bg-base-100 hover:bg-base-200", !paletteActive(option, current)) }
	>
		<span aria-hidden="true" class="h-[26px] w-[26px] shrink-0 outline outline-base-content/25" style={ dto.PaletteSwatchStyle(option.Key) }></span>
		<span class="flex min-w-0 flex-col gap-[3px]">
			<span data-wga-palette-name class={ "font-mono text-[11px] tracking-[1.5px]", templ.KV("text-primary", paletteActive(option, current)), templ.KV("text-base-content", !paletteActive(option, current)) }>{ option.Label }</span>
			<span class="text-[12px]/[1.45] text-pretty text-base-content/60">{ option.Desc }</span>
		</span>
		if paletteActive(option, current) {
			<span data-wga-palette-in-use class="ml-auto shrink-0 font-mono text-[9px] tracking-[1.5px] text-primary">IN USE</span>
		}
	</button>
}

// BionicReadingToggle keeps the existing bionic-reading contract: a hidden
// control the client reveals once it has initialised the prose transform.
templ BionicReadingToggle(on bool) {
	<div data-wga-bionic-control class="hidden items-center gap-2">
		if on {
			<button type="button" role="switch" aria-label="Bionic reading" aria-checked="true" data-wga-bionic-toggle class="border border-primary bg-primary px-2 py-1 font-mono text-[10px] tracking-[1px] text-primary-content transition-colors hover:text-base-content">BIONIC</button>
		} else {
			<button type="button" role="switch" aria-label="Bionic reading" aria-checked="false" data-wga-bionic-toggle class="border border-base-content/20 bg-base-100 px-2 py-1 font-mono text-[10px] tracking-[1px] text-base-content/75 transition-colors hover:text-base-content">BIONIC</button>
		}
	</div>
}

func boolAttr(v bool) string {
	if v {
		return "true"
	}
	return "false"
}

// paletteActive reports whether the palette row is the current selection. An
// unset palette marks the default bone row, since that is what is served.
func paletteActive(option dto.PaletteOption, current string) bool {
	return current == option.Key || (current == "" && option.Key == dto.DefaultPaletteKey)
}

// schemePressed reports which scheme segment is active. A dark-only palette
// always marks DARK; an unset scheme marks neither so the control does not lie
// about a preference the server cannot see.
func schemePressed(value string, prefs dto.Preferences) bool {
	if dto.DarkOnlyPalette(prefs.Palette) {
		return value == "dark"
	}
	return prefs.Scheme == value
}

// schemeExplanation states the appearance guidance honestly, including the
// dark-only reason when LIGHT is unavailable.
func schemeExplanation(prefs dto.Preferences) string {
	if dto.DarkOnlyPalette(prefs.Palette) {
		return dto.PaletteLabel(prefs.Palette) + " has no light build, so light is unavailable while it is chosen."
	}
	return "Follows your system setting until you choose here."
}
