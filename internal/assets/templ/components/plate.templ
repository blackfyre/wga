package components

import "github.com/blackfyre/wga/internal/assets/templ/dto"

templ Plate(plate dto.Plate) {
	<div class={ "flex items-end border border-base-content/15 bg-base-300 p-2.5", plate.Aspect, templ.KV("justify-center", plate.Aspect == "") }>
		if plate.DisplayURL != "" {
			if plate.ZoomURL != "" {
				<a href={ templ.SafeURL(plate.ZoomURL) } class="relative block h-full w-full" data-viewer data-viewer-label={ plateLabel(plate) } aria-label={ plateLabel(plate) }>
					<img src={ plate.DisplayURL } alt={ plate.Alt } loading="lazy" data-zoom-url={ plate.ZoomURL } class={ templ.KV("h-auto w-full", plate.Aspect == ""), templ.KV("h-full w-full", plate.Aspect != ""), templ.KV("object-contain", plate.Contain && plate.Aspect != ""), templ.KV("object-cover", !plate.Contain && plate.Aspect != "") }/>
					@ZoomHint()
				</a>
			} else {
				<img src={ plate.DisplayURL } alt={ plate.Alt } loading="lazy" class={ templ.KV("h-auto w-full", plate.Aspect == ""), templ.KV("h-full w-full", plate.Aspect != ""), templ.KV("object-contain", plate.Contain && plate.Aspect != ""), templ.KV("object-cover", !plate.Contain && plate.Aspect != "") }/>
			}
		} else {
			<span class="font-mono text-(length:--t-9) uppercase tracking-[0.5px] text-faint-2 text-pretty">{ platePlaceholder(plate) }</span>
		}
	</div>
}

templ ZoomHint() {
	<span class="pointer-events-none absolute right-3 bottom-3 flex items-center gap-2 bg-neutral py-1.5 pl-[7px] pr-[9px] text-neutral-content">
		<svg width="13" height="13" viewBox="0 0 13 13" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true">
			<circle cx="5.4" cy="5.4" r="4"></circle>
			<path d="M8.4 8.4 L12 12"></path>
			<path d="M3.6 5.4h3.6M5.4 3.6v3.6"></path>
		</svg>
		<span class="font-mono text-(length:--t-9) tracking-[1.5px]">CLICK TO ZOOM</span>
	</span>
}

func plateLabel(plate dto.Plate) string {
	if plate.Label != "" {
		return plate.Label
	}

	return "View larger image"
}

func platePlaceholder(plate dto.Plate) string {
	if plate.Placeholder != "" {
		return plate.Placeholder
	}

	return "Image unavailable"
}
