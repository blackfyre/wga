package components

type KeyboardSuggestion struct {
	Kind  string
	Label string
	Href  string
}

templ KeyboardLayer() {
	<dialog id="keyboard-palette" class="w-full max-w-xl border border-base-content bg-base-100 p-0 text-base-content" aria-label="Go to">
		<div class="border-b border-base-content px-5 py-4">
			<label class="flex items-center gap-3"><span class="font-mono text-[10px] tracking-[1.5px] text-base-content/60">GO TO</span><input type="search" data-keyboard-search autocomplete="off" placeholder="Artist or artwork" aria-label="Search artists and artworks" class="min-w-0 flex-1 border-0 bg-transparent p-0 text-base outline-none"/></label>
		</div>
		<div class="max-h-[50vh] overflow-y-auto" data-keyboard-suggestions></div>
		<div class="border-t border-base-content/15 px-5 py-3 font-mono text-[10px] tracking-[1px] text-base-content/60">↑↓ MOVE · ↵ OPEN · ESC CLOSE</div>
	</dialog>
	<dialog id="keyboard-help" class="w-full max-w-2xl border border-base-content bg-base-100 p-0 text-base-content" aria-labelledby="keyboard-help-title">
		<div class="p-6">
			<div class="flex items-start justify-between gap-6 border-b border-base-content pb-4"><div><p class="mb-2 font-mono text-[10px] tracking-[1.5px] text-base-content/60">KEYBOARD</p><h2 id="keyboard-help-title" class="text-[22px] font-semibold">Moving without the mouse</h2></div><button type="button" data-keyboard-close aria-label="Close shortcuts" class="font-mono text-sm text-base-content/60">✕</button></div>
			<div class="mt-6 grid gap-6 md:grid-cols-2"><div><p class="border-b border-base-content/15 pb-2 font-mono text-[10px] tracking-[1px] text-base-content/60">BROWSING</p><p class="border-b border-base-content/10 py-2 text-sm"><kbd>↑ ↓</kbd> Move a result</p><p class="border-b border-base-content/10 py-2 text-sm"><kbd>↵</kbd> Open the marked result</p><p class="border-b border-base-content/10 py-2 text-sm"><kbd>/</kbd> Focus page search</p></div><div><p class="border-b border-base-content/15 pb-2 font-mono text-[10px] tracking-[1px] text-base-content/60">NAVIGATION</p><p class="border-b border-base-content/10 py-2 text-sm"><kbd>⌘K</kbd> Open Go to</p><p class="border-b border-base-content/10 py-2 text-sm"><kbd>?</kbd> Open this help</p><p class="border-b border-base-content/10 py-2 text-sm"><kbd>ESC</kbd> Close a dialog</p></div></div>
		</div>
	</dialog>
}

templ KeyboardSuggestionRows(rows []KeyboardSuggestion) {
	for _, row := range rows {
		<a href={ templ.URL(row.Href) } class="flex items-center gap-4 border-b border-base-content/15 px-5 py-3 text-sm hover:bg-primary/5" data-keyboard-item><span class="w-16 shrink-0 font-mono text-[10px] tracking-[1px] text-base-content/60">{ row.Kind }</span><span>{ row.Label }</span></a>
	}
}
