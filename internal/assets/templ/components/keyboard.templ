package components

import (
	"encoding/json"
	"fmt"
)

type KeyboardScreen struct {
	Key   string `json:"key"`
	Num   string `json:"num"`
	Label string `json:"label"`
	Href  string `json:"href"`
}

var KeyboardScreens = []KeyboardScreen{
	{Key: "H", Num: "00", Label: "HOME", Href: "/"},
	{Key: "A", Num: "01", Label: "ARTIST INDEX", Href: "/artists"},
	{Key: "P", Num: "04", Label: "POSTCARD SERVICE", Href: "/postcard"},
	{Key: "I", Num: "07", Label: "INSPIRATION", Href: "/inspire"},
	{Key: "D", Num: "09", Label: "DUAL MODE", Href: "/dual-mode"},
	{Key: "G", Num: "10", Label: "GUESTBOOK", Href: "/guestbook"},
	{Key: "C", Num: "11", Label: "CONTRIBUTORS", Href: "/contributors"},
	{Key: "W", Num: "12", Label: "ARTWORK SEARCH", Href: "/artworks"},
	{Key: "L", Num: "13", Label: "GLOSSARY", Href: "/glossary"},
	{Key: "B", Num: "14", Label: "ABOUT THE COLLECTION", Href: "/pages/about"},
	{Key: "N", Num: "15", Label: "STATISTICS", Href: "/statistics"},
}

type KeyboardSuggestion struct {
	Kind  string
	Label string
	Href  string
}

templ KeyboardLayer() {
	<div id="kbd-screens" hidden data-json={ keyboardScreensJSON() }></div>
	<div class="wga-kbd-bar" role="status" aria-live="off">
		<span class="font-mono text-[10px] tracking-[1.5px] text-base-content">KEYBOARD</span>
		<span class="h-3 w-px bg-base-content/25" aria-hidden="true"></span>
		<span class="flex items-center gap-1.5"><span class="wga-kbd-key">↑↓</span><span class="font-mono text-[10px] tracking-[1px] text-base-content/60">MOVE</span></span>
		<span class="flex items-center gap-1.5"><span class="wga-kbd-key">⌘K</span><span class="font-mono text-[10px] tracking-[1px] text-base-content/60">GO TO</span></span>
		<span class="flex items-center gap-1.5"><span class="wga-kbd-key">/</span><span class="font-mono text-[10px] tracking-[1px] text-base-content/60">SEARCH</span></span>
		<span class="flex-1"></span>
		<span id="kbd-num" class="font-mono text-[10px] tracking-[1.5px] text-primary"></span>
		<button type="button" data-keyboard-help class="font-mono text-[10px] tracking-[1px] text-primary">? ALL KEYS</button>
	</div>
	<dialog id="keyboard-palette" class="wga-kbd-dialog" aria-label="Go to">
		<div class="wga-kbd-palette">
			<div class="flex items-center gap-3 border-b border-base-content px-5 py-4">
				<span class="shrink-0 font-mono text-[10px] tracking-[1.5px] text-base-content/60">GO TO</span>
				<input type="search" data-kbd-query autocomplete="off" placeholder="Section, artist or work" aria-label="Search sections, artists and works" class="min-w-0 flex-1 border-0 bg-transparent p-0 text-base outline-none"/>
			</div>
			<div id="kbd-palette-results" class="max-h-[46vh] overflow-y-auto overscroll-contain">
				for _, screen := range KeyboardScreens {
					<a href={ templ.URL(screen.Href) } data-kbd-item="section" data-kbd-key={ screen.Key } data-kbd-num={ screen.Num } data-kbd-label={ screen.Label } data-kbd-href={ screen.Href } class="wga-kbd-row">
						<span class="w-16 shrink-0 font-mono text-[10px] tracking-[1px] text-base-content/60">SECTION</span>
						<span class="min-w-0 flex-1 truncate font-mono text-[11px] tracking-[1px]">{ screen.Label }</span>
						<span class="wga-kbd-key shrink-0">{ screen.Key }</span>
					</a>
				}
				<div id="kbd-palette-records" data-kbd-suggest="/keyboard/suggestions"></div>
			</div>
			<div class="border-t border-base-content/15 px-5 py-3 font-mono text-[10px] tracking-[1px] text-base-content/60">↑↓ MOVE · ↵ GO · ESC CLOSE</div>
		</div>
	</dialog>
	<dialog id="keyboard-help" class="wga-kbd-dialog" aria-labelledby="keyboard-help-title">
		<div class="wga-kbd-help">
			<div class="flex items-start justify-between gap-6 border-b border-base-content pb-4"><div><p class="mb-2 font-mono text-[10px] tracking-[1.5px] text-base-content/60">KEYBOARD</p><h2 id="keyboard-help-title" class="text-[22px] font-semibold">Moving without the mouse</h2></div><button type="button" data-keyboard-close aria-label="Close shortcuts" class="font-mono text-sm text-base-content/60">✕</button></div>
			<div class="mt-6 grid gap-6 md:grid-cols-2"><div><p class="border-b border-base-content/15 pb-2 font-mono text-[10px] tracking-[1px] text-base-content/60">BROWSING</p><p class="border-b border-base-content/10 py-2 text-sm"><kbd>↑ ↓ / J K</kbd> Move a row</p><p class="border-b border-base-content/10 py-2 text-sm"><kbd>← →</kbd> Move one record</p><p class="border-b border-base-content/10 py-2 text-sm"><kbd>↵</kbd> Open the marked record</p><p class="border-b border-base-content/10 py-2 text-sm"><kbd>ESC</kbd> Clear the marker or close</p></div><div><p class="border-b border-base-content/15 pb-2 font-mono text-[10px] tracking-[1px] text-base-content/60">FINDING</p><p class="border-b border-base-content/10 py-2 text-sm"><kbd>/</kbd> Focus search</p><p class="border-b border-base-content/10 py-2 text-sm"><kbd>⌘K</kbd> Open Go to</p><p class="border-b border-base-content/10 py-2 text-sm"><kbd>00–15</kbd> Go to a section</p><p class="border-b border-base-content/10 py-2 text-sm"><kbd>?</kbd> Open this help</p></div></div>
			<div class="mt-6">
				<p class="border-b border-base-content/15 pb-2 font-mono text-[10px] tracking-[1px] text-base-content/60">SECTIONS</p>
				for _, screen := range KeyboardScreens {
					<p class="border-b border-base-content/10 py-2 text-sm"><kbd>{ screen.Key }</kbd> { fmt.Sprintf("%s · %s", screen.Num, screen.Label) }</p>
				}
			</div>
		</div>
	</dialog>
}

templ KeyboardCaret() {
	<span class="wga-kbd-caret" aria-hidden="true">▸</span>
}

templ KeyboardSuggestionRows(rows []KeyboardSuggestion) {
	for _, row := range rows {
		<a href={ templ.URL(row.Href) } data-kbd-item="record" data-kbd-href={ row.Href } class="wga-kbd-row"><span class="w-16 shrink-0 font-mono text-[10px] tracking-[1px] text-base-content/60">{ row.Kind }</span><span class="min-w-0 flex-1 truncate">{ row.Label }</span></a>
	}
}

func keyboardScreensJSON() string {
	payload, err := json.Marshal(KeyboardScreens)
	if err != nil {
		return "[]"
	}

	return string(payload)
}
