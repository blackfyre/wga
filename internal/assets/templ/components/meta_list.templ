package components

type MetaEntry struct {
	Label string
	Value string
}

templ MetaList(entries []MetaEntry) {
	<dl class="border-t border-base-content/15">
		for _, entry := range entries {
			<div class="flex items-baseline justify-between gap-4 border-b border-base-content/15 py-3">
				<dt class="font-mono text-[10px] tracking-[1.2px] text-base-content/60">{ entry.Label }</dt>
				<dd class="text-right text-sm">{ entry.Value }</dd>
			</div>
		}
	</dl>
}
