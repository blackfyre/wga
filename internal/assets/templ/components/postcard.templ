package components

type PostcardEditorDTO struct {
	ImageId    string
	Image      string
	Title      string
	Technique  string
	Comment    string
	AuthorName string
	SiteKey    string
}

templ PostcardEditor(p PostcardEditorDTO) {
	@DialogBody() {
		<div class="border-b border-wga-ink pb-4 pr-8">
			<p class="font-mono text-[11px] tracking-[2px] text-wga-ink/60">04 — POSTCARD SERVICE</p>
			<h1 data-dialog-title class="mt-2 text-[30px] font-semibold tracking-[-0.5px]">Send a postcard</h1>
			<p class="mt-3 max-w-[520px] text-sm leading-relaxed text-wga-ink/70">Free service. The recipient receives a link to the artwork with your message; no account is needed and no address is stored after delivery.</p>
		</div>
		<div class="grid gap-7 pt-6 md:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)]">
			<aside>
				<figure class="border border-wga-ink/15 bg-wga-fill p-2"><img src={ p.Image } alt={ p.Title + " by " + p.AuthorName } class="aspect-[4/3] w-full object-cover"/></figure>
				<h2 class="mt-3 text-lg font-semibold">{ p.Title }</h2>
				if p.AuthorName != "" {
					<p class="mt-1 font-mono text-[10px] tracking-[1px] text-wga-accent">{ p.AuthorName }</p>
				}
				if p.Technique != "" {
					<p class="mt-1 font-mono text-[10px] tracking-[1px] text-wga-ink/60">{ p.Technique }</p>
				}
				<div class="content mt-4 text-sm leading-relaxed">@templ.Raw(p.Comment)</div>
			</aside>
			<form hx-post="/postcard" enctype="multipart/form-data" hx-target="#d" id="postcard_create" hx-disabled-elt="input,button,select" class="space-y-5">
				<input type="hidden" name="image_id" value={ p.ImageId }/>
				<div class="grid gap-4 sm:grid-cols-2">
					<label class="block font-mono text-[10px] tracking-[1px]">NAME<input class="mt-2 w-full border border-wga-ink/30 bg-transparent px-3 py-2.5 font-sans text-sm tracking-normal" type="text" name="sender_name" id="sender_name" placeholder="My name" required autocomplete="name"/></label>
					<label class="block font-mono text-[10px] tracking-[1px]">EMAIL<input class="mt-2 w-full border border-wga-ink/30 bg-transparent px-3 py-2.5 font-sans text-sm tracking-normal" type="email" name="sender_email" id="sender_email" placeholder="My email address" autocomplete="email" required/></label>
				</div>
				<div>
					<p class="font-mono text-[10px] tracking-[1px]">RECIPIENTS</p>
					<div id="recipients-array" class="mt-2 space-y-2">
						<label class="flex items-center gap-2 border border-wga-ink/30 px-3 py-1.5"><span class="sr-only">Recipient email</span><input type="text" class="min-w-0 grow bg-transparent py-1 text-sm outline-none" name="recipients[]" placeholder="friend@provider.tld" autocomplete="email" required/><button type="button" class="shrink-0 font-mono text-xs text-wga-ink/60 hover:text-wga-ink" title="Remove recipient" data-cloner-remove-me>REMOVE</button></label>
					</div>
					<button type="button" class="mt-3 font-mono text-[10px] tracking-[1px] text-wga-accent hover:opacity-60" data-cloner-target="#recipients-array">ADD RECIPIENT +</button>
				</div>
				<div>
					<label for="message" class="font-mono text-[10px] tracking-[1px]">MESSAGE</label>
					<div class="mt-2 border border-wga-ink/30 bg-wga-bg"><trix-editor input="message"></trix-editor></div>
					<input type="hidden" id="message" name="message"/>
				</div>
				<label class="flex items-start gap-3 text-sm leading-relaxed"><input type="checkbox" name="notify_sender" value="true" checked="checked" class="mt-1"/><span>Notify me the first time the postcard is viewed</span></label>
				<label aria-hidden="true" class="hpt" for="name"></label>
				<input aria-hidden="true" class="hpt" autocomplete="off" type="text" id="name" name="name" placeholder="Your name here"/>
				<label aria-hidden="true" class="hpt" for="email"></label>
				<input aria-hidden="true" class="hpt" autocomplete="off" type="email" id="email" name="email" placeholder="Your e-mail here"/>
				if p.SiteKey != "" {
					<script src="https://www.google.com/recaptcha/api.js" async defer></script>
					<div class="g-recaptcha" data-sitekey={ p.SiteKey }></div>
				} else {
					<input type="hidden" name="g-recaptcha-response" value="dev"/>
				}
				<div class="flex flex-wrap justify-end gap-3 border-t border-wga-ink/15 pt-5"><button class="bg-wga-accent-bg px-4 py-3 font-mono text-[10px] tracking-[1px] text-wga-inv-fg" type="submit">Send postcard</button><button type="button" class="border border-wga-ink/30 px-4 py-3 font-mono text-[10px] tracking-[1px]" hx-on:click="wga.dialog.close();">Cancel</button></div>
			</form>
		</div>
	}
}
