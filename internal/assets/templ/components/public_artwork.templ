package components

import "github.com/blackfyre/wga/internal/assets/templ/dto"

templ PublicArtworkCard(i dto.Image) {
	<article class="group border-t border-base-content/15 pt-3">
		<a href={ templ.SafeURL(i.Url) } hx-get={ i.Url } hx-target={ i.HxTarget } class="block">
			<figure class="aspect-[4/3] overflow-hidden bg-base-300">
				<img src={ i.Image } alt={ i.Title + " by " + i.Artist.Name } loading="lazy" class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"/>
			</figure>
			<h2 class="mt-3 text-lg font-semibold leading-tight">{ i.Title }</h2>
			if i.Artist.Name != "" {
				<p class="mt-1 font-mono text-[10px] tracking-[1px] text-primary">{ i.Artist.Name }</p>
			}
		</a>
		<div class="mt-3 flex flex-wrap gap-x-4 gap-y-2 font-mono text-[10px] tracking-[1px]">
			<a href={ templ.SafeURL(i.Url) } hx-get={ i.Url } hx-target={ i.HxTarget } class="text-primary hover:opacity-60">VIEW WORK →</a>
			<a href="#" hx-on:click="wga.dialog.open();" hx-get={ `/postcard/send?awid=` + i.Id } hx-target="#d" hx-swap="innerHTML" hx-select=".modal-box, form[method=dialog].modal-backdrop" class="text-base-content/70 hover:text-base-content">POSTCARD →</a>
		</div>
	</article>
}

templ PublicArtworkGrid(images dto.ImageGrid) {
	<div class="grid grid-cols-1 gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4" data-viewer>
		for _, image := range images {
			@PublicArtworkCard(image)
		}
	</div>
}
