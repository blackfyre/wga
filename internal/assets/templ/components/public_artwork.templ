package components

import "github.com/blackfyre/wga/internal/assets/templ/dto"

// PublicArtworkCard spans three rows of its grid (record text, VIEW WORK, and
// the itinerary action) and adopts them as a subgrid, so every plate in one grid
// row shares the same three row heights and aligns its actions whatever its
// text length or itinerary state. Outside a grid the subgrid falls back to an
// ordinary stack.
templ PublicArtworkCard(i dto.Image) {
	<article class="group row-span-3 grid grid-rows-subgrid gap-y-0 border-t border-wga-ink/15 pt-3">
		<a href={ templ.SafeURL(i.Url) } class="wga-record-card">
			<figure class="aspect-[4/3] overflow-hidden bg-wga-fill">
				<img src={ i.Image } alt={ i.Title + " by " + i.Artist.Name } loading="lazy" class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"/>
			</figure>
			<h2 class="mt-3 text-(length:--t-18) font-semibold leading-tight">{ i.Title }</h2>
			if i.Artist.Name != "" {
				<p class="mt-1 font-mono text-(length:--t-10) tracking-[1px] text-wga-accent">{ i.Artist.Name }</p>
			}
			if i.Location != "" {
				<p class="mt-1 font-mono text-(length:--t-10) leading-relaxed tracking-[0.5px] text-wga-ink/60" data-plate-location>{ i.Location }</p>
			}
		</a>
		<a href={ templ.SafeURL(i.Url) } class="wga-action-link wga-trailing-action mt-3 font-mono text-(length:--t-10) tracking-[1px]" data-plate-view-work>VIEW WORK →</a>
		if i.Id != "" {
			<div class="mt-3" data-plate-itinerary>@AddToItineraryAction(i.Id, AddToItineraryCard)
</div>
		}
	</article>
}

// PublicArtworkGrid has no row gap because each plate spans three subgrid rows;
// the gap between plate rows is the plate's own bottom padding.
templ PublicArtworkGrid(images dto.ImageGrid) {
	<div class="grid grid-cols-1 gap-x-6 gap-y-0 *:pb-10 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
		for _, image := range images {
			@PublicArtworkCard(image)
		}
	</div>
}

// SelectionPlateGrid is the shared grid for selection plates on the selection
// page and in the artist record's selection previews. Below md both page
// columns span the page, so two fluid columns give equal plates. From md the
// two page columns differ in width, so fixed-width tracks keep plates the same
// size in both places. Each item passes the plate's three subgrid rows through.
templ SelectionPlateGrid(images dto.ImageGrid) {
	<ul class="grid grid-cols-2 gap-x-4 gap-y-0 md:grid-cols-[repeat(auto-fill,11.25rem)] md:gap-x-6" data-selection-plate-grid>
		for _, image := range images {
			<li class="row-span-3 grid grid-rows-subgrid gap-y-0 pb-8">
				@PublicArtworkCard(image)
			</li>
		}
	</ul>
}
