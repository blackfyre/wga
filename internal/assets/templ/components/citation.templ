package components

import (
	"strings"
	"time"
)

type Citation struct {
	Key   string
	Title string
	URL   string
}

templ CitationBlock(c Citation) {
	<section class="mt-14 border-t border-wga-ink/15 pt-5" aria-labelledby={ "cite-" + c.Key }>
		<div class="flex flex-wrap items-baseline justify-between gap-4 border-b border-wga-ink/15 pb-3">
			<h2 id={ "cite-" + c.Key } class="font-mono text-(length:--t-11) tracking-[1.5px]">CITE THIS RECORD — BIBTEX</h2>
			<button type="button" data-copy-bibtex data-copy-target={ "#bibtex-" + c.Key } class="wga-action-link font-mono text-(length:--t-11) tracking-[1px]">COPY BIBTEX</button>
		</div>
		<pre id={ "bibtex-" + c.Key } class="mt-4 border border-wga-ink/15 bg-wga-fill p-4 font-mono text-xs leading-relaxed" style="display:block; width:100%; max-width:100%; box-sizing:border-box; overflow-x:auto; min-width:0"><code style="display:block; max-width:100%">{ bibTeX(c) }</code></pre>
		<p class="mt-3 font-mono text-(length:--t-10) leading-relaxed text-wga-ink/50">ACCESSED { citationDate() }. REPLACE THE AUTHOR FIELD WITH THE COMMENTARY AUTHOR WHERE ONE IS NAMED.</p>
	</section>
}

func citationDate() string {
	return time.Now().Format("2006-01-02")
}

func bibTeX(c Citation) string {
	date := citationDate()
	return strings.Join([]string{
		"@online{" + c.Key + ",",
		"  author       = {Krén, Emil and Marx, Daniel},",
		"  title        = {" + c.Title + "},",
		"  organization = {{Web Gallery of Art}},",
		"  date         = {" + date + "},",
		"  url          = {" + c.URL + "},",
		"  urldate      = {" + date + "},",
		"  langid       = {english}",
		"}",
	}, "\n")
}
