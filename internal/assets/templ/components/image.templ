package components

import "github.com/blackfyre/wga/internal/assets/templ/dto"

templ ImageBase(i dto.Image) {
	<figure class="aspect-square hidden-caption wga-skeleton">
		<picture>
			<source media="(max-width: 768px)" srcset={ i.Thumb }/>
			<source media="(min-width: 769px)" srcset={ i.Thumb }/>
			<source media="(min-width: 1024px)" srcset={ i.Thumb }/>
			<img src={ i.Image } alt={ i.Title + " by " + i.Artist.Name } loading="lazy"/>
		</picture>
		<figcaption>{ i.Title } by { i.Artist.Name } </figcaption>
	</figure>
}

templ ImageCard(i dto.Image, hasLearnMore bool) {
	<div class="wga-card w-full bg-wga-bg  m-4 sm:m-0">
		@ImageBase(i)
		<div class="wga-card-body justify-between pl-0">
			<h2 class="wga-card-title line-clamp-1" title={ i.Title + "by" + i.Artist.Name }>{ i.Title }</h2>
			<h3>{ i.Artist.Name }</h3>
			<div class="prose line-clamp-3">
				@templ.Raw(i.Comment)
			</div>
			<div class="wga-card-actions">
				<a
					href={ `/postcard/send?awid=` + i.Id }
					class="wga-button wga-button-secondary"
				>
					Send
					Postcard
				</a>
				<a class="wga-button wga-button-primary" href={ templ.SafeURL(i.Url) } hx-get={ i.Url }>
					Learn
					More
				</a>
			</div>
		</div>
	</div>
}

templ ImageGridComponent(i dto.ImageGrid, hasLearnMore bool) {
	<div class="grid gird-cols-1 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-4">
		for _, img := range i {
			@ImageCard(img, hasLearnMore)
		}
	</div>
}
