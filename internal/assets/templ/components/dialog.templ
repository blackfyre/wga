package components

templ DialogBody() {
	<div class="modal-box relative max-h-[calc(100vh-2rem)] overflow-y-auto border border-base-content bg-base-100 p-5 md:p-7">
		{ children... }
	</div>
	<form method="dialog" class="modal-backdrop fixed inset-0 -z-10 bg-base-content/30">
		<button type="submit" data-dialog-close aria-label="Close dialog">close</button>
	</form>
}

templ DialogButton(href string, text string) {
	<a
		hx-get={ href }
		hx-on:click="wga.dialog.open()"
		hx-target="#d"
		hx-select=".modal-box, form[method=dialog].modal-backdrop"
		class="inline-flex bg-primary px-4 py-3 font-mono text-[11px] tracking-[1.5px] text-primary-content"
		hx-swap="innerHTML"
	>
		{ text }
	</a>
}
