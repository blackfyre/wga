package components

import (
	"context"
	"github.com/blackfyre/wga/internal/assets/templ/utils"
)

templ TopNav() {
	<header class="border-b border-base-content/15">
		<div class="container mx-auto px-4 py-5 md:px-0 md:pb-[18px] md:pt-[22px]">
			<div class="grid grid-cols-[minmax(0,1fr)_2.75rem] items-start gap-6 min-[720px]:hidden">
				<a class="col-start-1 row-start-1 z-10 flex items-center gap-3.5" href="/" hx-get="/" if homePathActive(ctx) { aria-current="page" }>
					<span class="flex h-[34px] w-[34px] shrink-0 items-center justify-center bg-primary font-mono text-[11px] font-bold tracking-[0.5px] text-primary-content">WGA</span>
					<span>
						<span class="block font-mono text-[11px] tracking-[2.5px]">WEB GALLERY OF ART</span>
						<span class="mt-[3px] block font-mono text-[10px] tracking-[1px] text-base-content/60">EUROPEAN ART, 3RD CENTURY – EARLY 20TH</span>
					</span>
				</a>
				<details class="col-span-full row-start-1" data-kbd-mobile-navigation>
					<summary class="ml-auto flex h-11 w-11 cursor-pointer list-none flex-col items-center justify-center gap-1.5" aria-label="Open primary navigation">
						<span class="h-px w-5 bg-base-content" aria-hidden="true"></span>
						<span class="h-px w-5 bg-base-content" aria-hidden="true"></span>
						<span class="h-px w-5 bg-base-content" aria-hidden="true"></span>
					</summary>
				<nav class="mt-4 border-t border-base-content/15 bg-base-100 pt-4" aria-label="Primary navigation" data-mobile-navigation>
					<form action="/search" class="mb-4 flex gap-2"><label class="min-w-0 flex-1"><span class="sr-only">Search collection</span><input class="w-full border-0 border-b border-base-content bg-transparent px-0 py-2 text-sm outline-none" name="q" placeholder="Search artist, title, school" type="search" data-kbd-search/></label><button class="font-mono text-[10px] tracking-[1px] text-primary" type="submit">SEARCH</button></form>
					@mobileNavLinks()
				</nav>
			</details>
			</div>
			<div class="hidden items-center justify-between gap-6 min-[720px]:flex">
			<a class="flex items-center gap-3.5" href="/" hx-get="/" if homePathActive(ctx) { aria-current="page" }>
				<span class="flex h-[34px] w-[34px] shrink-0 items-center justify-center bg-primary font-mono text-[11px] font-bold tracking-[0.5px] text-primary-content">WGA</span>
				<span>
					<span class="block font-mono text-[11px] tracking-[2.5px]">WEB GALLERY OF ART</span>
					<span class="mt-[3px] block font-mono text-[10px] tracking-[1px] text-base-content/60">EUROPEAN ART, 3RD CENTURY – EARLY 20TH</span>
				</span>
			</a>
			<div class="hidden items-end gap-6 min-[720px]:flex">
				<form class="flex w-[190px] items-end gap-4 min-[1080px]:w-[340px]" action="/search">
					<label>
						<span class="sr-only">Search collection</span>
						<input class="w-full border-0 border-b border-base-content bg-transparent px-0 py-2 text-sm leading-4 outline-none" name="q" placeholder="Search artist, title, school" type="search" data-kbd-search/>
					</label>
					<button class="font-mono text-[11px] tracking-[1px] text-primary" type="submit">SEARCH</button>
					<button type="button" data-keyboard-open aria-label="Open Go to" class="border border-base-content/55 px-[7px] py-[5px] font-mono text-[10px] tracking-[1px] text-(color:--wga-muted)"><span data-kbd-modifier aria-hidden="true">CTRL K</span></button>
				</form>
			</div>
			</div>
		</div>
		<nav class="container mx-auto hidden items-start gap-6 px-4 pt-3 min-[720px]:flex min-[720px]:px-0 min-[720px]:pt-0" aria-label="Primary navigation">
			@navLinks("flex flex-wrap gap-x-[26px] gap-y-[2px] [&_a]:py-0 [&_a]:pb-3")
			@MoreNavigation("group relative shrink-0", "absolute right-0 z-[60] mt-1.5 min-w-[196px] border border-base-content bg-base-100 py-[5px]")
		</nav>
	</header>
}

templ navLinks(classes string) {
	<ul class={ classes }>
		<li><a class={ "block border-b-2 border-transparent py-1 font-mono text-xs tracking-[1.5px] hover:border-primary", templ.KV("border-primary text-primary", primaryPathActive(ctx, "/artists")) } href="/artists" hx-get="/artists" if primaryPathActive(ctx, "/artists") { aria-current="page" }>ARTISTS</a></li>
		<li><a class={ "block border-b-2 border-transparent py-1 font-mono text-xs tracking-[1.5px] hover:border-primary", templ.KV("border-primary text-primary", primaryPathActive(ctx, "/artworks")) } href="/artworks" hx-get="/artworks" if primaryPathActive(ctx, "/artworks") { aria-current="page" }>ARTWORKS</a></li>
		<li><a class={ "block border-b-2 border-transparent py-1 font-mono text-xs tracking-[1.5px] hover:border-primary", templ.KV("border-primary text-primary", primaryPathActive(ctx, "/timeline")) } href="/timeline" if primaryPathActive(ctx, "/timeline") { aria-current="page" }>TIMELINE</a></li>
		<li><a class={ "block border-b-2 border-transparent py-1 font-mono text-xs tracking-[1.5px] hover:border-primary", templ.KV("border-primary text-primary", primaryPathActive(ctx, "/dual-mode")) } href="/dual-mode" hx-get="/dual-mode" if primaryPathActive(ctx, "/dual-mode") { aria-current="page" }>DUAL MODE</a></li>
		<li><a class={ "block border-b-2 border-transparent py-1 font-mono text-xs tracking-[1.5px] hover:border-primary", templ.KV("border-primary text-primary", primaryPathActive(ctx, "/tours")) } href="/tours" if primaryPathActive(ctx, "/tours") { aria-current="page" }>GUIDED TOURS</a></li>
		<li><a class={ "block border-b-2 border-transparent py-1 font-mono text-xs tracking-[1.5px] hover:border-primary", templ.KV("border-primary text-primary", primaryPathActive(ctx, "/itineraries")) } href="/itineraries" if primaryPathActive(ctx, "/itineraries") { aria-current="page" }>ITINERARIES</a></li>
		<li><a class={ "block border-b-2 border-transparent py-1 font-mono text-xs tracking-[1.5px] hover:border-primary", templ.KV("border-primary text-primary", primaryPathActive(ctx, "/inspire")) } href="/inspire" hx-get="/inspire" if primaryPathActive(ctx, "/inspire") { aria-current="page" }>INSPIRATION</a></li>
	</ul>
}

templ MoreNavigation(classes string, menuClasses string) {
	<details class={ classes } aria-label="More destinations">
		<summary class={ "cursor-pointer border-b-2 border-transparent pb-3 font-mono text-xs tracking-[1.5px] hover:border-primary group-open:border-primary group-open:text-primary", templ.KV("border-primary text-primary", morePathActive(ctx)) }>MORE</summary>
		<div class={ menuClasses }>
			<ul>
				<li><a class={ "block px-4 py-[9px] text-[13px] hover:text-primary", templ.KV("bg-primary/10 text-primary", morePathActive(ctx, "/statistics")) } href="/statistics" hx-get="/statistics" if morePathActive(ctx, "/statistics") { aria-current="page" }>STATISTICS</a></li>
				<li><a class={ "block px-4 py-[9px] text-[13px] hover:text-primary", templ.KV("bg-primary/10 text-primary", morePathActive(ctx, "/glossary")) } href="/glossary" if morePathActive(ctx, "/glossary") { aria-current="page" }>GLOSSARY</a></li>
				<li><a class={ "block px-4 py-[9px] text-[13px] hover:text-primary", templ.KV("bg-primary/10 text-primary", morePathActive(ctx, "/guestbook")) } href="/guestbook" hx-get="/guestbook" hx-trigger="guestbook-updated from:body" if morePathActive(ctx, "/guestbook") { aria-current="page" }>GUESTBOOK</a></li>
				<li><a class={ "block px-4 py-[9px] text-[13px] hover:text-primary", templ.KV("bg-primary/10 text-primary", morePathActive(ctx, "/postcard")) } href="/postcard" hx-get="/postcard" if morePathActive(ctx, "/postcard") { aria-current="page" }>POSTCARDS</a></li>
				<li><a class={ "block px-4 py-[9px] text-[13px] hover:text-primary", templ.KV("bg-primary/10 text-primary", morePathActive(ctx, "/pages/about")) } href="/pages/about" hx-get="/pages/about" if morePathActive(ctx, "/pages/about") { aria-current="page" }>ABOUT</a></li>
			</ul>
		</div>
	</details>
}

templ mobileNavLinks() {
	<ul class="flex flex-col">
		@mobileNavLink("/artists", "ARTISTS", "/artists")
		@mobileNavLink("/artworks", "ARTWORKS", "/artworks")
		@mobileNavLink("/dual-mode", "DUAL MODE", "/dual-mode")
		@mobileNavLink("/timeline", "TIMELINE", "")
		@mobileNavLink("/inspire", "INSPIRATION", "/inspire")
		@mobileNavLink("/tours", "GUIDED TOURS", "")
		@mobileNavLink("/itineraries", "ITINERARIES", "")
		@mobileNavLink("/itineraries/new", "BUILD AN ITINERARY", "")
		@mobileNavLink("/statistics", "STATISTICS", "/statistics")
		@mobileNavLink("/glossary", "GLOSSARY", "")
		@mobileNavLink("/guestbook", "GUESTBOOK", "/guestbook")
		@mobileNavLink("/postcard", "POSTCARDS", "/postcard")
		@mobileNavLink("/pages/about", "ABOUT", "/pages/about")
		@mobileNavLink("/contributors", "CONTRIBUTORS", "/contributors")
		@mobileNavLink("/pages/privacy-policy", "PRIVACY POLICY", "/pages/privacy-policy")
	</ul>
}

templ mobileNavLink(href, label, hxGet string) {
	<li>
		<a class={ "flex w-full items-center justify-between gap-3 border-t border-base-content/15 py-[15px] font-mono text-xs tracking-[1.5px] text-base-content transition-colors hover:text-primary", templ.KV("bg-primary pl-3 text-primary-content", mobilePathActive(ctx, href)) } href={ templ.URL(href) } if hxGet != "" { hx-get={ templ.URL(hxGet) } } if mobilePathActive(ctx, href) { aria-current="page" }>
			<span class="min-w-0 wrap-anywhere">{ label }</span>
			<span class="shrink-0 font-mono text-xs text-base-content/50" aria-hidden="true">→</span>
		</a>
	</li>
}

var primaryDestinations = []string{
	"/artists", "/artworks", "/timeline", "/dual-mode", "/tours", "/itineraries", "/inspire",
}

var moreDestinations = []string{
	"/statistics", "/glossary", "/guestbook", "/postcard", "/pages/about",
}

var mobileDestinations = []string{
	"/artists", "/artworks", "/dual-mode", "/timeline", "/inspire", "/tours", "/itineraries", "/itineraries/new", "/statistics", "/glossary", "/guestbook", "/postcard", "/pages/about", "/contributors", "/pages/privacy-policy",
}

func homePathActive(ctx context.Context) bool {
	return utils.IsPathActive(ctx, "/", []string{"/"})
}

func primaryPathActive(ctx context.Context, href string) bool {
	return utils.IsPathActive(ctx, href, primaryDestinations)
}

func morePathActive(ctx context.Context, href ...string) bool {
	if len(href) == 0 {
		for _, destination := range moreDestinations {
			if utils.IsPathActive(ctx, destination, moreDestinations) {
				return true
			}
		}
		return false
	}
	return utils.IsPathActive(ctx, href[0], moreDestinations)
}

func mobilePathActive(ctx context.Context, href string) bool {
	return utils.IsPathActive(ctx, href, mobileDestinations)
}
