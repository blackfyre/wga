package components

templ TopNav() {
	<header class="site-header">
		<nav class="site-header__inner" aria-label="Main navigation">
			<div class="site-header__identity">
				<details class="site-header__mobile-menu lg:hidden">
					<summary aria-label="Open navigation menu">
						<svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M4 6h16M4 12h16M4 18h16"></path></svg>
						<span>Menu</span>
					</summary>
					<ul>
						<li><a href="/" hx-get="/">Home</a></li>
						<li><a href="/artists" hx-get="/artists">Artists</a></li>
						<li><a href="/artworks" hx-get="/artworks">Artworks</a></li>
						<li><a href="/dual-mode" target="_blank" rel="noreferrer">Dual Mode</a></li>
						<li><a href="/guestbook" hx-get="/guestbook" hx-trigger="guestbook-updated from:body">Guestbook</a></li>
						<li><a href="/inspire" hx-get="/inspire">Inspiration</a></li>
						<li><a href="/statistics" hx-get="/statistics">Statistics</a></li>
						<li><a href="/pages/privacy-policy" hx-get="/pages/privacy-policy">Privacy Policy</a></li>
					</ul>
				</details>
				<a class="site-header__brand" href="/" hx-get="/">
					<span>WGA</span>
					<small>Web Gallery of Art</small>
				</a>
			</div>
			<ul class="site-header__links hidden lg:flex">
				<li><a href="/" hx-get="/">Home</a></li>
				<li><a href="/artists" hx-get="/artists">Artists</a></li>
				<li><a href="/artworks" hx-get="/artworks">Artworks</a></li>
				<li><a href="/dual-mode" target="_blank" rel="noreferrer">Dual Mode</a></li>
				<li><a href="/guestbook" hx-get="/guestbook" hx-trigger="guestbook-updated from:body">Guestbook</a></li>
				<li class="site-header__more">
					<details>
						<summary>More</summary>
						<ul>
							<li><a href="/inspire" hx-get="/inspire">Inspiration</a></li>
							<li><a href="/statistics" hx-get="/statistics">Statistics</a></li>
							<li><a href="/pages/privacy-policy" hx-get="/pages/privacy-policy">Privacy Policy</a></li>
						</ul>
					</details>
				</li>
			</ul>
			<label class="site-header__theme">
				<span>Dark mode</span>
				<input type="checkbox" class="toggle toggle-sm" aria-label="Dark mode" data-theme-toggle/>
			</label>
		</nav>
	</header>
}
