package layouts

import (
	"encoding/json"
	"github.com/blackfyre/wga/internal/assets/templ/components"
	"github.com/blackfyre/wga/internal/assets/templ/dto"
	"github.com/blackfyre/wga/internal/assets/templ/utils"
	"github.com/blackfyre/wga/internal/observability"
)

func htmxDefaults() string {
	settings := map[string]interface{}{
		"globalViewTransitions": true,
		"selfRequestsOnly":      true,
		"allowScriptTags":       false,
	}

	bytes, _ := json.Marshal(settings)
	return string(bytes)
}

func getHtmxDefaultArea(target string) string {
	if target == "" {
		return "#mc-area"
	}
	return target
}

templ LayoutBase(bodyClasses string, HtmxTargetArea string) {
	<!DOCTYPE html>
	<html>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ utils.GetTitle(ctx) } </title>
			<meta name="description" content={ utils.GetDescription(ctx) }/>
			<meta name="sentry-dsn" content={ observability.BrowserConfig().DSN }/>
			<meta name="sentry-environment" content={ observability.BrowserConfig().Environment }/>
			<meta name="sentry-release" content={ observability.BrowserConfig().Release }/>
			<meta name="htmx-config" content={ htmxDefaults() }/>
			for key, content := range utils.GetOpenGraphTags(ctx) {
				<meta name={ key } content={ content }/>
			}
			for key, content := range utils.GetTwitterTags(ctx) {
				<meta name={ key } content={ content }/>
			}
			if utils.GetCanonicalUrl(ctx) != "" {
				<link rel="canonical" href={ utils.GetCanonicalUrl(ctx) }/>
			}
			if utils.GetAlternateMarkdownURL(ctx) != "" {
				<link rel="alternate" type="text/markdown" href={ utils.GetAlternateMarkdownURL(ctx) }/>
			}
			@templ.Raw(dto.ThemeResolverScript())
			<link rel="stylesheet" href="/assets/css/style.css"/>
			<link rel="apple-touch-icon" sizes="180x180" href="/assets/images/apple-touch-icon.png"/>
			<link rel="icon" type="image/png" sizes="32x32" href="/assets/images/favicon-32x32.png"/>
			<link rel="icon" type="image/png" sizes="16x16" href="/assets/images/favicon-16x16.png"/>
			<link rel="manifest" href="/assets/site.webmanifest"/>
			<link rel="mask-icon" href="/assets/images/safari-pinned-tab.svg" color="#013365"/>
			<link rel="shortcut icon" href="/assets/images/favicon.ico"/>
			<meta name="msapplication-TileColor" content="#013365"/>
			<meta name="msapplication-config" content="/assets/browserconfig.xml"/>
			<meta name="theme-color" content="#013365"/>
			if trustedHeadMarkup := utils.GetTrustedHeadMarkup(ctx); trustedHeadMarkup != "" {
				@templ.Raw(trustedHeadMarkup)
			}
		</head>
		<body class={ bodyClasses } hx-indicator=".progress-indicator" hx-target={ getHtmxDefaultArea(HtmxTargetArea) } hx-select={ getHtmxDefaultArea(HtmxTargetArea) } hx-swap="outerHTML">
			<div class="progress-indicator h-[3px] bg-wga-accent-bg">
				<div class="indeterminate"></div>
			</div>
			{ children... }
			<dialog id="d" aria-label="Dialog" aria-modal="true" class="wga-dialog m-auto border border-wga-ink p-0 text-wga-ink backdrop:bg-wga-ink/30"></dialog>
			@components.KeyboardLayer()
			<a
				href="https://github.com/blackfyre/wga/issues?q=sort%3Aupdated-desc+is%3Aissue+state%3Aopen+"
				class="wga-feedback-anchor fixed right-4 bottom-4 z-50 bg-wga-inv-bg px-4.5 py-[13px] font-mono text-[11px] tracking-[1.5px] text-wga-inv-fg transition-colors hover:bg-wga-accent-bg md:right-8 md:bottom-8"
			>FEEDBACK</a>
			<div class={ toastContainerClass(utils.GetItineraryTray(ctx)) } id="toast-container"></div>
			<script type="module" src="/assets/js/app.js"></script>
		</body>
	</html>
}

templ LayoutMain() {
	@LayoutBase("min-h-screen", "") {
		if utils.GetEnvironment(ctx) != "production" {
			<section class="border-b border-wga-ink/15">
				<div class="container mx-auto flex items-center gap-3 px-4 py-2.5 md:px-0">
					<span class="bg-wga-accent-bg px-2 py-1 font-mono text-[9px] tracking-[1.5px] text-wga-inv-fg">STAGING</span>
					<p class="font-mono text-[10px] tracking-[1px] text-wga-ink/60">DEVELOPMENT BUILD — NOT FOR PUBLIC USE. CONTRIBUTE ON GITHUB.</p>
				</div>
			</section>
		}
		@components.TopNav()
		<main id="mc-area" class={ itineraryMainClass(utils.GetItineraryTray(ctx)) }>
			{ children... }
		</main>
		@components.ItineraryTray(utils.GetItineraryTray(ctx), false)
		@components.Footer()
	}
}

// itineraryMainClass reserves a bottom offset only while the itinerary tray is
// non-empty, so the fixed tray never covers page content when it is hidden.
func itineraryMainClass(tray dto.ItineraryTrayView) string {
	if tray.Count > 0 {
		return "wga-enter pb-28 md:pb-20"
	}

	return "wga-enter"
}

// toastContainerClass lifts the fixed toast container clear of the itinerary
// tray only while the tray is non-empty, mirroring itineraryMainClass so a
// notification cannot render behind the bar.
func toastContainerClass(tray dto.ItineraryTrayView) string {
	if tray.Count > 0 {
		return "wga-toast-stack bottom-28 md:bottom-20"
	}

	return "wga-toast-stack"
}

templ LayoutSlim() {
	@LayoutBase("min-h-screen", "") {
		<main id="mc-area" class="wga-enter">
			{ children... }
		</main>
	}
}
