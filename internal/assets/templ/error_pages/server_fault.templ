package error_pages

import "github.com/blackfyre/wga/internal/assets/templ/layouts"

templ ServerFaultPage() {
	@layouts.LayoutMain() {
		<head><title>500 — Service unavailable</title></head>
		@ServerFaultBlock()
	}
}

templ ServerFaultBlock() {
	<section class="container mx-auto px-4 py-20 md:px-0 md:py-32">
		<p class="font-mono text-[11px] tracking-[2px] text-base-content/60">500 — SERVICE ERROR</p>
		<h1 class="mt-4 max-w-xl text-[38px] font-semibold leading-tight tracking-[-0.5px] md:text-[56px]">The archive could not complete that request.</h1>
		<p class="mt-5 max-w-lg leading-relaxed text-base-content/70">Please try again shortly. If the problem continues, send us a feedback report.</p>
		<a href="/" hx-get="/" class="mt-8 inline-block bg-primary px-5 py-3 font-mono text-[11px] tracking-[1.5px] text-primary-content">RETURN TO THE GALLERY →</a>
	</section>
}
