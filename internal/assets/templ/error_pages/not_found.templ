package error_pages

import "github.com/blackfyre/wga/internal/assets/templ/layouts"

templ NotFoundPage() {
	@layouts.LayoutMain() {
		<head><title>404 — Page not found</title></head>
		@NotFoundBlock()
	}
}

templ NotFoundBlock() {
	<section class="container mx-auto px-4 py-20 md:px-0 md:py-32">
		<p class="font-mono text-[11px] tracking-[2px] text-base-content/60">404 — NOT FOUND</p>
		<h1 class="mt-4 max-w-xl text-[38px] font-semibold leading-tight tracking-[-0.5px] md:text-[56px]">This record is not in the collection.</h1>
		<p class="mt-5 max-w-lg leading-relaxed text-base-content/70">The address may have changed, or the page may no longer be available.</p>
		<a href="/" hx-get="/" class="mt-8 inline-block bg-primary px-5 py-3 font-mono text-[11px] tracking-[1.5px] text-primary-content">RETURN TO THE GALLERY →</a>
	</section>
}
