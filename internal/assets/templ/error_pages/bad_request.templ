package error_pages

import (
	"github.com/blackfyre/wga/internal/assets/templ/components"
	"github.com/blackfyre/wga/internal/assets/templ/layouts"
)

templ BadRequestPage() {
	@layouts.LayoutMain() {
		<head><title>400 — Request not supported</title></head>
		@BadRequestBlock()
	}
}

templ BadRequestBlock() {
	<section class="container mx-auto px-4 py-20 md:px-0 md:py-32">
		@components.PageHead("400 — BAD REQUEST", "That request is not supported.", "Please return to the collection and try the action again.")
		<div class="flex flex-wrap gap-2.5">
			<a href="/" class="btn btn-primary font-mono text-(length:--t-11) tracking-[1.5px]">RETURN TO THE GALLERY →</a>
			<a href="/artworks" class="btn btn-outline font-mono text-(length:--t-11) tracking-[1.5px]">BROWSE ALL ARTWORKS →</a>
		</div>
	</section>
}
