package error_pages

import "github.com/blackfyre/wga/internal/assets/templ/layouts"

templ BadRequestPage() {
	@layouts.LayoutMain() {
		<head><title>400 — Request not supported</title></head>
		@BadRequestBlock()
	}
}

templ BadRequestBlock() {
	<section class="container mx-auto px-4 py-20 md:px-0 md:py-32">
		<p class="font-mono text-[11px] tracking-[2px] text-base-content/60">400 — BAD REQUEST</p>
		<h1 class="mt-4 max-w-xl text-[38px] font-semibold leading-tight tracking-[-0.5px] md:text-[56px]">That request is not supported.</h1>
		<p class="mt-5 max-w-lg leading-relaxed text-base-content/70">Please return to the collection and try the action again.</p>
		<a href="/" hx-get="/" class="mt-8 inline-block bg-primary px-5 py-3 font-mono text-[11px] tracking-[1.5px] text-primary-content">RETURN TO THE GALLERY →</a>
	</section>
}
