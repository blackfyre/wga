package pages

import (
	"github.com/blackfyre/wga/internal/assets/templ/dto"
	"github.com/blackfyre/wga/internal/assets/templ/layouts"
	"github.com/blackfyre/wga/internal/assets/templ/utils"
	"regexp"
)

templ ArtistsPageFull(c dto.ArtistsView) {
	@layouts.LayoutMain() {
		@ArtistsPageBlock(c)
	}
}

func HighlightArtistName(name string, query string) string {
	if query == "" {
		return name
	}
	re := regexp.MustCompile(`(?mis)` + regexp.QuoteMeta(query))
	return re.ReplaceAllStringFunc(name, func(s string) string {
		return "<mark>" + s + "</mark>"
	})
}

templ ArtistsPageBlock(c dto.ArtistsView) {
	<head>
		<title>{ utils.GetTitle(ctx) }</title>
	</head>
	<section class="artist-index">
		<header class="artist-index__header">
			<div>
				<p class="artist-index__eyebrow">Collection directory</p>
				<h1>Artist index</h1>
				<p class="artist-index__summary">Browse { c.Count } artists in the Web Gallery of Art collection.</p>
			</div>
			<label class="artist-index__search">
				<span class="sr-only">Search artists</span>
				<input
					type="search"
					name="q"
					placeholder="Find an artist"
					hx-get="/artists"
					hx-trigger="keyup changed delay:500ms, search"
					hx-disabled-elt="this"
					value={ c.QueryStr }
					aria-label="Search artists"
					hx-target={ c.HxTarget }
				/>
			</label>
		</header>
		<nav class="artist-index__alphabet" aria-label="Filter artists by first letter">
			if c.ActiveLetter == "" {
				<a href="/artists" hx-get="/artists" hx-target={ c.HxTarget } aria-current="page">All</a>
			} else {
				<a href="/artists" hx-get="/artists" hx-target={ c.HxTarget }>All</a>
			}
			for _, letter := range "ABCDEFGHIJKLMNOPQRSTUVWXYZ" {
				if c.ActiveLetter == string(letter) {
					<a href={ templ.SafeURL("/artists?letter=" + string(letter)) } hx-get={ "/artists?letter=" + string(letter) } hx-target={ c.HxTarget } aria-current="page">{ string(letter) }</a>
				} else {
					<a href={ templ.SafeURL("/artists?letter=" + string(letter)) } hx-get={ "/artists?letter=" + string(letter) } hx-target={ c.HxTarget }>{ string(letter) }</a>
				}
			}
		</nav>
		@ArtistsSearchResults(c)
	</section>
}

templ artistsTable(list []dto.Artist, query string) {
	<div class="artist-index__table-wrap">
		<table class="artist-index__table">
			<thead>
				<tr>
					<th>Artist</th>
					<th>Life span</th>
					<th>School</th>
				</tr>
			</thead>
			<tbody>
				for _, a := range list {
					<tr>
						<td>
							<a href={ templ.SafeURL(a.Url) } hx-get={ a.Url } hx-target={ a.HxTarget }>
								@templ.Raw(HighlightArtistName(a.Name, query))
							</a>
						</td>
						<td>{ a.BornDied }</td>
						<td>{ a.Schools }</td>
					</tr>
				}
				if len(list) == 0 {
					<tr>
						<td colspan="3" class="artist-index__empty">No artists match this search.</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}

templ ArtistsSearchResults(c dto.ArtistsView) {
	<div id="search-results">
		@artistsTable(c.Artists, c.QueryStr)
		<nav class="artist-index__pagination" role="navigation" aria-label="Artist index pagination">
			@templ.Raw(c.Pagination)
		</nav>
		@templ.Raw(c.Jsonld)
	</div>
}
