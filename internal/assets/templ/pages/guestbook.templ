package pages

import (
	"github.com/blackfyre/wga/internal/assets/templ/dto"
	"github.com/blackfyre/wga/internal/assets/templ/layouts"
)

type GuestbookView struct {
	SelectedYear string
	CurrentYear  string
	YearOptions  []string
	Entries      dto.GuestbookEntries
}

templ GuestbookPage(v GuestbookView) {
	@layouts.LayoutMain() {
		@GuestbookBlock(v)
	}
}

templ GuestbookBlock(v GuestbookView) {
	<section class="container mx-auto px-4 pb-20 pt-10 md:px-0 wga-enter">
		<p class="mb-3 font-mono text-[11px] tracking-[2px] text-base-content/60">10 — GUESTBOOK</p>
		<h1 class="mb-3 text-[44px] font-semibold leading-tight tracking-[-0.5px]">Guestbook</h1>
		<p class="mb-11 max-w-[540px] text-base leading-relaxed text-base-content/70">Notes from people who have spent time with the collection. Messages are moderated before publication.</p>

		<div class="grid gap-10 md:grid-cols-[340px_1fr] md:gap-14">
			<aside class="border-t border-base-content/15 pt-5">
				@GuestbookEntryForm()
			</aside>

			<div>
				if len(v.YearOptions) > 1 {
					<div class="mb-6">
						<p class="mb-3 font-mono text-[10px] tracking-[1.5px] text-base-content/60">JUMP TO YEAR</p>
						<nav class="flex flex-wrap gap-1.5" aria-label="Filter guestbook entries by year">
							for _, year := range v.YearOptions {
								<a
									href={ templ.URL("/guestbook?year=" + year) }
									hx-get={ "/guestbook?year=" + year }
									class={ "border px-3 py-1.5 font-mono text-[11px] tracking-[1px] transition-colors", templ.KV("border-primary bg-primary text-primary-content", v.SelectedYear == year), templ.KV("border-base-content/25 text-base-content/70 hover:border-base-content", v.SelectedYear != year) }
									aria-current={ guestbookAriaCurrent(v.SelectedYear == year) }
								>{ year }</a>
							}
						</nav>
					</div>
				}
				<div class="flex items-baseline justify-between gap-4 border-b border-base-content pb-3 font-mono text-[11px] tracking-[1.5px]">
					<p>ENTRIES FROM { v.SelectedYear }</p>
					<p class="text-primary">LATEST FIRST</p>
				</div>
				if len(v.Entries) > 0 {
					@GuestbookEntries(v.Entries)
				} else {
					<div class="py-12">
						<p class="mb-2 text-lg font-semibold">No entries found.</p>
						if v.SelectedYear == v.CurrentYear {
							<p class="text-[15px] leading-relaxed text-base-content/70">Be the first to sign the guestbook for { v.SelectedYear }.</p>
						}
					</div>
				}
			</div>
		</div>
	</section>
}

templ GuestbookEntryForm() {
	<form id="guestbook-entry-form" hx-post="/guestbook/add" hx-target="#guestbook-entry-form" hx-swap="outerHTML" hx-disabled-elt="input,button,textarea">
		<p class="mb-5 font-mono text-[11px] tracking-[1.5px] text-base-content/60">LEAVE A NOTE</p>
		<div class="mb-6 flex flex-col gap-5">
			<label class="block"><span class="mb-2 block font-mono text-[10px] tracking-[1.5px] text-base-content/60">NAME</span><input type="text" class="w-full border-0 border-b border-base-content bg-transparent px-0 py-2 text-[15px] outline-none focus:ring-0" placeholder="Your name" name="sender_name" autocomplete="name" id="sender_name" required/></label>
			<label class="block"><span class="mb-2 block font-mono text-[10px] tracking-[1.5px] text-base-content/60">EMAIL</span><input type="email" class="w-full border-0 border-b border-base-content bg-transparent px-0 py-2 text-[15px] outline-none focus:ring-0" placeholder="Your email" name="sender_email" autocomplete="email" id="sender_email" required/></label>
			<label class="block"><span class="mb-2 block font-mono text-[10px] tracking-[1.5px] text-base-content/60">LOCATION</span><input type="text" class="w-full border-0 border-b border-base-content bg-transparent px-0 py-2 text-[15px] outline-none focus:ring-0" placeholder="Your location" name="location" autocomplete="location" required/></label>
			<label class="block"><span class="mb-2 block font-mono text-[10px] tracking-[1.5px] text-base-content/60">NOTE</span><textarea class="min-h-28 w-full border border-base-content/30 bg-transparent p-3 text-[15px] leading-relaxed" id="message" name="message" placeholder="What did you come here to find?" required></textarea></label>
		</div>
		<label aria-hidden="true" class="hpt" for="name"></label>
		<input
			aria-hidden="true"
			class="hpt"
			autocomplete="off"
			type="text"
			id="name"
			name="name"
			placeholder="Enter your name"
		/>
		<label aria-hidden="true" class="hpt" for="email"></label>
		<input
			aria-hidden="true"
			class="hpt"
			autocomplete="off"
			type="email"
			id="email"
			name="email"
			placeholder="Enter your email"
		/>
		<button class="w-full bg-primary px-4 py-3 font-mono text-[11px] tracking-[1.5px] text-primary-content" type="submit">SIGN THE GUESTBOOK →</button>
		<p class="mt-3 font-mono text-[10px] leading-relaxed text-base-content/50">ENTRIES ARE MODERATED BEFORE PUBLICATION. EMAIL ADDRESSES ARE NOT SHOWN.</p>
	</form>
}

templ GuestbookEntries(entries dto.GuestbookEntries) {
	<div class="flow-root">
		<div class="divide-y divide-base-content/15 gb-entries">
			for _, entry := range entries {
				@GuestbookEntry(entry)
			}
		</div>
	</div>
}

templ GuestbookEntry(entry dto.GuestbookEntry) {
	if (entry.Message == "") {
		return
	}
	<div class="gb-entry border-b border-base-content/15 py-[22px]">
		<div class="mb-2 flex items-baseline justify-between gap-4">
			<h4 class="text-[15px] font-semibold">
				if entry.Name != "" {
					{ entry.Name }
				} else {
					Anonymous
				}
			</h4>
			<p class="text-right font-mono text-[11px] text-base-content/60">{ entry.Location } · { entry.Created }</p>
		</div>
		<div class="text-base leading-relaxed text-base-content/80">
			@templ.Raw(entry.Message)
		</div>
	</div>
}

func guestbookAriaCurrent(active bool) string {
	if active {
		return "page"
	}

	return "false"
}
