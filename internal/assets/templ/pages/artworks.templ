package pages

import (
	"fmt"
	"strconv"

	"github.com/blackfyre/wga/internal/assets/templ/components"
	"github.com/blackfyre/wga/internal/assets/templ/dto"
	"github.com/blackfyre/wga/internal/assets/templ/layouts"
)

// ArtworkSortOption is one sort criterion link rendered in the results header.
type ArtworkSortOption struct {
	Key    string
	Label  string
	Href   string
	Active bool
}

// ArtworkSearchDualMode carries the dual-pane search routing context so a
// catalogue search can target one side of Dual Mode. It is page-owned state,
// not a record projection.
type ArtworkSearchDualMode struct {
	LeftPath      string
	RightPath     string
	LeftRenderTo  string
	RightRenderTo string
	Target        string
}

// ArtworkSearchResultsView is the HTMX-swapped result fragment contract.
type ArtworkSearchResultsView struct {
	ActiveFiltering bool
	ResultCount     int
	Artworks        dto.ImageGrid
	View            string
	GridUrl         string
	ListUrl         string
	ResetUrl        string
	SortOptions     []ArtworkSortOption
	SortDirLabel    string
	SortToggleUrl   string
	DualModeUrls    map[string]string
	DualModeTarget  string
	Pagination      string
}

// ArtworkSearchView is the page-owned contract for the artwork catalogue.
type ArtworkSearchView struct {
	NameField       dto.Field
	TechniqueField  dto.Field
	SchoolGroup     dto.ChipGroup
	FormGroup       dto.ChipGroup
	TypeGroup       dto.ChipGroup
	PeriodGroup     dto.ChipGroup
	LocationGroup   dto.ChipGroup
	YearFrom        string
	YearTo          string
	ClearUrl        string
	DualModeContext *ArtworkSearchDualMode
	HxTarget        string
	Results         ArtworkSearchResultsView
}

// ArtworkSearchPage is the template for the artwork catalogue page.
templ ArtworkSearchPage(s ArtworkSearchView) {
	@layouts.LayoutMain() {
		@ArtworkSearchBlock(s)
	}
}

templ ArtworkSeachFilterBlock(b ArtworkSearchView) {
	<form
		id="artwork-filters"
		action="/artworks/results"
		hx-get="/artworks/results"
		hx-disabled-elt="button"
		hx-target={ b.HxTarget }
		hx-select={ b.HxTarget }
		hx-swap="outerHTML"
		hx-indicator="#artwork-search-indicator"
		hx-sync="this:replace"
		method="GET"
		hx-trigger="change, input changed delay:300ms from:find input[type=search], input changed delay:300ms from:find input[type=range]"
		class="w-full"
	>
		if b.DualModeContext != nil {
			<input type="hidden" name="dual_left" value={ b.DualModeContext.LeftPath }/>
			<input type="hidden" name="dual_right" value={ b.DualModeContext.RightPath }/>
			<input type="hidden" name="dual_left_render_to" value={ b.DualModeContext.LeftRenderTo }/>
			<input type="hidden" name="dual_right_render_to" value={ b.DualModeContext.RightRenderTo }/>
			<input type="hidden" name="dual_target" value={ b.DualModeContext.Target }/>
		}
		<div class="flex items-baseline justify-between border-b border-base-content pb-3">
			<p class="font-mono text-[11px] tracking-[1.5px]">FILTERS</p>
			if b.DualModeContext != nil {
				<a class="font-mono text-[10px] tracking-[1px] text-primary transition-opacity hover:opacity-60" href={ b.ClearUrl } hx-get={ b.ClearUrl } hx-target="#mc-area" hx-select="#mc-area" hx-swap="outerHTML">RESET</a>
			} else {
				<a class="font-mono text-[10px] tracking-[1px] text-primary transition-opacity hover:opacity-60" href={ b.ClearUrl }>RESET</a>
			}
		</div>
		<label class="block border-b border-base-content/15 py-5">
			<span class="mb-2.5 block font-mono text-[10px] tracking-[1.5px] text-base-content/60">TITLE OR ARTIST</span>
			<input
				class="w-full border-0 border-b border-base-content bg-transparent px-0 py-2 text-sm outline-none focus:ring-0"
				type="search"
				id="artwork-query"
				data-keyboard-page-search
				name="q"
				placeholder="e.g. milkmaid"
				value={ b.NameField.Value }
			/>
		</label>
		<label class="block border-b border-base-content/15 py-5">
			<span class="mb-2.5 block font-mono text-[10px] tracking-[1.5px] text-base-content/60">TECHNIQUE</span>
			<input
				class="w-full border-0 border-b border-base-content bg-transparent px-0 py-2 text-sm outline-none focus:ring-0"
				type="search"
				id="artwork-technique"
				name="technique"
				placeholder="e.g. oil on canvas"
				value={ b.TechniqueField.Value }
			/>
		</label>
		@components.ChipGroup(b.SchoolGroup)
		@components.ChipGroup(b.FormGroup)
		@components.ChipGroup(b.TypeGroup)
		@components.ChipGroup(b.PeriodGroup)
		@components.ChipGroup(b.LocationGroup)
		<fieldset class="py-5">
			<div class="mb-4 flex items-baseline justify-between">
				<legend class="font-mono text-[10px] tracking-[1.5px] text-base-content/60">YEAR RANGE</legend>
				<output class="font-mono text-xs" for="year_from year_to">{ b.YearFrom }–{ b.YearTo }</output>
			</div>
			<div class="artwork-year-range" data-artwork-year-range>
				<div class="artwork-year-range-track"></div>
				<div class="artwork-year-range-fill bg-primary"></div>
				<input class="artwork-year-range-input" type="range" id="year_from" name="year_from" min="200" max="1900" value={ b.YearFrom } aria-label="Earliest year"/>
				<input class="artwork-year-range-input" type="range" id="year_to" name="year_to" min="200" max="1900" value={ b.YearTo } aria-label="Latest year"/>
			</div>
			<div class="mt-2 flex justify-between font-mono text-[10px] text-base-content/50"><span>200</span><span>1900</span></div>
		</fieldset>
		<noscript><button type="submit" class="w-full bg-primary px-4 py-3 font-mono text-[11px] tracking-[1px] text-primary-content">APPLY FILTERS</button></noscript>
		<div id="artwork-search-indicator" class="htmx-indicator rounded-box border border-base-300 bg-base-200/70 p-3 text-sm text-base-content/80">
			Searching the collection...
		</div>
	</form>
}

templ ArtworkSortControl(r ArtworkSearchResultsView) {
	<div class="flex flex-wrap items-center gap-2">
		<span class="font-mono text-[10px] tracking-[1.5px] text-base-content/60">SORT</span>
		for _, option := range r.SortOptions {
			<a
				href={ templ.SafeURL(option.Href) }
				hx-get={ option.Href }
				hx-target="#artwork-search-results"
				hx-select="#artwork-search-results"
				hx-swap="outerHTML"
				class={ "border px-3.5 py-1.5 font-mono text-[11px] tracking-[1px] transition-colors", templ.KV("border-primary bg-primary text-primary-content", option.Active), templ.KV("border-base-content/25 text-base-content/70 hover:border-base-content", !option.Active) }
				aria-pressed={ fmt.Sprint(option.Active) }
			>{ option.Label }</a>
		}
		<a
			href={ templ.SafeURL(r.SortToggleUrl) }
			hx-get={ r.SortToggleUrl }
			hx-target="#artwork-search-results"
			hx-select="#artwork-search-results"
			hx-swap="outerHTML"
			aria-label="Reverse sort direction"
			class="font-mono text-[10px] tracking-[1px] whitespace-nowrap px-2.5 py-1.5 border border-base-content/25 text-base-content/70 hover:border-base-content hover:text-base-content transition-colors"
		>{ r.SortDirLabel }</a>
	</div>
}

templ ArtworkSearchResults(r ArtworkSearchResultsView) {
	<div id="artwork-search-results">
		<div class="flex flex-wrap items-baseline justify-between gap-3 border-b border-base-content pb-4">
			<p class="font-mono text-xs text-base-content/60" aria-live="polite">
				{ artworkMatchCount(r.ResultCount) }
			</p>
			<div class="flex flex-col items-start gap-3 md:flex-row md:items-center md:gap-5">
				@ArtworkSortControl(r)
				<div class="flex items-center gap-2">
					<a href={ templ.SafeURL(r.GridUrl) } hx-get={ r.GridUrl } hx-target="#artwork-search-results" hx-select="#artwork-search-results" hx-swap="outerHTML" class={ "border px-3.5 py-1.5 font-mono text-[11px] tracking-[1px] transition-colors", templ.KV("border-primary bg-primary text-primary-content", r.View == "grid"), templ.KV("border-base-content/25 text-base-content/70 hover:border-base-content", r.View != "grid") } aria-pressed={ fmt.Sprint(r.View == "grid") }>GRID</a>
					<a href={ templ.SafeURL(r.ListUrl) } hx-get={ r.ListUrl } hx-target="#artwork-search-results" hx-select="#artwork-search-results" hx-swap="outerHTML" class={ "border px-3.5 py-1.5 font-mono text-[11px] tracking-[1px] transition-colors", templ.KV("border-primary bg-primary text-primary-content", r.View == "list"), templ.KV("border-base-content/25 text-base-content/70 hover:border-base-content", r.View != "list") } aria-pressed={ fmt.Sprint(r.View == "list") }>LIST</a>
				</div>
			</div>
		</div>
		if len(r.Artworks) > 0 {
			if r.DualModeTarget != "" {
				@ArtworkSearchDualModeResultGrid(r.Artworks, r.DualModeUrls, r.DualModeTarget)
			} else if r.View == "list" {
				@ArtworkSearchResultList(r.Artworks)
			} else {
				<div class="mt-7 grid grid-cols-2 gap-x-4 gap-y-9 md:grid-cols-3 md:gap-x-7" data-kbd-list data-kbd-cols="2" data-kbd-cols-md="3" data-view="grid">
					for index, artwork := range r.Artworks {
						<a href={ templ.SafeURL(artwork.Url) } hx-get={ artwork.Url } data-kbd-idx={ strconv.Itoa(index) } data-kbd-href={ artwork.Url } class="block transition-opacity hover:opacity-70">
							@components.KeyboardCaret()
							<figure class="mb-2.5 aspect-[4/5] border border-base-content/15 bg-base-300 p-2.5">
								<img src={ artwork.Thumb } alt={ artwork.Title } class="h-full w-full object-cover"/>
							</figure>
							<p class="text-sm font-semibold leading-tight">{ artwork.Title }</p>
							<p class="mt-[3px] font-mono text-[11px] leading-relaxed text-base-content/60">{ artwork.Artist.Name }<br/>{ artwork.Technique }</p>
						</a>
					}
				</div>
			}
		} else if !r.ActiveFiltering {
			@components.EmptyState(dto.EmptyState{
				Title:   "SET FILTERS TO BROWSE THE COLLECTION",
				Message: "Combine title, school, form, type, technique, and period filters, then run a search.",
			})
		} else {
			@components.EmptyState(dto.EmptyState{
				Title:         "NO MATCHING WORKS",
				Message:       "Try clearing one or two filters, or widen the period range.",
				RecoveryLabel: "RESET FILTERS →",
				RecoveryHref:  r.ResetUrl,
			})
		}
		if len(r.Pagination) > 10 {
			<nav class="pagination box" role="navigation" aria-label="pagination">
				@templ.Raw(r.Pagination)
			</nav>
		}
	</div>
}

// artworkMatchCount keeps the readout grammatical.
func artworkMatchCount(total int) string {
	if total == 1 {
		return "1 WORK MATCHES"
	}

	return fmt.Sprintf("%d WORKS MATCH", total)
}

templ ArtworkSearchResultList(artworks dto.ImageGrid) {
	<ul data-kbd-list data-kbd-cols="1" data-view="list">
		for index, artwork := range artworks {
			<li>
				<a href={ templ.SafeURL(artwork.Url) } hx-get={ artwork.Url } data-kbd-idx={ strconv.Itoa(index) } data-kbd-href={ artwork.Url } class="flex items-center gap-4 border-b border-base-content/15 py-3.5 transition-colors hover:bg-primary/5">
					@components.KeyboardCaret()
					<img src={ artwork.Thumb } alt={ artwork.Title } class="h-[54px] w-11 shrink-0 border border-base-content/15 bg-base-300 object-cover"/>
					<span class="min-w-0 flex-1"><span class="block text-[15px] font-semibold leading-tight">{ artwork.Title }</span><span class="mt-[3px] block font-mono text-[11px] text-base-content/60">{ artwork.Artist.Name }</span></span>
					<span class="hidden shrink-0 font-mono text-[11px] text-base-content/70 md:block">{ artwork.Technique }</span>
				</a>
			</li>
		}
	</ul>
}

templ ArtworkSearchDualModeResultGrid(artworks dto.ImageGrid, dualModeUrls map[string]string, target string) {
	<div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-4">
		for _, artwork := range artworks {
			<div class="flex flex-col gap-2">
				@components.ImageCard(artwork, true)
				if dualModeUrls[artwork.Id] != "" {
					<a
						class="btn btn-outline"
						href={ templ.SafeURL(dualModeUrls[artwork.Id]) }
						aria-label={ "Open " + artwork.Title + " in " + target + " pane" }
					>Open in { target } pane</a>
				}
			</div>
		}
	</div>
}

templ ArtworkSearchBlock(s ArtworkSearchView) {
	<section id="artwork-search" class="container mx-auto px-4 pb-20 pt-10 md:px-0 wga-enter">
		<p class="mb-3 font-mono text-[11px] tracking-[2px] text-base-content/60">12 — ARTWORK SEARCH</p>
		<h1 class="mb-3 text-[44px] font-semibold leading-tight tracking-[-0.5px]">Artworks</h1>
		<p class="mb-11 max-w-[540px] text-base leading-relaxed text-base-content/70">Filter by title, school, form and technique — or narrow by period when you are working through a century rather than a name.</p>
		<div class="flex flex-col items-start gap-10 md:flex-row md:gap-14">
			<div class="w-full shrink-0 md:w-[250px]">
				@ArtworkSeachFilterBlock(s)
			</div>
			<div class="w-full min-h-48" id="search-result-container">
				@ArtworkSearchResults(s.Results)
			</div>
		</div>
	</section>
}
