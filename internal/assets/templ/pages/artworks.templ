package pages

import (
	"github.com/blackfyre/wga/internal/assets/templ/components"
	"github.com/blackfyre/wga/internal/assets/templ/dto"
	"github.com/blackfyre/wga/internal/assets/templ/layouts"
)

templ ArtworkSearchPage(s dto.ArtworkSearchDTO) {
	@layouts.LayoutMain() {
		@ArtworkSearchBlock(s)
	}
}

templ ArtworkSeachFilterBlock(b dto.ArtworkSearchDTO) {
	<form
		action="/artworks/results"
		hx-get="/artworks/results"
		hx-disabled-elt="button"
		hx-target={ b.HxTarget }
		hx-select="#artwork-search-results > *"
		hx-swap="innerHTML"
		hx-indicator="#artwork-search-indicator"
		method="GET"
		class="explore-filters"
	>
		if b.DualModeContext != nil {
			<input type="hidden" name="dual_left" value={ b.DualModeContext.LeftPath }/>
			<input type="hidden" name="dual_right" value={ b.DualModeContext.RightPath }/>
			<input type="hidden" name="dual_left_render_to" value={ b.DualModeContext.LeftRenderTo }/>
			<input type="hidden" name="dual_right_render_to" value={ b.DualModeContext.RightRenderTo }/>
			<input type="hidden" name="dual_target" value={ b.DualModeContext.Target }/>
		}
		<div class="explore-filters__heading">
			<p>Faceted search</p>
			<h2>Refine collection</h2>
		</div>
		<label class="explore-filters__field">
			<span>Artist</span>
			<input
				type="search"
				list="artist_list"
				id="artist_name"
				autocomplete="artist_name"
				name="artist"
				value={ b.ActiveFilterValues.ArtistString }
			/>
			<datalist id="artist_list">
				for _, v := range b.ArtistNameList {
					<option value={ v }></option>
				}
			</datalist>
		</label>
		<label class="explore-filters__field">
			<span>Title</span>
			<input
				type="search"
				name="title"
				id="title"
				autocomplete="title"
				value={ b.ActiveFilterValues.Title }
			/>
		</label>
		<label class="explore-filters__field">
			<span>School</span>
			<select name="art_school" id="art_school_select" title="Art school">
				for k, v := range b.ArtSchoolOptions {
					<option
						value={ k }
						if b.ActiveFilterValues.SchoolString == k {
							selected
						}
					>{ v }</option>
				}
			</select>
		</label>
		<label class="explore-filters__field">
			<span>Form</span>
			<select name="art_form" id="art_form_select" title="Art form">
				for k, v := range b.ArtFormOptions {
					<option
						value={ k }
						if b.ActiveFilterValues.ArtFormString == k {
							selected
						}
					>{ v }</option>
				}
			</select>
		</label>
		<label class="explore-filters__field">
			<span>Type</span>
			<select name="art_type" id="art_type_select" title="Art types">
				for k, v := range b.ArtTypeOptions {
					<option
						value={ k }
						if b.ActiveFilterValues.ArtTypeString == k {
							selected
						}
					>{ v }</option>
				}
			</select>
		</label>
		<div class="explore-filters__actions">
			if b.DualModeContext != nil {
				<button type="submit">Search</button>
			} else {
				<button type="submit">Apply filters</button>
			}
			<a href={ b.ClearUrl } hx-get={ b.ClearUrl } hx-target="#mc-area" hx-select="#mc-area" hx-swap="outerHTML">Clear all</a>
		</div>
		<div id="artwork-search-indicator" class="explore-filters__indicator htmx-indicator">
			Searching the collection...
		</div>
	</form>
}

templ ArtworkSearchResults(r dto.ArtworkSearchResultDTO) {
	<div id="artwork-search-results" class="explore-results" aria-live="polite">
		if len(r.ResultSummary) > 0 {
			<p class="explore-results__summary">{ r.ResultSummary }</p>
		}
		if len(r.Artworks) > 0 {
			if r.DualModeTarget != "" {
				@ArtworkSearchDualModeResultGrid(r.Artworks, r.DualModeUrls, r.DualModeTarget)
			} else {
				@ExploreArtworkGrid(r.Artworks)
			}
		} else if !r.ActiveFiltering {
			<div class="explore-results__empty" role="status">
				<h2>Begin with the collection</h2>
				<p>Use a keyword or refine by artist, school, form, or type to browse matching artworks.</p>
			</div>
		} else {
			<div class="explore-results__empty" role="status">
				<h2>No matching artworks</h2>
				<p>Try removing one or two filters, then search again.</p>
			</div>
		}
		if len(r.Pagination) > 10 {
			<nav class="explore-results__pagination" role="navigation" aria-label="Pagination">
				@templ.Raw(r.Pagination)
			</nav>
		}
	</div>
}

templ ExploreArtworkGrid(artworks dto.ImageGrid) {
	<div class="explore-results__grid" data-viewer>
		for _, artwork := range artworks {
			<article class="explore-artwork-card">
				<figure class="explore-artwork-card__image">
					<picture>
						<source srcset={ artwork.Thumb }/>
						<img src={ artwork.Image } alt="" data-viewer-title={ artwork.Title } loading="lazy"/>
					</picture>
				</figure>
				<a class="explore-artwork-card__link" href={ templ.SafeURL(artwork.Url) } hx-get={ artwork.Url }>
					<div class="explore-artwork-card__copy">
						<p>{ artwork.Artist.Name }</p>
						<h2>{ artwork.Title }</h2>
						if artwork.Technique != "" {
							<span>{ artwork.Technique }</span>
						}
					</div>
				</a>
			</article>
		}
	</div>
}

templ ArtworkSearchDualModeResultGrid(artworks dto.ImageGrid, dualModeUrls map[string]string, target string) {
	<div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-4" data-viewer>
		for _, artwork := range artworks {
			<div class="flex flex-col gap-2">
				@components.ImageCard(artwork, true)
				if dualModeUrls[artwork.Id] != "" {
					<a
						class="btn btn-outline"
						href={ templ.SafeURL(dualModeUrls[artwork.Id]) }
						aria-label={ "Open " + artwork.Title + " in " + target + " pane" }
					>Open in { target } pane</a>
				}
			</div>
		}
	</div>
}

templ ArtworkSearchBlock(s dto.ArtworkSearchDTO) {
	<section class="explore-artworks">
		<aside class="explore-artworks__sidebar">
			@ArtworkSeachFilterBlock(s)
		</aside>
		<div class="explore-artworks__content" id="search-result-container">
			<header class="explore-artworks__heading">
				<p>Explore the collection</p>
				<h1>Explore Artworks</h1>
				<span>Search the archive or use the filters to narrow your selection.</span>
			</header>
			@ArtworkSearchResults(s.Results)
		</div>
	</section>
}
