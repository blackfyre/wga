package pages

import (
	"fmt"
	"strconv"
	"strings"

	"github.com/blackfyre/wga/internal/assets/templ/components"
	"github.com/blackfyre/wga/internal/assets/templ/dto"
	"github.com/blackfyre/wga/internal/assets/templ/layouts"
)

// ArtworkSortOption is one sort criterion link rendered in the results header.
type ArtworkSortOption struct {
	Key       string
	Label     string
	Direction string
	Href      string
	Active    bool
}

// ArtworkSearchDualMode carries the dual-pane search routing context so a
// catalogue search can target one side of Dual Mode. It is page-owned state,
// not a record projection.
type ArtworkSearchDualMode struct {
	LeftPath      string
	RightPath     string
	LeftRenderTo  string
	RightRenderTo string
	Target        string
}

// ArtworkSearchResultsView is the HTMX-swapped result fragment contract.
type ArtworkSearchResultsView struct {
	ActiveFiltering bool
	ResultCount     int
	Artworks        dto.ImageGrid
	View            string
	GridUrl         string
	ListUrl         string
	ResetUrl        string
	SortOptions     []ArtworkSortOption
	DualModeUrls    map[string]string
	DualModeTarget  string
	Pagination      string
}

// ArtworkSearchView is the page-owned contract for the artwork catalogue.
type ArtworkSearchView struct {
	NameField             dto.Field
	TechniqueField        dto.Field
	ArtistID              string
	ArtistScopeFilingName string
	TypeGroup             dto.ChipGroup
	PeriodGroup           dto.ChipGroup
	LocationGroup         dto.ChipGroup
	Facets                ArtworkSearchFacets
	Sort                  string
	Dir                   string
	ClearUrl              string
	DualModeContext       *ArtworkSearchDualMode
	HxTarget              string
	Results               ArtworkSearchResultsView
}

// ArtworkSearchPage is the template for the artwork catalogue page.
templ ArtworkSearchPage(s ArtworkSearchView) {
	@layouts.LayoutMain() {
		@ArtworkSearchBlock(s)
	}
}

templ artworkSearchFacet(facet ArtworkSearchFacet) {
	<details open?={ facet.Open } class={ "group py-3.5", templ.KV("border-b border-wga-ink/15", !facet.Last) }>
		<summary class="flex cursor-pointer list-none items-baseline justify-between gap-2.5 marker:hidden [&::-webkit-details-marker]:hidden">
			<span class="font-mono text-(length:--t-10) tracking-[1.5px] text-wga-ink/60">{ facet.Label }</span>
			<span class="flex min-w-0 items-baseline gap-2">
				<span class={ "max-w-[116px] truncate font-mono text-(length:--t-10) tracking-[1px]", templ.KV("font-semibold text-wga-ink", facet.Active), templ.KV("text-wga-ink/60", !facet.Active) }>{ facet.Summary }</span>
				<span class="w-2 text-center font-mono text-xs text-wga-ink/60" aria-hidden="true">
					<span class="group-open:hidden">+</span>
					<span class="hidden group-open:inline">−</span>
				</span>
			</span>
		</summary>
		<div class="mt-3">
			{ children... }
		</div>
	</details>
}

templ ArtworkSeachFilterBlock(b ArtworkSearchView) {
	<form
		id="artwork-filters"
		action="/artworks"
		hx-get="/artworks"
		hx-disabled-elt="button"
		hx-target={ b.HxTarget }
		hx-select={ b.HxTarget }
		hx-swap="outerHTML"
		hx-indicator="inherit, #artwork-search-indicator"
		hx-sync="this:replace"
		method="GET"
		hx-trigger="change, input changed delay:300ms"
		class="w-full"
	>
		if b.ArtistID != "" {
			<input type="hidden" name="artist_id" value={ b.ArtistID }/>
		}
		if b.Sort != "title" {
			<input type="hidden" name="sort" value={ b.Sort }/>
		}
		if b.Dir != "asc" {
			<input type="hidden" name="dir" value={ b.Dir }/>
		}
		if b.Results.View != "grid" {
			<input type="hidden" name="view" value={ b.Results.View }/>
		}
		if b.DualModeContext != nil {
			<input type="hidden" name="dual_left" value={ b.DualModeContext.LeftPath }/>
			<input type="hidden" name="dual_right" value={ b.DualModeContext.RightPath }/>
			<input type="hidden" name="dual_left_render_to" value={ b.DualModeContext.LeftRenderTo }/>
			<input type="hidden" name="dual_right_render_to" value={ b.DualModeContext.RightRenderTo }/>
			<input type="hidden" name="dual_target" value={ b.DualModeContext.Target }/>
		}
		if b.ArtistScopeFilingName != "" {
			<div data-artwork-artist-scope aria-label="Active artist" class="mb-5 border-l-2 border-wga-accent pl-3">
				<p class="font-mono text-(length:--t-10) tracking-[1.5px] text-wga-ink/60">ARTIST</p>
				<p class="mt-1 text-sm font-semibold leading-snug text-wga-ink">{ b.ArtistScopeFilingName }</p>
			</div>
		}
		<div class="flex items-baseline justify-between border-b border-wga-ink pb-3">
			<p class="font-mono text-(length:--t-11) tracking-[1.5px]">
				FILTERS
				if b.Facets.ActiveCount > 0 {
					<span class="text-wga-accent">{ artworkActiveCountLabel(b.Facets.ActiveCount) }</span>
				}
			</p>
			if b.DualModeContext != nil {
				<a class="wga-action-link font-mono text-(length:--t-10) tracking-[1px]" href={ b.ClearUrl } hx-get={ b.ClearUrl } hx-target="#mc-area" hx-select="#mc-area" hx-swap="outerHTML">RESET</a>
			} else {
				<a class="wga-action-link font-mono text-(length:--t-10) tracking-[1px]" href={ b.ClearUrl }>RESET</a>
			}
		</div>
		@artworkSearchFacet(b.Facets.Query) {
			<label class="block">
				<span class="sr-only">{ b.NameField.Label }</span>
				<input
					class="w-full border-0 border-b border-wga-ink bg-transparent px-0 py-2 text-sm"
					type="search"
					id="artwork-query"
					data-keyboard-page-search
					name="q"
					placeholder="e.g. milkmaid"
					value={ b.NameField.Value }
				/>
			</label>
		}
		@artworkSearchFacet(b.Facets.Technique) {
			<label class="block">
				<span class="sr-only">{ b.TechniqueField.Label }</span>
				<input
					class="w-full border-0 border-b border-wga-ink bg-transparent px-0 py-2 text-sm"
					type="search"
					id="artwork-technique"
					name="technique"
					placeholder="e.g. oil on canvas"
					value={ b.TechniqueField.Value }
				/>
			</label>
		}
		@artworkSearchFacet(b.Facets.School) {
			@artworkSearchMultiFacet(b.Facets.SchoolMulti)
		}
		@artworkSearchFacet(b.Facets.Form) {
			@artworkSearchMultiFacet(b.Facets.FormMulti)
		}
		@artworkSearchFacet(b.Facets.Type) {
			@components.ChipGroup(artworkSearchChipGroup(b.TypeGroup))
		}
		@artworkSearchFacet(b.Facets.Period) {
			@components.ChipGroup(artworkSearchChipGroup(b.PeriodGroup))
		}
		@artworkSearchFacet(b.Facets.Collection.Facet) {
			<label class="block">
				<span class="sr-only">{ b.Facets.Collection.QueryField.Label }</span>
				<input
					type="search"
					name={ b.Facets.Collection.QueryField.Name }
					value={ b.Facets.Collection.QueryField.Value }
					placeholder={ b.Facets.Collection.QueryField.Placeholder }
					class="w-full border-0 border-b border-wga-ink/30 bg-transparent px-0 py-1.5 text-sm"
				/>
			</label>
			<div class="mt-3 max-h-[196px] overflow-y-auto overscroll-contain border-t border-wga-ink/10">
				<label class="flex cursor-pointer items-baseline justify-between gap-2.5 border-b border-wga-ink/10 py-1.5 text-sm leading-snug transition-colors hover:text-wga-accent">
					<input type="radio" name={ b.Facets.Collection.Name } value="" checked?={ !b.Facets.Collection.Facet.Active } class="sr-only"/>
					<span>ALL</span>
				</label>
				for _, option := range b.Facets.Collection.Options {
					<label class={ "flex cursor-pointer items-baseline justify-between gap-2.5 border-b border-wga-ink/10 py-1.5 text-sm leading-snug transition-colors hover:text-wga-accent", templ.KV("font-semibold text-wga-ink", option.Selected), templ.KV("text-wga-ink/70", !option.Selected) }>
						<input type="radio" name={ b.Facets.Collection.Name } value={ option.Value } checked?={ option.Selected } class="sr-only"/>
						<span>{ option.Label }</span>
						<span class={ "shrink-0 font-mono text-(length:--t-10)", templ.KV("text-wga-ink", option.Selected), templ.KV("text-wga-ink/60", !option.Selected) }>{ option.Count }</span>
					</label>
				}
			</div>
			if b.Facets.Collection.Note != "" {
				<p class="mt-2.5 font-mono text-(length:--t-10) leading-relaxed text-wga-ink/60">{ b.Facets.Collection.Note }</p>
			}
		}
		@artworkSearchFacet(b.Facets.Year) {
			@components.RangeField(b.Facets.YearRange)
		}
		<noscript><button type="submit" class="wga-button wga-button-primary w-full font-mono text-(length:--t-11) tracking-[1px]">APPLY FILTERS</button></noscript>
		<div id="artwork-search-indicator" class="htmx-indicator border border-wga-fill bg-wga-surface-2/70 p-3 text-sm text-wga-ink/80">
			Searching the collection...
		</div>
	</form>
}

templ artworkSearchMultiFacet(facet ArtworkSearchMultiFacet) {
	<div class="border-t border-wga-ink/10">
		for _, option := range facet.Options {
			<label class={ "flex min-h-8 items-center justify-between gap-2.5 border-b border-wga-ink/10 py-1.5 text-sm leading-snug", templ.KV("cursor-pointer hover:text-wga-accent", !option.Disabled), templ.KV("cursor-not-allowed text-wga-ink/40", option.Disabled), templ.KV("font-semibold text-wga-ink", option.Selected) }>
				<span class="flex min-w-0 items-center gap-2">
					<input type="checkbox" name={ facet.Name } value={ option.Value } checked?={ option.Selected } disabled?={ option.Disabled } class="h-4 w-4 shrink-0 accent-wga-accent"/>
					<span class="truncate">{ option.Label }</span>
				</span>
				<span class="shrink-0 font-mono text-(length:--t-10) tabular-nums text-wga-ink/60">{ option.Count }</span>
			</label>
		}
	</div>
	<div class="mt-2.5 flex items-center justify-between gap-3 font-mono text-(length:--t-10) tracking-[1px]">
		if facet.Active {
			<a href={ templ.SafeURL(facet.ClearURL) } hx-get={ facet.ClearURL } hx-target="#artwork-search" hx-select="#artwork-search" hx-swap="outerHTML" class="wga-action-link">CLEAR</a>
		}
		if facet.ToggleURL != "" {
			<a href={ templ.SafeURL(facet.ToggleURL) } hx-get={ facet.ToggleURL } hx-target="#artwork-search" hx-select="#artwork-search" hx-swap="outerHTML" class="wga-action-link ml-auto">{ facet.ToggleLabel }</a>
		}
	</div>
}

func artworkSearchChipGroup(group dto.ChipGroup) dto.ChipGroup {
	group.Inline = true
	group.VisuallyHideLegend = true
	return group
}

templ ArtworkSortControl(r ArtworkSearchResultsView) {
	<div class="flex flex-wrap items-center gap-2">
		<span class="font-mono text-(length:--t-10) tracking-[1.5px] text-wga-ink/60">SORT</span>
		for _, option := range r.SortOptions {
			<a
				href={ templ.SafeURL(option.Href) }
				hx-get={ option.Href }
				hx-target="#artwork-search"
				hx-select="#artwork-search"
				hx-swap="outerHTML"
				class={ "border px-[13px] py-1.5 font-mono text-(length:--t-11) leading-[18px] tracking-[1px] transition-colors", templ.KV("border-wga-accent bg-wga-accent-bg text-wga-inv-fg", option.Active), templ.KV("border-wga-ink/25 text-wga-ink/70 hover:border-wga-ink", !option.Active) }
				aria-current={ fmt.Sprint(option.Active) }
			>
				{ option.Label }
				if option.Direction != "" {
					{ " " + option.Direction }
				}
			</a>
		}
	</div>
}

templ ArtworkSearchResults(r ArtworkSearchResultsView) {
	<div id="artwork-search-results">
		<div class="flex flex-wrap items-baseline justify-between gap-3 border-b border-wga-ink pb-4">
			<p class="font-mono text-xs text-wga-ink/60" aria-live="polite">
				{ artworkMatchCount(r.ResultCount) }
			</p>
			<div class="flex flex-col items-start gap-3 md:flex-row md:items-center md:gap-5">
				@ArtworkSortControl(r)
				<div class="flex items-center gap-2">
					<a href={ templ.SafeURL(r.GridUrl) } hx-get={ r.GridUrl } hx-target="#artwork-search" hx-select="#artwork-search" hx-swap="outerHTML" class={ "border px-[13px] py-1.5 font-mono text-(length:--t-11) leading-[18px] tracking-[1px] transition-colors", templ.KV("border-wga-accent bg-wga-accent-bg text-wga-inv-fg", r.View == "grid"), templ.KV("border-wga-ink/25 text-wga-ink/70 hover:border-wga-ink", r.View != "grid") } aria-pressed={ fmt.Sprint(r.View == "grid") }>GRID</a>
					<a href={ templ.SafeURL(r.ListUrl) } hx-get={ r.ListUrl } hx-target="#artwork-search" hx-select="#artwork-search" hx-swap="outerHTML" class={ "border px-[13px] py-1.5 font-mono text-(length:--t-11) leading-[18px] tracking-[1px] transition-colors", templ.KV("border-wga-accent bg-wga-accent-bg text-wga-inv-fg", r.View == "list"), templ.KV("border-wga-ink/25 text-wga-ink/70 hover:border-wga-ink", r.View != "list") } aria-pressed={ fmt.Sprint(r.View == "list") }>LIST</a>
				</div>
			</div>
		</div>
		if len(r.Artworks) > 0 {
			if r.DualModeTarget != "" {
				@ArtworkSearchDualModeResultGrid(r.Artworks, r.DualModeUrls, r.DualModeTarget)
			} else if r.View == "list" {
				@ArtworkSearchResultList(r.Artworks)
			} else {
				<div class="mt-7 grid grid-cols-2 gap-x-4 gap-y-9 md:grid-cols-3 md:gap-x-7" data-kbd-list data-kbd-cols="2" data-kbd-cols-md="3" data-view="grid">
					for index, artwork := range r.Artworks {
						<article class="flex h-full min-w-0 flex-col">
							<a href={ templ.SafeURL(artwork.Url) } hx-get={ artwork.Url } data-kbd-idx={ strconv.Itoa(index) } data-kbd-href={ artwork.Url } class="wga-record-card flex flex-1 flex-col">
								@components.KeyboardCaret()
								<figure class="mb-2.5 aspect-[4/5] border border-wga-ink/15 bg-wga-fill p-2.5">
									<img src={ artwork.Thumb } alt={ artwork.Title } width="500" height="625" loading="lazy" class="h-full w-full object-cover"/>
								</figure>
								<p title={ artwork.Title } class="line-clamp-2 min-h-[2.6em] break-words text-sm font-semibold leading-tight">{ artwork.Title }</p>
								<p class="mt-[3px] line-clamp-2 min-h-[3.2em] break-words font-mono text-(length:--t-11) leading-relaxed text-muted" data-artwork-result-meta="identity">{ artworkSearchMetadata(artwork.Artist.FilingName, artwork.Date) }</p>
								<p class="min-h-[1.6em] overflow-hidden text-ellipsis whitespace-nowrap font-mono text-(length:--t-11) leading-relaxed text-muted" data-artwork-result-meta="classification">{ artworkSearchMetadata(artwork.School, artwork.Type) }</p>
							</a>
							@artworkSearchWorkspaceActions(artwork, false)
						</article>
					}
				</div>
			}
		} else if !r.ActiveFiltering {
			@components.EmptyState(dto.EmptyState{
				Title:   "SET FILTERS TO BROWSE THE COLLECTION",
				Message: "Combine title, school, form, type, technique, and period filters, then run a search.",
			})
		} else {
			@components.EmptyState(dto.EmptyState{
				Title:         "NO MATCHING WORKS",
				Message:       "Try clearing one or two filters, or widen the period range.",
				RecoveryLabel: "RESET FILTERS →",
				RecoveryHref:  r.ResetUrl,
			})
		}
		if len(r.Pagination) > 10 {
			<nav class="wga-pagination" role="navigation" aria-label="pagination">
				@templ.Raw(r.Pagination)
			</nav>
		}
	</div>
}

// artworkMatchCount keeps the readout grammatical.
func artworkMatchCount(total int) string {
	if total == 1 {
		return "1 WORK MATCHES"
	}

	return fmt.Sprintf("%d WORKS MATCH", total)
}

// artworkActiveCountLabel renders the compact filter-count readout next to the
// FILTERS heading. It is absent entirely when no result-shaping filter is set.
func artworkActiveCountLabel(count int) string {
	return " · " + strconv.Itoa(count) + " ACTIVE"
}

templ ArtworkSearchResultList(artworks dto.ImageGrid) {
	<ul data-kbd-list data-kbd-cols="1" data-view="list">
		for index, artwork := range artworks {
			<li class="flex flex-col border-b border-wga-ink/15 lg:flex-row lg:items-stretch">
				<a href={ templ.SafeURL(artwork.Url) } hx-get={ artwork.Url } data-kbd-idx={ strconv.Itoa(index) } data-kbd-href={ artwork.Url } class="flex min-w-0 flex-1 items-center gap-4 py-3.5 transition-colors hover:bg-wga-accent-bg/5">
					@components.KeyboardCaret()
					<img src={ artwork.Thumb } alt={ artwork.Title } width="44" height="54" loading="lazy" class="h-[54px] w-11 shrink-0 border border-wga-ink/15 bg-wga-fill object-cover"/>
					<span class="min-w-0 flex-1"><span class="block text-(length:--t-15) font-semibold leading-tight">{ artwork.Title }</span><span class="mt-[3px] block font-mono text-(length:--t-11) text-muted" data-artwork-result-meta="identity">{ artworkSearchMetadata(artwork.Artist.FilingName, artwork.Date) }</span></span>
					<span class="hidden w-28 shrink-0 font-mono text-(length:--t-10) text-muted lg:block"><span class="block text-faint">SCHOOL</span>{ artworkSearchValue(artwork.School) }</span>
					<span class="hidden w-28 shrink-0 font-mono text-(length:--t-10) text-muted lg:block"><span class="block text-faint">FORM</span>{ artworkSearchValue(artwork.Form) }</span>
					<span class="hidden w-28 shrink-0 font-mono text-(length:--t-10) text-muted lg:block"><span class="block text-faint">TYPE</span>{ artworkSearchValue(artwork.Type) }</span>
				</a>
				@artworkSearchWorkspaceActions(artwork, true)
			</li>
		}
	</ul>
}

templ artworkSearchWorkspaceActions(artwork dto.Image, dense bool) {
	<div class={ "mt-auto flex w-full shrink-0 flex-col gap-2 py-2.5", templ.KV("lg:w-52 lg:pl-3", dense) } data-artwork-workspace-actions>
		@components.AddToItineraryAction(artwork.Id, components.AddToItinerarySearchBlock)
		@components.AddToStudyBoardAction(artwork.Id, artwork.Title, artwork.Thumb, components.AddToStudyBoardCard)
	</div>
}

func artworkSearchMetadata(values ...string) string {
	known := make([]string, 0, len(values))
	for _, value := range values {
		if value = strings.TrimSpace(value); value != "" {
			known = append(known, value)
		}
	}
	if len(known) == 0 {
		return "NOT RECORDED"
	}
	return strings.Join(known, " · ")
}

func artworkSearchValue(value string) string {
	if value = strings.TrimSpace(value); value == "" {
		return "—"
	}
	return value
}

templ ArtworkSearchDualModeResultGrid(artworks dto.ImageGrid, dualModeUrls map[string]string, target string) {
	<div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-4">
		for _, artwork := range artworks {
			<div class="flex flex-col gap-2">
				@components.ImageCard(artwork, true)
				if dualModeUrls[artwork.Id] != "" {
					<a
						class="wga-button"
						href={ templ.SafeURL(dualModeUrls[artwork.Id]) }
						aria-label={ "Open " + artwork.Title + " in " + target + " pane" }
					>Open in { target } pane</a>
				}
			</div>
		}
	</div>
}

templ ArtworkSearchBlock(s ArtworkSearchView) {
	<section id="artwork-search" hx-indicator="#artwork-search-skeleton" class="container mx-auto px-4 pb-20 pt-10 md:px-0 wga-enter">
		<p class="mb-3 font-mono text-(length:--t-11) tracking-[2px] text-wga-ink/60">12 — ARTWORK SEARCH</p>
		<h1 class="mb-3 text-(length:--t-44) font-semibold leading-tight tracking-[-0.5px]">Artworks</h1>
		<p class="mb-11 max-w-[540px] text-base leading-relaxed text-wga-ink/70">Filter by title, school, form and technique — or narrow by period when you are working through a century rather than a name.</p>
		<div class="flex flex-col items-start gap-10 md:flex-row md:gap-14">
			<div class="w-full shrink-0 md:w-[250px]">
				@ArtworkSeachFilterBlock(s)
			</div>
			<div class="w-full min-h-48" id="search-result-container">
				@components.SearchResultSkeleton("artwork-search-skeleton", s.Results.View)
				<div class="wga-search-current">@ArtworkSearchResults(s.Results)</div>
			</div>
		</div>
	</section>
}
