package pages

import (
	"github.com/blackfyre/wga/internal/assets/templ/components"
	"github.com/blackfyre/wga/internal/assets/templ/dto"
	"github.com/blackfyre/wga/internal/assets/templ/layouts"
	"github.com/blackfyre/wga/internal/assets/templ/utils"
)

templ ArtistPage(c dto.Artist) {
	@layouts.LayoutMain() {
		@ArtistBlock(c)
	}
}

templ ArtistBlock(a dto.Artist) {
	<head>
		<title>{ utils.GetTitle(ctx) }</title>
	</head>
	<section class="container mx-auto px-4 pb-20 pt-10 md:px-0">
		if a.ShowBreadcrumbs {
			<nav class="mb-8 font-mono text-[10px] tracking-[1.5px] text-base-content/60" aria-label="Breadcrumb">
				<a href="/artists" hx-get="/artists" hx-target={ a.HxTarget } class="hover:text-base-content">ARTISTS</a>
				<span class="mx-2" aria-hidden="true">/</span>
				if a.Schools != "" {
					<span>{ a.Schools }</span>
					<span class="mx-2" aria-hidden="true">/</span>
				}
				<a href={ templ.URL(a.Url) } hx-get={ a.Url } hx-target={ a.HxTarget } class="text-base-content" aria-current="page">{ a.Name }</a>
			</nav>
		}
		<article class="grid gap-8 md:grid-cols-[minmax(0,1fr)_200px]">
			<div>
				<p class="font-mono text-[11px] tracking-[2px] text-base-content/60">02 — ARTIST</p>
				<h1 class="mt-3 text-[44px] font-semibold leading-[1.05] tracking-[-0.75px] md:text-[52px]">{ a.Name }</h1>
				<p class="mt-4 font-mono text-[12px] tracking-[1px] text-primary">{ a.BioExcerpt } · { a.Schools }</p>
			</div>
			<figure class="flex aspect-square items-end border border-base-content/15 bg-base-300 p-3">
				<figcaption class="font-mono text-[9px] tracking-[1px] text-base-content/40">PORTRAIT — { a.Name }</figcaption>
			</figure>
		</article>
		<div class="mt-10 flex flex-col gap-10 border-t border-base-content/15 pt-8 md:flex-row md:gap-16">
			<aside class="w-full shrink-0 md:w-[300px]">
				<p class="font-mono text-[10px] tracking-[1.5px] text-base-content/60">LIFE</p>
				<p class="mt-2 text-sm leading-relaxed">{ a.BioExcerpt }</p>
				if a.Schools != "" {
					<p class="mt-6 font-mono text-[10px] tracking-[1.5px] text-base-content/60">SCHOOLS</p>
					<p class="mt-2 text-sm leading-relaxed">{ a.Schools }</p>
				}
				if a.Profession != "" {
					<p class="mt-6 font-mono text-[10px] tracking-[1.5px] text-base-content/60">PROFESSION</p>
					<p class="mt-2 text-sm leading-relaxed">{ a.Profession }</p>
				}
			</aside>
			<div class="min-w-0 flex-1">
				<p class="mb-3 font-mono text-[11px] tracking-[1.5px] text-base-content/60">BIOGRAPHY</p>
				<div class="content max-w-[620px] text-[16px] leading-[1.7]">
					@templ.Raw(a.Bio)
				</div>
				<section class="mt-11 max-w-[620px]">
					<div class="mb-5 flex items-baseline justify-between border-t border-base-content/15 pt-[18px]">
						<h2 class="font-mono text-[11px] tracking-[1.5px]">WORKS IN ARCHIVE</h2>
						<p class="font-mono text-[10px] tracking-[1px] text-base-content/60">{ len(a.Works) } RECORDS</p>
					</div>
					@components.PublicArtworkGrid(a.Works)
				</section>
			</div>
		</div>
		@templ.Raw(a.Jsonld)
	</section>
}
