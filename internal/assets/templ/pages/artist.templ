package pages

import (
	"fmt"
	"time"
	"github.com/blackfyre/wga/internal/assets/templ/dto"
	"github.com/blackfyre/wga/internal/assets/templ/layouts"
	"github.com/blackfyre/wga/internal/assets/templ/utils"
)

func ArtistBibTeX(a dto.Artist) string {
	date := time.Now().UTC().Format(time.DateOnly)

	return fmt.Sprintf("@online{wga-artist-%s,\n  author       = {{Web Gallery of Art}},\n  title        = {%s Biography},\n  organization = {{Web Gallery of Art}},\n  date         = {%s},\n  url          = {%s},\n  urldate      = {%s},\n  langid       = {english}\n}", a.Id, a.Name, date, a.CitationUrl, date)
}

// ArtistPage is the template for the artist page
templ ArtistPage(c dto.Artist) {
	@layouts.LayoutMain() {
		@ArtistBlock(c)
	}
}

// ArtistsBlock is the template for the artist block
templ ArtistBlock(a dto.Artist) {
	<head>
		<title>{ utils.GetTitle(ctx) }</title>
	</head>
	<section class="artist-biography">
		if a.ShowBreadcrumbs {
			<nav class="detail-breadcrumbs" aria-label="Breadcrumb">
				<ol>
					<li><a href="/" hx-get="/">Home</a></li>
					<li><a href="/artists" hx-get="/artists" hx-target={ a.HxTarget }>Artists</a></li>
					<li aria-current="page">{ a.Name }</li>
				</ol>
			</nav>
		}
		<header class="artist-biography__header">
			<p class="artist-biography__eyebrow">Artist biography</p>
			<h1>{ a.Name }</h1>
			<div class="artist-biography__metadata">
				if a.Profession != "" {
					<span>{ a.Profession }</span>
				}
				if a.BioExcerpt != "" {
					<span>{ a.BioExcerpt }</span>
				}
			</div>
		</header>
		<div class="artist-biography__layout">
			<article class="artist-biography__content">
				<h2>Biography</h2>
				<div class="artist-biography__prose">
					@templ.Raw(a.Bio)
				</div>
			</article>
			<aside class="artist-biography__facts">
				<h2>Artist information</h2>
				<dl>
					if a.BioExcerpt != "" {
						<div>
							<dt>Life</dt>
							<dd>{ a.BioExcerpt }</dd>
						</div>
					}
					if a.Profession != "" {
						<div>
							<dt>Known for</dt>
							<dd>{ a.Profession }</dd>
						</div>
					}
					if a.Schools != "" {
						<div>
							<dt>School</dt>
							<dd>{ a.Schools }</dd>
						</div>
					}
					<div>
						<dt>Works in WGA</dt>
						<dd>{ len(a.Works) }</dd>
					</div>
				</dl>
				<section class="artist-biography__citation">
					<h2>Cite this biography</h2>
					<pre>{ ArtistBibTeX(a) }</pre>
				</section>
			</aside>
		</div>
		<section class="artist-biography__works">
			<header>
				<h2>Works in the collection</h2>
				<span>{ len(a.Works) } works</span>
			</header>
			<div class="artist-biography__work-grid">
				for _, work := range a.Works {
					<a href={ templ.SafeURL(work.Url) } hx-get={ work.Url }>
						<figure>
							<img src={ work.Thumb } alt={ work.Title } loading="lazy"/>
						</figure>
						<h3>{ work.Title }</h3>
						if work.Technique != "" {
							<p>{ work.Technique }</p>
						}
					</a>
				}
			</div>
		</section>
		@templ.Raw(a.Jsonld)
	</section>
}
