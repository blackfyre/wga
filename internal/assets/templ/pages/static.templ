package pages

import (
	"github.com/blackfyre/wga/internal/assets/templ/layouts"
	"github.com/blackfyre/wga/internal/assets/templ/utils"
)

type StaticPageDTO struct {
	Title   string
	Content string
	Url     string
	TOC     []StaticPageTOCItem
}

type StaticPageTOCItem struct {
	ID    string
	Title string
	Level int
}

templ StaticPage(sp StaticPageDTO) {
	@layouts.LayoutMain() {
		<head>
			<title>{ utils.GetTitle(ctx) }</title>
		</head>
		@StaticPageBlock(sp)
	}
}

templ StaticPageBlock(sp StaticPageDTO) {
	<section class="container mx-auto px-4 pb-20 pt-10 md:px-0">
		if sp.Title == "About" {
			<p class="mb-3 font-mono text-[11px] tracking-[2px] text-base-content/60">14 — ABOUT THE COLLECTION</p>
			<h1 class="mb-3 text-[44px] font-semibold tracking-[-0.5px]">{ sp.Title }</h1>
			<p class="mb-12 max-w-[560px] text-[17px] leading-relaxed text-base-content/70">What this archive contains, how it is organised, and the terms under which it may be used.</p>
		} else if sp.Url == "/pages/privacy-policy" {
			<p class="mb-3 font-mono text-[11px] tracking-[2px] text-base-content/60">06 — GENERAL CONTENT</p>
			<h1 class="text-[44px] font-semibold tracking-[-0.5px]">{ sp.Title }</h1>
		} else {
			<p class="mb-3 font-mono text-[11px] tracking-[2px] text-base-content/60">PUBLIC INFORMATION</p>
			<h1 class="text-[44px] font-semibold tracking-[-0.5px]">{ sp.Title }</h1>
		}
		<div class={ "flex flex-col gap-10 md:flex-row md:gap-16", templ.KV("mt-10", sp.Title != "About") }>
			if len(sp.TOC) > 0 {
				<nav class="w-full shrink-0 md:w-52" aria-label="Contents">
					<p class="mb-3 font-mono text-[10px] tracking-[1.5px] text-base-content/60">CONTENTS</p>
					<ol class="border-t border-base-content/15">
						for _, item := range sp.TOC {
							<li class={ "border-b border-base-content/15", templ.KV("pl-4", item.Level == 3) }>
								<a class="block py-2.5 font-mono text-xs text-base-content/70 hover:text-primary" href={ templ.URL("#" + item.ID) }>{ item.Title }</a>
							</li>
						}
					</ol>
				</nav>
			}
			<article class="content max-w-[680px] flex-1 leading-[1.7]">
				@templ.Raw(sp.Content)
			</article>
		</div>
	</section>
}
