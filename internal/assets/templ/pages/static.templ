package pages

import (
	"github.com/blackfyre/wga/internal/assets/templ/components"
	"github.com/blackfyre/wga/internal/assets/templ/layouts"
	"github.com/blackfyre/wga/internal/assets/templ/utils"
)

type StaticPageDTO struct {
	Title   string
	Content string
	Url     string
	TOC     []StaticPageTOCItem
}

type StaticPageTOCItem struct {
	ID    string
	Title string
	Level int
}

templ StaticPage(sp StaticPageDTO) {
	@layouts.LayoutMain() {
		<head>
			<title>{ utils.GetTitle(ctx) }</title>
		</head>
		@StaticPageBlock(sp)
	}
}

// staticPageIndex selects the route-identity kicker from the page's own URL,
// never from the editable title.
func staticPageIndex(url string) string {
	switch url {
	case "/pages/about":
		return "14 — ABOUT THE COLLECTION"
	case "/pages/privacy-policy":
		return "06 — GENERAL CONTENT"
	default:
		return "PUBLIC INFORMATION"
	}
}

templ StaticPageBlock(sp StaticPageDTO) {
	<section class="container mx-auto px-4 pb-20 pt-10 md:px-0">
		@components.PageHead(staticPageIndex(sp.Url), sp.Title, "")
		<div class="flex flex-col gap-10 md:flex-row md:gap-16">
			if len(sp.TOC) > 0 {
				<nav class="w-full shrink-0 md:sticky md:top-8 md:w-52 md:self-start" aria-label="Contents">
					<p class="mb-3 font-mono text-(length:--t-10) tracking-[1.5px] text-muted">CONTENTS</p>
					<ol class="border-t border-base-content/15">
						for _, item := range sp.TOC {
							<li class={ "border-b border-base-content/15", templ.KV("pl-4", item.Level == 3) }>
								<a class="block py-2.5 font-mono text-xs text-base-content/70 transition-colors hover:text-primary" href={ templ.URL("#" + item.ID) }>{ item.Title }</a>
							</li>
						}
					</ol>
				</nav>
			}
			<article class="content max-w-[680px] flex-1 leading-[1.7]">
				@templ.Raw(sp.Content)
			</article>
		</div>
	</section>
}
