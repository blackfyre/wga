package pages

import (
	"fmt"

	"github.com/blackfyre/wga/internal/assets/templ/components"
	"github.com/blackfyre/wga/internal/assets/templ/dto"
	"github.com/blackfyre/wga/internal/assets/templ/layouts"
)

// The shared slideshow. One stop per request (/itineraries/{token}?stop=N) so it
// works without JavaScript; the itinerary helper adds arrow-key navigation and
// prefetches the neighbouring stops on top of that.
//
// It renders as a fixed dark overlay over the ordinary layout rather than in a
// new bare layout, so the header, footer and cookie notice keep working
// underneath and no second document shell has to be maintained.

templ ItineraryViewPage(view dto.ItineraryView) {
	@layouts.LayoutMain() {
		<section
			id="itinerary-viewer"
			class="wga-viewer"
			data-itinerary-viewer
			aria-label={ "Itinerary: " + view.Title }
		>
			<div class="wga-viewer-stage">
				<div class="flex shrink-0 items-start justify-between gap-6">
					<div class="min-w-0">
						<p class="mb-1.5 font-mono text-[9px] tracking-[1.5px] text-white/40">VISITOR ITINERARY</p>
						<p class="text-[15px] font-semibold leading-tight text-white/90">{ view.Title }</p>
					</div>
					<a href={ templ.SafeURL(view.ExitURL) } data-itinerary-exit class="shrink-0 px-1 font-mono text-[13px] text-white/40 transition-colors hover:text-white/90">✕ CLOSE</a>
				</div>

				<figure class="wga-viewer-plate">
					if view.Plate.DisplayURL != "" {
						if view.Plate.ZoomURL != "" {
							<a href={ templ.SafeURL(view.Plate.ZoomURL) } data-viewer data-viewer-label={ view.Plate.Label } aria-label={ view.Plate.Label } class="relative flex h-full w-full items-center justify-center">
								<img src={ view.Plate.DisplayURL } alt={ view.Plate.Alt } loading="lazy" data-zoom-url={ view.Plate.ZoomURL } class="max-h-full max-w-full object-contain"/>
								@components.ZoomHint()
							</a>
						} else {
							<img src={ view.Plate.DisplayURL } alt={ view.Plate.Alt } loading="lazy" class="max-h-full max-w-full object-contain"/>
						}
					} else {
						<figcaption class="text-center font-mono text-[10px] uppercase tracking-[1px] text-white/25">{ view.Plate.Placeholder }</figcaption>
					}
				</figure>

				<div class="shrink-0">
					<ol class="flex gap-1" aria-label="Progress">
						for i, stopURL := range view.StopURLs {
							<li class="flex-1">
								<a href={ templ.SafeURL(stopURL) } hx-get={ templ.SafeURL(stopURL) } class={ "block h-[3px] transition-colors", templ.KV("bg-white/90", i <= view.Index), templ.KV("bg-white/20", i > view.Index) } aria-label={ fmt.Sprintf("Go to stop %d", i+1) }></a>
							</li>
						}
					</ol>
					<div class="mt-4 flex items-center justify-between gap-4">
						if view.HasPrev {
							<a href={ templ.SafeURL(view.PrevURL) } hx-get={ templ.SafeURL(view.PrevURL) } rel="prev" data-itinerary-nav="prev" data-itinerary-prefetch class="font-mono text-[11px] tracking-[1.5px] text-white/90 transition-colors hover:text-white">← PREVIOUS</a>
						} else {
							<span class="font-mono text-[11px] tracking-[1.5px] text-white/25">← PREVIOUS</span>
						}
						<p class="font-mono text-[11px] tracking-[1.5px] text-white/40">{ fmt.Sprintf("%02d / %02d", view.Index+1, view.Total) }</p>
						if view.HasNext {
							<a href={ templ.SafeURL(view.NextURL) } hx-get={ templ.SafeURL(view.NextURL) } rel="next" data-itinerary-nav="next" data-itinerary-prefetch class="font-mono text-[11px] tracking-[1.5px] text-white/90 transition-colors hover:text-white">NEXT →</a>
						} else {
							<span class="font-mono text-[11px] tracking-[1.5px] text-white/25">END OF ITINERARY</span>
						}
					</div>
				</div>
			</div>

			<aside class="wga-viewer-panel">
				<div>
					<p class="mb-4 font-mono text-[9px] tracking-[1.5px] text-white/40">{ fmt.Sprintf("STOP %02d OF %02d", view.Index+1, view.Total) }</p>
					<h1 class="mb-2 text-[22px] font-semibold leading-tight tracking-[-0.3px] text-white/90 md:text-[27px]">{ view.StopTitle }</h1>
					<p class="mb-6 font-mono text-[11px] leading-loose text-white/50">
						{ view.StopArtist }, { view.StopDate }
						if view.StopSchool != "" {
							<br/>
							{ view.StopSchool } SCHOOL
						}
					</p>
					if view.Narration == "" {
						<p class="text-[15px] leading-relaxed text-white/60 md:text-base">
							The maker left this plate without narration. Look at it for as long as you like.
						</p>
					} else {
						<p class="text-[15px] leading-relaxed text-white/75 md:text-base">{ view.Narration }</p>
					}
				</div>
				<p class="mt-8 border-t border-white/15 pt-4 font-mono text-[9px] leading-loose tracking-[1.5px] text-white/40">
					NARRATION BY { view.Creator }
					<br/>
					USE ← AND → TO MOVE · ESC TO CLOSE
				</p>
			</aside>
		</section>
	}
}
