package pages

import (
	"github.com/blackfyre/wga/internal/assets/templ/components"
	"github.com/blackfyre/wga/internal/assets/templ/dto"
	"github.com/blackfyre/wga/internal/assets/templ/layouts"
	"github.com/blackfyre/wga/internal/assets/templ/utils"
)

templ ArtworkPage(aw dto.Artwork) {
	@layouts.LayoutMain() {
		@ArtworkBlock(aw)
	}
}

templ ArtworkBlock(aw dto.Artwork) {
	<head>
		<title>{ utils.GetTitle(ctx) }</title>
	</head>
	<section class="container mx-auto px-4 pb-20 pt-10 md:px-0">
		if aw.ShowBreadcrumbs {
			<nav class="mb-8 overflow-x-auto whitespace-nowrap font-mono text-[10px] tracking-[1.5px] text-base-content/60" aria-label="Breadcrumb">
				if aw.Artist.Url != "" {
					<a href="/artists" hx-get="/artists" hx-target={ aw.HxTarget } class="hover:text-base-content">ARTISTS</a>
					<span class="mx-2" aria-hidden="true">/</span>
					<a href={ templ.URL(aw.Artist.Url) } hx-get={ aw.Artist.Url } hx-target={ aw.HxTarget } class="hover:text-base-content">{ aw.Artist.Name }</a>
				} else {
					<a href="/artworks" hx-get="/artworks" hx-target={ aw.HxTarget } class="hover:text-base-content">ARTWORKS</a>
				}
				<span class="mx-2" aria-hidden="true">/</span>
				<a href={ templ.URL(aw.Url) } hx-get={ aw.Url } hx-target={ aw.HxTarget } class="text-base-content" aria-current="page">{ aw.Title }</a>
			</nav>
		}
		<div class="grid gap-8 lg:grid-cols-[minmax(0,1.3fr)_minmax(280px,0.7fr)] lg:gap-12">
			<div data-viewer class="border border-base-content/15 bg-base-300 p-3">
				@components.ImageBig(aw.Image.Image, aw.Image.Title, aw.Artist.Name)
			</div>
			<article class="lg:self-start">
				<p class="font-mono text-[11px] tracking-[2px] text-base-content/60">03 — ARTWORK</p>
				<h1 class="mt-4 text-[44px] font-semibold leading-[1.08] tracking-[-0.5px]">{ aw.Title }</h1>
				if aw.Artist.Name != "" {
					<p class="mt-4 font-mono text-[12px] tracking-[1px] text-primary"><a href={ templ.SafeURL(aw.Artist.Url) } hx-get={ aw.Artist.Url } hx-target={ aw.HxTarget } class="hover:opacity-70">{ aw.Artist.Name } →</a></p>
				}
				if aw.Technique != "" {
					<div class="mt-7 border-y border-base-content/15 py-3">
						<p class="font-mono text-[10px] tracking-[1.2px] text-base-content/60">MEDIUM</p>
						<p class="mt-2 text-sm">{ aw.Technique }</p>
					</div>
				}
				<a href="#" hx-on:click="wga.dialog.open();" hx-get={ `/postcard/send?awid=` + aw.Id } hx-target="#d" hx-swap="innerHTML" hx-select=".modal-box, form[method=dialog].modal-backdrop" class="mt-7 flex w-full justify-center bg-primary px-5 py-3.5 font-mono text-[11px] tracking-[1.5px] text-primary-content hover:opacity-85">SEND AS POSTCARD →</a>
			</article>
		</div>
		<div class="mt-14 flex flex-col gap-8 border-t border-base-content/15 pt-8 md:flex-row md:gap-16">
			<div class="w-full shrink-0 md:w-[300px]">
				<p class="font-mono text-[11px] tracking-[1.5px] text-base-content/60">COMMENTARY</p>
				<p class="mt-3 font-mono text-[10px] leading-relaxed text-base-content/50">UNDERLINED TERMS ARE DEFINED IN THE GLOSSARY.</p>
			</div>
			<div class="content max-w-[620px] text-[16px] leading-[1.7]">
				@templ.Raw(aw.Comment)
			</div>
		</div>
	</section>
	@templ.Raw(aw.Jsonld)
}
