package pages

import (
	"github.com/blackfyre/wga/internal/assets/templ/components"
	"github.com/blackfyre/wga/internal/assets/templ/dto"
	"github.com/blackfyre/wga/internal/assets/templ/layouts"
	"github.com/blackfyre/wga/internal/assets/templ/utils"
)

func artworkMetaEntries(aw dto.Artwork) []components.MetaEntry {
	entries := []components.MetaEntry{}
	for _, entry := range []components.MetaEntry{
		{Label: "MEDIUM", Value: aw.Technique},
		{Label: "DIMENSIONS", Value: aw.Dimensions},
		{Label: "TYPE", Value: aw.ArtType},
		{Label: "LOCATION", Value: aw.Location},
	} {
		if entry.Value != "" {
			entries = append(entries, entry)
		}
	}

	return entries
}

// artworkMusicPiece composes the composer-and-piece label for the period-music
// card from the source-backed composer and piece values.
func artworkMusicPiece(aw dto.Artwork) string {
	if aw.Music.Composer != "" {
		return aw.Music.Composer + " — " + aw.Music.Piece
	}

	return aw.Music.Piece
}

templ ArtworkPage(aw dto.Artwork) {
	@layouts.LayoutMain() {
		@ArtworkBlock(aw)
	}
}

templ ArtworkBlock(aw dto.Artwork) {
	<head>
		<title>{ utils.GetTitle(ctx) }</title>
	</head>
	<section class="container mx-auto px-4 pb-20 pt-10 md:px-0">
		if aw.ShowBreadcrumbs {
			<nav class="mb-8 overflow-x-auto whitespace-nowrap font-mono text-[10px] tracking-[1.5px] text-base-content/60" aria-label="Breadcrumb">
				if aw.Artist.Url != "" {
					<a href="/artists" hx-get="/artists" hx-target={ aw.HxTarget } class="hover:text-base-content">ARTISTS</a>
					<span class="mx-2" aria-hidden="true">/</span>
					<a href={ templ.URL(aw.Artist.Url) } hx-get={ aw.Artist.Url } hx-target={ aw.HxTarget } class="hover:text-base-content">{ aw.Artist.ShortName }</a>
				} else {
					<a href="/artworks" hx-get="/artworks" hx-target={ aw.HxTarget } class="hover:text-base-content">ARTWORKS</a>
				}
				<span class="mx-2" aria-hidden="true">/</span>
				<a href={ templ.URL(aw.Url) } hx-get={ aw.Url } hx-target={ aw.HxTarget } class="text-base-content" aria-current="page">{ aw.Title }</a>
			</nav>
		}
		<div class="flex flex-col gap-8 md:flex-row md:items-start md:gap-16">
			<figure class="w-full min-w-0 md:flex-1">
				@components.Plate(dto.Plate{DisplayURL: aw.Image.Image, ZoomURL: aw.Image.Zoom, Alt: aw.Title, Label: "IMAGE — " + aw.Title, Placeholder: "IMAGE — " + aw.Title, Aspect: "", Contain: true})
				<figcaption>
					<div class="mt-4 flex flex-wrap items-baseline justify-between gap-4 border-b border-base-content pb-2.5">
						<span class="font-mono text-(length:--t-11) tracking-[1.5px]">THIS REPRODUCTION</span>
						if aw.SourceURL != "" {
							<a href={ aw.SourceURL } target="_blank" rel="noopener noreferrer" class="font-mono text-(length:--t-11) tracking-[1px] text-primary transition-opacity hover:opacity-60">DOWNLOAD THE FULL FILE ↓</a>
						}
					</div>
					if aw.ReproFile != "" {
						<dl class="grid grid-cols-2 gap-4.5 pt-4 md:grid-cols-3 md:gap-6">
							@reproRule("FILE", aw.ReproFile)
						</dl>
					}
				</figcaption>
			</figure>
			<article class="w-full shrink-0 md:w-[380px]">
				<p class="font-mono text-[11px] tracking-[2px] text-base-content/60">03 — ARTWORK</p>
				<h1 class="mt-4 text-[44px] font-semibold leading-[1.08] tracking-[-0.5px]">{ aw.Title }</h1>
				if aw.Artist.FilingName != "" {
					<p class="mt-4 font-mono text-[12px] tracking-[1px] text-primary">
						<a href={ templ.SafeURL(aw.Artist.Url) } hx-get={ aw.Artist.Url } hx-target={ aw.HxTarget } class="hover:opacity-70">
							{ aw.Artist.FilingName }
							if aw.Year != "" {
								· { aw.Year }
							}
							→
						</a>
					</p>
				}
				<div class="mt-7">
					@components.MetaList(artworkMetaEntries(aw))
				</div>
				<div class="mt-7 flex flex-col gap-2.5">
					<a href={ `/postcard/send?awid=` + aw.Id } class="flex h-[50px] w-full items-center justify-center bg-primary px-5 font-mono text-[11px] tracking-[1.5px] text-primary-content hover:opacity-85">SEND AS POSTCARD →</a>
					@components.AddToItineraryAction(aw.Id, components.AddToItineraryBlock)
				</div>
				@artworkPaletteBlock(aw)
				if aw.Music.Available {
					@components.MusicPeriodPlayerCard(aw.Music.SongID, artworkMusicPiece(aw), aw.Music.PlayerURL)
				}
			</article>
		</div>
		<div class="mt-14 flex flex-col gap-8 border-t border-base-content/15 pt-8 md:flex-row md:gap-16">
			<div class="w-full shrink-0 md:w-[300px]">
				<p class="font-mono text-[11px] tracking-[1.5px] text-base-content/60">COMMENTARY</p>
				<p class="mt-3 font-mono text-[10px] leading-relaxed text-base-content/50">UNDERLINED TERMS ARE DEFINED IN THE GLOSSARY.</p>
			</div>
			if aw.HasCommentary {
				<div class="content max-w-[620px] text-[16px] leading-[1.7]">
					@templ.Raw(aw.SourceComment)
				</div>
			} else {
				<p class="max-w-[620px] text-[16px] leading-[1.7] text-base-content/70">Commentary is unavailable for this artwork.</p>
			}
		</div>
		if aw.CitationKey != "" {
			@components.CitationBlock(components.Citation{Key: aw.CitationKey, Title: aw.CitationTitle, URL: aw.CitationURL})
		}
		@artworkRelatedBlock(aw)
	</section>
	@templ.Raw(aw.Jsonld)
}

// artworkPaletteBlock renders the compact image-derived colour palette with a
// truthful indicative disclaimer. When no palette is recorded it states the
// unavailable state explicitly rather than omitting the section.
templ artworkPaletteBlock(aw dto.Artwork) {
	<div class="border-b border-base-content/15 py-3">
		<p class="font-mono text-(length:--t-11) tracking-[1px] text-muted">PALETTE</p>
		if len(aw.Palette) > 0 {
			<div class="mt-2.5">
				@components.PaletteBar(aw.Palette, true, "HOVER OR TAP A SWATCH FOR NAME, SHARE AND HEX. SAMPLED FROM THE IMAGE — INDICATIVE, NOT A PIGMENT ANALYSIS.")
			</div>
		} else {
			<p class="mt-2 text-sm leading-relaxed text-base-content/70">Not recorded.</p>
		}
	</div>
}

// artworkRelatedBlock renders the four related-work basis links, the active
// basis connection heading, up to four related cards, and the honest sparse
// explanation and alternative link. It is omitted when no basis state exists.
templ artworkRelatedBlock(aw dto.Artwork) {
	if len(aw.Related.Bases) > 0 {
		<section class="mt-14 border-t border-base-content/15 pt-5" aria-labelledby="related-works-heading">
			<div class="mb-5 flex flex-wrap items-baseline justify-between gap-4">
				<h2 id="related-works-heading" class="font-mono text-[11px] tracking-[1.5px]">{ aw.Related.Connection }</h2>
				<nav class="flex flex-wrap gap-1.5" aria-label="Related works basis">
					for _, basis := range aw.Related.Bases {
						if basis.Active {
							<a href={ templ.SafeURL(basis.URL) } hx-get={ basis.URL } hx-target={ aw.HxTarget } class="border border-primary bg-primary px-3.5 py-1.5 font-mono text-(length:--t-11) tracking-[1px] text-primary-content" aria-current="page">{ basis.Label }</a>
						} else {
							<a href={ templ.SafeURL(basis.URL) } hx-get={ basis.URL } hx-target={ aw.HxTarget } class="border border-control px-3.5 py-1.5 font-mono text-(length:--t-11) tracking-[1px] text-base-content/70 transition-colors hover:border-base-content">{ basis.Label }</a>
						}
					}
				</nav>
			</div>
			if len(aw.RelatedWorks) > 0 {
				@artworkRelatedWorkGrid(aw.RelatedWorks)
			}
			if aw.Related.Sparse {
				<div class="mt-6 border-t border-base-content/15 pt-4">
					<p class="max-w-[620px] text-sm leading-relaxed text-base-content/70">{ aw.Related.SparseNote }</p>
					if aw.Related.AlternativeURL != "" {
						<a href={ templ.SafeURL(aw.Related.AlternativeURL) } hx-get={ aw.Related.AlternativeURL } hx-target={ aw.HxTarget } class="mt-3 inline-block font-mono text-[11px] tracking-[1px] text-primary transition-opacity hover:opacity-60">TRY { aw.Related.Alternative } →</a>
					}
				</div>
			}
			if aw.Related.Holding != nil {
				<a href={ templ.SafeURL(aw.Related.Holding.URL) } hx-get={ aw.Related.Holding.URL } hx-target={ aw.HxTarget } class="mt-6 inline-block font-mono text-[11px] tracking-[1px] text-primary transition-opacity hover:opacity-60">{ aw.Related.Holding.Label }</a>
			}
		</section>
	}
}

templ artworkRelatedWorkGrid(works dto.ImageGrid) {
	<ul class="grid grid-cols-2 gap-x-4 gap-y-9 md:grid-cols-3 md:gap-x-7 lg:grid-cols-4">
		for _, work := range works {
			<li>
				<a href={ templ.SafeURL(work.Url) } class="block transition-opacity hover:opacity-70">
					@components.Plate(dto.Plate{DisplayURL: work.Image, Alt: work.Title, Placeholder: work.Title, Aspect: "aspect-[4/5] mb-2.5"})
					<span class="block text-sm font-semibold leading-tight">{ work.Title }</span>
					if work.Metadata != "" {
						<span class="mt-[3px] block font-mono text-[11px] leading-relaxed text-base-content/60">{ work.Metadata }</span>
					}
				</a>
			</li>
		}
	</ul>
}

// reproRule is one labelled reproduction-metadata cell inside the artwork
// figcaption's definition list.
templ reproRule(label string, value string) {
	<div>
		<dt class="mb-1.5 font-mono text-(length:--t-10) tracking-[1.5px] text-muted">{ label }</dt>
		<dd class="text-sm leading-snug">{ value }</dd>
	</div>
}
