package pages

import (
	"github.com/blackfyre/wga/internal/assets/templ/components"
	"github.com/blackfyre/wga/internal/assets/templ/dto"
	"github.com/blackfyre/wga/internal/assets/templ/layouts"
	"github.com/blackfyre/wga/internal/assets/templ/utils"
)

templ InspirePage(c dto.ImageGrid) {
	@layouts.LayoutMain() {
		@InspirationContent(c)
	}
}

templ InspirationContent(c dto.ImageGrid) {
	<head>
		<title>{ utils.GetTitle(ctx) }</title>
	</head>
	<section class="container mx-auto px-4 pb-20 pt-10 md:px-0">
		<div class="border-b border-base-content pb-8 md:grid md:grid-cols-[minmax(0,1fr)_260px] md:gap-12">
			<div>
				<p class="font-mono text-[11px] tracking-[2px] text-base-content/60">DISCOVER / RANDOM SELECTION</p>
				<h1 class="mt-3 text-[36px] font-semibold tracking-[-0.75px] md:text-[52px]">Random inspiration</h1>
			</div>
			<p class="mt-5 text-[16px] leading-relaxed text-base-content/70 md:mt-8">A changing selection from the collection. Refresh for a new route through the archive.</p>
		</div>
		<section class="pt-10" aria-label="Random artworks">
			@components.PublicArtworkGrid(c)
		</section>
	</section>
}
