package pages

import "github.com/blackfyre/wga/internal/assets/templ/layouts"

// ItineraryAddConfirmPage repeats an addition submitted without a synchroniser
// token, which a no-JavaScript visitor sends from a shared-cached page. The
// page is uncached and carries the session's token.
templ ItineraryAddConfirmPage(artworkID string, csrf string) {
	@layouts.LayoutMain() {
		<section id="itinerary-add-confirm" class="container mx-auto px-4 pb-20 md:px-0 wga-enter">
			<p class="mb-3 font-mono text-(length:--t-11) tracking-[2px] text-wga-ink/60">— ITINERARY</p>
			<h1 class="mb-3 text-(length:--t-32) font-semibold leading-tight tracking-[-0.5px] md:text-(length:--t-44)">Add this work?</h1>
			<p class="mb-8 max-w-[520px] text-base leading-relaxed text-wga-ink/70">Confirm to add the work to your itinerary draft.</p>
			<form method="post" action="/itineraries/draft/add" class="flex flex-col gap-2 md:flex-row">
				<input type="hidden" name="artwork_id" value={ artworkID }/>
				<input type="hidden" name="_csrf" value={ csrf }/>
				<button type="submit" class="wga-button wga-button-primary font-mono text-(length:--t-11) tracking-[1.5px]">ADD TO ITINERARY +</button>
				<a href="/itineraries/new" class="wga-button font-mono text-(length:--t-11) tracking-[1.5px]">VIEW ITINERARY</a>
			</form>
		</section>
	}
}
