package pages

import (
	"github.com/blackfyre/wga/internal/assets/templ/layouts"
	"github.com/blackfyre/wga/internal/assets/templ/utils"
)

type StatisticsArtFormRow struct {
	Name  string
	Count int
}

type StatisticsSchoolPeriodRow struct {
	Period string
	School string
	Count  int
}

type StatisticsSchoolPeriodSummaryRow struct {
	Period   string
	Italian  int
	French   int
	Dutch    int
	Flemish  int
	German   int
	English  int
	Spanish  int
	Other    int
	Total    int
}

type StatisticsPageDTO struct {
	ArtistCount           string
	ArtworkCount          string
	ArtFormData           string
	ArtworksPeriodData    string
	ArtistsPeriodData     string
	ArtFormSummary        []StatisticsArtFormRow
	ArtworksPeriodSummary []StatisticsSchoolPeriodSummaryRow
	ArtistsPeriodSummary  []StatisticsSchoolPeriodSummaryRow
}

templ StatisticsPage(c StatisticsPageDTO) {
	@layouts.LayoutMain() {
		@StatisticsBlock(c)
	}
}

templ StatisticsBlock(c StatisticsPageDTO) {
	<head>
		<title>{ utils.GetTitle(ctx) }</title>
	</head>
	<section id="statistics" class="container mx-auto px-4 pb-20 pt-12 md:px-0">
		<p class="mb-3 font-mono text-[11px] tracking-[2px] text-base-content/60">15 — STATISTICS</p>
		<h1 class="mb-3 text-[44px] font-semibold leading-[1.1] tracking-[-0.5px]">Statistics</h1>
		<p class="mb-11 max-w-[560px] leading-relaxed text-base-content/70">Published records only, grouped into fifty-year birth periods. Every chart is followed by the same figures as a table.</p>
		<div class="mb-14 flex gap-8 border-y border-base-content/15 py-[26px] md:gap-16">
			<div>
				<p class="mb-2 font-mono text-[10px] tracking-[1.5px] text-base-content/60">ARTISTS</p>
				<p class="text-[30px] font-semibold leading-[1.1] tracking-[-0.8px] md:text-[38px]">{ c.ArtistCount }</p>
			</div>
			<div>
				<p class="mb-2 font-mono text-[10px] tracking-[1.5px] text-base-content/60">ARTWORKS</p>
				<p class="text-[30px] font-semibold leading-[1.1] tracking-[-0.8px] md:text-[38px]">{ c.ArtworkCount }</p>
			</div>
		</div>
		<section class="mb-[72px]">
			<div class="flex flex-wrap items-baseline justify-between gap-4 border-b border-base-content pb-3">
				<h2 class="text-xl font-semibold">Art form distribution</h2>
				<p class="font-mono text-[10px] tracking-[1px] text-base-content/60">ARTWORKS BY FORM</p>
			</div>
			<div class="mt-8 flex flex-col items-start gap-9 md:flex-row md:gap-14">
				<div class="w-[210px] shrink-0 self-center md:w-[240px] md:self-start">
					<canvas id="art-form-chart" role="img" aria-label="Art form distribution chart" aria-describedby="art-form-summary"></canvas>
				</div>
				<div class="min-w-0 flex-1">
					@artFormSummary(c.ArtFormSummary)
				</div>
			</div>
		</section>
		<section class="mb-[72px]">
			<div class="flex flex-wrap items-baseline justify-between gap-4 border-b border-base-content pb-3">
				<h2 class="text-xl font-semibold">Artworks by school &amp; period</h2>
				<p class="font-mono text-[10px] tracking-[1px] text-base-content/60">STACKED BY SCHOOL · BIRTH PERIOD</p>
			</div>
			<canvas id="artworks-by-period-chart" class="mt-8" role="img" aria-label="Artworks by school and period chart" aria-describedby="artworks-period-summary"></canvas>
			@schoolPeriodSummary("artworks-period-summary", "Artworks by school and birth period data", c.ArtworksPeriodSummary)
		</section>
		<section>
			<div class="flex flex-wrap items-baseline justify-between gap-4 border-b border-base-content pb-3">
				<h2 class="text-xl font-semibold">Artists by school &amp; period</h2>
				<p class="font-mono text-[10px] tracking-[1px] text-base-content/60">STACKED BY SCHOOL · BIRTH PERIOD</p>
			</div>
			<canvas id="artists-by-period-chart" class="mt-8" role="img" aria-label="Artists by school and period chart" aria-describedby="artists-period-summary"></canvas>
			@schoolPeriodSummary("artists-period-summary", "Artists by school and birth period data", c.ArtistsPeriodSummary)
		</section>
		<div id="art-form-data" hidden data-json={ c.ArtFormData }></div>
		<div id="artworks-period-data" hidden data-json={ c.ArtworksPeriodData }></div>
		<div id="artists-period-data" hidden data-json={ c.ArtistsPeriodData }></div>
	</section>
}

templ artFormSummary(rows []StatisticsArtFormRow) {
	<div id="art-form-summary" class="overflow-x-auto">
		<table class="w-full text-sm">
			<caption class="sr-only">Art form distribution data</caption>
			<thead class="border-y border-base-content/15 font-mono text-[10px] tracking-[1px] text-base-content/60">
				<tr>
					<th scope="col" class="py-3 text-left font-normal">ART FORM</th>
					<th scope="col" class="py-3 text-right font-normal">ARTWORKS</th>
				</tr>
			</thead>
			<tbody>
				for _, row := range rows {
					<tr class="border-b border-base-content/15">
						<th scope="row" class="art-form-label py-3 text-left font-normal">{ row.Name }</th>
						<td class="py-3 text-right font-mono text-[11px]">{ row.Count }</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}

templ schoolPeriodSummary(id string, caption string, rows []StatisticsSchoolPeriodSummaryRow) {
	<div id={ id } class="overflow-x-auto">
		<table class="min-w-full text-sm">
			<caption class="caption-top pb-3 text-left font-mono text-[10px] tracking-[1px] text-base-content/60">{ caption }</caption>
			<thead class="border-y border-base-content/15 font-mono text-[10px] tracking-[1px] text-base-content/60">
				<tr>
					<th scope="col" class="py-3 text-left font-normal">BIRTH PERIOD</th>
					<th scope="col" class="py-3 text-right font-normal">IT</th>
					<th scope="col" class="py-3 text-right font-normal">FR</th>
					<th scope="col" class="py-3 text-right font-normal">NL</th>
					<th scope="col" class="py-3 text-right font-normal">FL</th>
					<th scope="col" class="py-3 text-right font-normal">DE</th>
					<th scope="col" class="py-3 text-right font-normal">EN</th>
					<th scope="col" class="py-3 text-right font-normal">ES</th>
					<th scope="col" class="py-3 text-right font-normal">OTH</th>
					<th scope="col" class="py-3 text-right font-normal">TOTAL</th>
				</tr>
			</thead>
			<tbody>
				for _, row := range rows {
					<tr class="border-b border-base-content/15">
						<th scope="row" class="py-3 text-left font-mono text-[11px] font-normal">{ row.Period }</th>
						<td class="py-3 text-right font-mono text-[11px]">{ row.Italian }</td>
						<td class="py-3 text-right font-mono text-[11px]">{ row.French }</td>
						<td class="py-3 text-right font-mono text-[11px]">{ row.Dutch }</td>
						<td class="py-3 text-right font-mono text-[11px]">{ row.Flemish }</td>
						<td class="py-3 text-right font-mono text-[11px]">{ row.German }</td>
						<td class="py-3 text-right font-mono text-[11px]">{ row.English }</td>
						<td class="py-3 text-right font-mono text-[11px]">{ row.Spanish }</td>
						<td class="py-3 text-right font-mono text-[11px]">{ row.Other }</td>
						<td class="py-3 text-right font-mono text-[11px]">{ row.Total }</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}
