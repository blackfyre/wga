package pages

import (
	"fmt"
	"github.com/blackfyre/wga/internal/assets/templ/components"
	"github.com/blackfyre/wga/internal/assets/templ/layouts"
)

type ContributorsPageDTO struct {
	Contributors []GithubContributor
}

type GithubContributor struct {
	Login             string `json:"login"`
	ID                int    `json:"id"`
	NodeID            string `json:"node_id"`
	AvatarURL         string `json:"avatar_url"`
	GravatarID        string `json:"gravatar_id"`
	URL               string `json:"url"`
	HTMLURL           string `json:"html_url"`
	FollowersURL      string `json:"followers_url"`
	FollowingURL      string `json:"following_url"`
	GistsURL          string `json:"gists_url"`
	StarredURL        string `json:"starred_url"`
	SubscriptionsURL  string `json:"subscriptions_url"`
	OrganizationsURL  string `json:"organizations_url"`
	ReposURL          string `json:"repos_url"`
	EventsURL         string `json:"events_url"`
	ReceivedEventsURL string `json:"received_events_url"`
	Type              string `json:"type"`
	SiteAdmin         bool   `json:"site_admin"`
	Contributions     int    `json:"contributions"`
}

templ ContributorsPage(c ContributorsPageDTO) {
	@layouts.LayoutMain() {
		@ContributorsBlock(c)
	}
}

templ Contributor(contributor GithubContributor) {
	<li class="flex items-center gap-3 border-b border-base-content/15 py-4">
		if contributor.AvatarURL != "" {
			<img class="h-10 w-10 shrink-0 border border-base-content/15 object-cover" src={ contributor.AvatarURL } alt="" />
		}
		<div class="min-w-0 flex-1">
			if contributor.HTMLURL != "" {
				<a href={ contributor.HTMLURL } class="no-external-link-marker font-mono text-(length:--t-13) hover:text-primary transition-colors">
					{ contributor.Login }
				</a>
			} else {
				<span class="font-mono text-(length:--t-13)">{ contributor.Login }</span>
			}
			<p class="mt-1 font-mono text-(length:--t-10) tracking-[0.5px] text-muted">{ fmt.Sprintf("%d commits", contributor.Contributions) }</p>
		</div>
	</li>
}

templ ContributorsBlock(c ContributorsPageDTO) {
	<section class="container mx-auto px-4 pb-20 pt-10 md:px-0">
		@components.PageHead("11 — CONTRIBUTORS", "Contributors", "The people who have contributed to the Web Gallery of Art.")
		<article>
			<div class="flex items-baseline justify-between border-b border-base-content pb-3">
				<h2 class="font-mono text-(length:--t-11) tracking-[1.5px]">CODE CONTRIBUTORS</h2>
				<p class="font-mono text-(length:--t-10) tracking-[1px] text-muted">{ fmt.Sprintf("%d PEOPLE", len(c.Contributors)) }</p>
			</div>
			<ul role="list" class="grid md:grid-cols-3 md:gap-x-8">
				for _, contributor := range c.Contributors {
					@Contributor(contributor)
				}
			</ul>
		</article>
	</section>
}
