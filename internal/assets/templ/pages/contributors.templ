package pages

import (
	"fmt"
	"github.com/blackfyre/wga/internal/assets/templ/layouts"
)

type ContributorsPageDTO struct {
	Contributors []GithubContributor
}

type GithubContributor struct {
	Login             string `json:"login"`
	ID                int    `json:"id"`
	NodeID            string `json:"node_id"`
	AvatarURL         string `json:"avatar_url"`
	GravatarID        string `json:"gravatar_id"`
	URL               string `json:"url"`
	HTMLURL           string `json:"html_url"`
	FollowersURL      string `json:"followers_url"`
	FollowingURL      string `json:"following_url"`
	GistsURL          string `json:"gists_url"`
	StarredURL        string `json:"starred_url"`
	SubscriptionsURL  string `json:"subscriptions_url"`
	OrganizationsURL  string `json:"organizations_url"`
	ReposURL          string `json:"repos_url"`
	EventsURL         string `json:"events_url"`
	ReceivedEventsURL string `json:"received_events_url"`
	Type              string `json:"type"`
	SiteAdmin         bool   `json:"site_admin"`
	Contributions     int    `json:"contributions"`
}

templ ContributorsPage(c ContributorsPageDTO) {
	@layouts.LayoutMain() {
		@ContributorsBlock(c)
	}
}

templ Contributor(contributor GithubContributor) {
	<li class="flex items-center gap-3 border-b border-base-content/15 py-4">
		<img class="h-10 w-10 border border-base-content/15 object-cover" src={ contributor.AvatarURL } alt={ contributor.Login }/>
		<div class="min-w-0 flex-1">
			<h3 class="font-mono text-[13px]">{ "@" + contributor.Login }</h3>
			<p class="mt-1 font-mono text-[10px] tracking-[0.5px] text-base-content/60">{ fmt.Sprintf("%d commits", contributor.Contributions) }</p>
		</div>
		<ul role="list" class="flex gap-x-3">
			<li>
				<a class="has-sm-icon" href={ templ.SafeURL(contributor.HTMLURL) } rel="noopener" target="_blank" class="text-base-content/60 hover:text-base-content/80">
					<span class="sr-only">Github</span>
					<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" aria-hidden="true" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"></path></svg>
				</a>
			</li>
		</ul>
	</li>
}

templ ContributorsBlock(c ContributorsPageDTO) {
	<section class="container mx-auto px-4 pb-20 pt-10 md:px-0">
		<p class="mb-3 font-mono text-[11px] tracking-[2px] text-base-content/60">11 — CONTRIBUTORS</p>
		<h1 class="text-[44px] font-semibold tracking-[-0.5px]">Contributors</h1>
		<p class="mt-3 max-w-[560px] leading-relaxed text-base-content/70">The archive was created by Emil Krén and Daniel Marx and has been maintained in the open since. Version 2 is made possible by the people below.</p>
		<article class="mt-12">
			<div class="flex items-baseline justify-between border-b border-base-content pb-3">
				<h2 class="font-mono text-[11px] tracking-[1.5px]">CODE CONTRIBUTORS</h2>
				<p class="font-mono text-[10px] tracking-[1px] text-base-content/60">{ fmt.Sprintf("%d PEOPLE", len(c.Contributors)) }</p>
			</div>
			<ul role="list" class="grid md:grid-cols-3 md:gap-x-8">
				for _, contributor := range c.Contributors {
					@Contributor(contributor)
				}
			</ul>
		</article>
		<article class="mt-14 flex flex-col gap-10 border-t border-base-content/15 pt-5 md:flex-row md:justify-between">
			<div>
				<h2 class="font-mono text-[11px] tracking-[1.5px]">SUPPORT THE PROJECT</h2>
				<p class="mt-3 text-[22px] font-semibold">Open source, no advertising.</p>
				<p class="mt-2 max-w-[440px] leading-relaxed text-base-content/70">Contributions of code, corrections and commentary keep the archive available.</p>
				<a class="mt-4 inline-block bg-primary px-5 py-3.5 font-mono text-[11px] tracking-[1px] text-primary-content hover:opacity-85" href="https://github.com/sponsors/blackfyre">SPONSOR ON GITHUB →</a>
			</div>
			<dl class="w-full border-t border-base-content/15 font-mono text-[11px] md:w-[300px]">
				<div class="flex justify-between gap-4 border-b border-base-content/15 py-3"><dt class="tracking-[1px] text-base-content/60">REPOSITORY</dt><dd>blackfyre/wga</dd></div>
				<div class="flex justify-between gap-4 border-b border-base-content/15 py-3"><dt class="tracking-[1px] text-base-content/60">LICENCE</dt><dd>Apache 2.0</dd></div>
				<div class="flex justify-between gap-4 border-b border-base-content/15 py-3"><dt class="tracking-[1px] text-base-content/60">STACK</dt><dd>Go · HTMX · Tailwind</dd></div>
			</dl>
		</article>
	</section>
}
