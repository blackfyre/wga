package pages

import (
	"github.com/blackfyre/wga/internal/assets/templ/layouts"
	"github.com/blackfyre/wga/internal/assets/templ/utils"
)

type HomePage struct {
	Content      string
	ArtistCount  string
	ArtworkCount string
}

templ HomePageWrapped(c HomePage) {
	@layouts.LayoutMain() {
		@HomePageContent(c)
	}
}

templ HomePageContent(c HomePage) {
	<head>
		<title>{ utils.GetTitle(ctx) }</title>
	</head>
	<section class="homepage">
		<section class="homepage__hero">
			<div class="homepage__hero-content">
				<p class="homepage__eyebrow">Digital archive of European art</p>
				<h1>Discover human creativity.</h1>
				<form action="/artworks" method="get" class="homepage__search">
					<label for="homepage-search">Search the collection</label>
					<input id="homepage-search" name="title" type="search" placeholder="Search artworks by title..."/>
					<button type="submit">Search</button>
				</form>
				<p class="homepage__search-note">Search artworks, then refine by artist, school, form, or type.</p>
			</div>
		</section>

		<section class="homepage__entries" aria-label="Explore the collection">
			<a href="/artworks" hx-get="/artworks" class="homepage__entry">
				<span>01</span>
				<h2>Artworks</h2>
				<p>Browse paintings, sculpture, decorative arts, and architecture.</p>
				<strong aria-hidden="true">→</strong>
			</a>
			<a href="/artists" hx-get="/artists" class="homepage__entry">
				<span>02</span>
				<h2>Artists</h2>
				<p>Find biographies, schools, and related works through the A–Z index.</p>
				<strong aria-hidden="true">→</strong>
			</a>
			<a href="/inspire" hx-get="/inspire" class="homepage__entry">
				<span>03</span>
				<h2>Inspiration</h2>
				<p>Let the collection choose a starting point for your exploration.</p>
				<strong aria-hidden="true">→</strong>
			</a>
		</section>

		<section class="homepage__feature">
			<div class="homepage__image-well">
				<img src="/assets/images/smo_cover_1080x1080.png" alt="A visitor viewing an imagined gallery of artworks"/>
			</div>
			<div class="homepage__feature-copy">
				<p class="homepage__eyebrow">Begin anywhere</p>
				<h2>Explore without a fixed destination.</h2>
				<p>Inspiration offers a changing selection from the collection when a name, date, or school is not yet known.</p>
				<a href="/inspire" hx-get="/inspire" class="homepage__button">Open inspiration</a>
			</div>
		</section>

		<section class="homepage__about">
			<article class="homepage__welcome">
				<p class="homepage__eyebrow">Our mission</p>
				<div class="homepage__prose">
					@templ.Raw(c.Content)
				</div>
			</article>
			<dl class="homepage__statistics">
				<div>
					<dt>Published artworks</dt>
					<dd>{ c.ArtworkCount }</dd>
				</div>
				<div>
					<dt>Published artists</dt>
					<dd>{ c.ArtistCount }</dd>
				</div>
				<div>
					<dt>Established</dt>
					<dd>1992</dd>
				</div>
			</dl>
		</section>
	</section>
}
