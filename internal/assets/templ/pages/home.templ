package pages

import (
	"github.com/blackfyre/wga/internal/assets/templ/layouts"
	"github.com/blackfyre/wga/internal/assets/templ/utils"
)

type HomePage struct {
	Content         string
	ArtistCount     string
	ArtworkCount    string
	FeaturedArtwork HomeFeaturedArtwork
}

type HomeFeaturedArtwork struct {
	Title  string
	Artist string
	URL    string
	Image  string
}

templ HomePageWrapped(c HomePage) {
	@layouts.LayoutMain() {
		@HomePageContent(c)
	}
}

templ HomePageContent(c HomePage) {
	<head>
		<title>{ utils.GetTitle(ctx) }</title>
	</head>
	<section class="home-page">
		<section class="container mx-auto px-4 pb-18 pt-10 md:px-0 md:pt-12">
			<div class="flex flex-col gap-10 lg:flex-row lg:items-end lg:justify-between lg:gap-16">
				<div class="lg:flex-1">
					<p class="mb-4 font-mono text-[11px] tracking-[2px] text-base-content/60">00 — PROVIDING EXPERIENCE SINCE 1992</p>
					<h1 class="text-[38px] font-semibold leading-[1.08] tracking-[-1px] md:text-[56px]">Explore artists and artworks<br/>without losing the thread.</h1>
					<p class="mt-5 max-w-xl text-[17px] leading-relaxed text-base-content/70 md:min-h-[81px]">Paintings, sculpture and architecture from the 3rd century to the early 20th, with biographies, commentaries and side-by-side comparison.</p>
					<div class="mt-8 flex flex-wrap gap-3">
						<a href="/artists" hx-get="/artists" class="bg-primary px-5 py-3.5 font-mono text-[11px] tracking-[1.5px] text-primary-content">BROWSE ARTISTS →</a>
						<a href="/dual-mode" hx-get="/dual-mode" class="border border-base-content/30 px-5 py-3.5 font-mono text-[11px] tracking-[1.5px]">COMPARE TWO WORKS →</a>
					</div>
				</div>
				if c.FeaturedArtwork.URL != "" {
					<a href={ templ.URL(c.FeaturedArtwork.URL) } hx-get={ c.FeaturedArtwork.URL } class="block w-full max-w-[300px]">
						<figure class="flex aspect-[39/44.5] items-end border border-base-content/15 bg-base-300 p-3">
							if c.FeaturedArtwork.Image != "" {
								<img src={ c.FeaturedArtwork.Image } alt={ c.FeaturedArtwork.Title } class="h-full w-full object-cover"/>
							} else {
								<figcaption class="font-mono text-[9px] tracking-[1px] text-base-content/40">IMAGE — WORK OF THE DAY</figcaption>
							}
						</figure>
						<p class="mt-3 text-[15px] font-semibold">{ c.FeaturedArtwork.Title }</p>
						<p class="mt-1 font-mono text-[11px] text-primary">{ c.FeaturedArtwork.Artist } →</p>
					</a>
				}
			</div>
		</section>
		<section class="container mx-auto grid grid-cols-2 gap-6 border-y border-base-content/15 px-4 py-7 md:grid-cols-4 md:px-0 md:gap-8">
			<div><p class="text-[26px] font-semibold">{ c.ArtworkCount }</p><p class="mt-1 font-mono text-[10px] tracking-[1.5px] text-base-content/60">REPRODUCTIONS</p></div>
			<div><p class="text-[26px] font-semibold">{ c.ArtistCount }</p><p class="mt-1 font-mono text-[10px] tracking-[1.5px] text-base-content/60">ARTISTS</p></div>
			<div><p class="text-[26px] font-semibold">3RD–20TH</p><p class="mt-1 font-mono text-[10px] tracking-[1.5px] text-base-content/60">CENTURIES</p></div>
			<div><p class="text-[26px] font-semibold">1992</p><p class="mt-1 font-mono text-[10px] tracking-[1.5px] text-base-content/60">ESTABLISHED</p></div>
		</section>
		<section class="container mx-auto px-4 py-12 md:px-0">
			<div class="flex items-baseline justify-between border-b border-base-content pb-3">
				<h2 class="font-mono text-[11px] tracking-[1.5px]">EXPLORE THE COLLECTION</h2>
				<a href="/artworks" hx-get="/artworks" class="font-mono text-[11px] tracking-[1px] text-primary">ALL WORKS →</a>
			</div>
			<div class="grid gap-6 pt-7 md:grid-cols-3">
				<a href="/artists" hx-get="/artists" class="border-t border-base-content/15 pt-4"><p class="font-mono text-[10px] tracking-[1.5px] text-base-content/60">PEOPLE</p><h3 class="mt-3 text-xl font-semibold">Browse artists</h3><p class="mt-2 leading-relaxed text-base-content/70">Move through biographies, schools and related works.</p></a>
				<a href="/artworks" hx-get="/artworks" class="border-t border-base-content/15 pt-4"><p class="font-mono text-[10px] tracking-[1.5px] text-base-content/60">SEARCH</p><h3 class="mt-3 text-xl font-semibold">Find artworks</h3><p class="mt-2 leading-relaxed text-base-content/70">Filter the collection by title, artist, form, type and school.</p></a>
				<a href="/inspire" hx-get="/inspire" class="border-t border-base-content/15 pt-4"><p class="font-mono text-[10px] tracking-[1.5px] text-base-content/60">DISCOVER</p><h3 class="mt-3 text-xl font-semibold">Find inspiration</h3><p class="mt-2 leading-relaxed text-base-content/70">Take an unexpected route through the archive.</p></a>
			</div>
		</section>
		<section class="container mx-auto grid gap-10 px-4 pb-16 md:grid-cols-[1.2fr_1fr] md:px-0">
			<div class="content max-w-none border-t border-base-content/15 pt-5">@templ.Raw(c.Content)</div>
			<div class="grid gap-8 md:grid-cols-2">
				<div class="border-t border-base-content/15 pt-5"><p class="font-mono text-[10px] tracking-[1.5px] text-base-content/60">SIDE BY SIDE</p><h3 class="mt-3 text-xl font-semibold">Compare two works</h3><p class="mt-2 leading-relaxed text-base-content/70">Keep two records open at once and follow links into the selected pane.</p><a href="/dual-mode" hx-get="/dual-mode" class="mt-4 inline-block font-mono text-[11px] tracking-[1px] text-primary">OPEN DUAL MODE →</a></div>
				<div class="border-t border-base-content/15 pt-5"><p class="font-mono text-[10px] tracking-[1.5px] text-base-content/60">COMMUNITY</p><h3 class="mt-3 text-xl font-semibold">Help sustain the archive</h3><p class="mt-2 leading-relaxed text-base-content/70">Contributions, corrections and comments help keep the collection useful.</p><a href="/contributors" hx-get="/contributors" class="mt-4 inline-block font-mono text-[11px] tracking-[1px] text-primary">MEET CONTRIBUTORS →</a></div>
			</div>
		</section>
	</section>
}
