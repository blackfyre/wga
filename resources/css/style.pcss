@charset "UTF-8";
@import "tailwindcss";

@import "animate.css";
@import "../../node_modules/trix/dist/trix.css";
@import "../../node_modules/vanilla-cookieconsent/dist/cookieconsent.css";
@import "../../node_modules/viewerjs/dist/viewer.css";
@source "../../internal/assets/templ";
@source "../../resources/js";
@plugin "@tailwindcss/typography";
@plugin "daisyui";

.artwork-year-range {
	position: relative;
	height: 20px;
}

.wga-range {
	-webkit-appearance: none;
	appearance: none;
	background: transparent;
	pointer-events: none;
	position: absolute;
	inset: 0;
	width: 100%;
	height: 20px;
	margin: 0;
}

.wga-range::-webkit-slider-runnable-track { background: transparent; border: none; height: 20px; }
.wga-range::-moz-range-track { background: transparent; border: none; height: 20px; }
.wga-range::-webkit-slider-thumb {
	-webkit-appearance: none;
	pointer-events: auto;
	width: 14px;
	height: 20px;
	border: 1px solid var(--color-base-content);
	background: var(--color-base-100);
	cursor: ew-resize;
}
.wga-range::-moz-range-thumb {
	pointer-events: auto;
	width: 14px;
	height: 20px;
	border-radius: 0;
	border: 1px solid var(--color-base-content);
	background: var(--color-base-100);
	cursor: ew-resize;
}
.wga-range-brush { height: 44px; }
.wga-range-brush::-webkit-slider-runnable-track { height: 44px; }
.wga-range-brush::-moz-range-track { height: 44px; }
.wga-range-brush::-webkit-slider-thumb {
	width: 11px;
	height: 44px;
	border: none;
	background: var(--color-primary);
}
.wga-range-brush::-moz-range-thumb {
	width: 11px;
	height: 44px;
	border: none;
	background: var(--color-primary);
}

/* Dual mode: two independent windows on a vertically divided screen. The mode
   is full-viewport and desktop-only — below 1080px the notice replaces it,
   which is a media query rather than a device test, so a narrow desktop window
   gets the same honest answer as a tablet. */
.wga-dual {
	position: fixed;
	inset: 0;
	z-index: 60;
	display: flex;
	flex-direction: column;
	background: var(--color-base-100);
	overflow: hidden;
}

.wga-dual-bar {
	display: none;
	align-items: center;
	justify-content: space-between;
	gap: 24px;
	flex-shrink: 0;
	padding: 11px 22px;
	border-bottom: 1px solid var(--color-base-content);
}

.wga-dual-split {
	display: none;
}

.wga-dual-narrow {
	display: flex;
	flex: 1;
	align-items: center;
	justify-content: center;
	padding: 40px;
}

/* A pane is half the window, so the window's media query is the wrong one to
   lay it out with: at the 1080px gate each pane is ~540px — SM by the site's
   own definition — and the override can open panes narrower still. The pane is
   a container so its contents can ask about the pane instead. */
.wga-dual-pane {
	container-type: inline-size;
	container-name: pane;
	flex: 1;
	min-width: 0;
	display: flex;
	flex-direction: column;
}

.wga-dual-pane + .wga-dual-pane {
	border-left: 1px solid var(--color-base-content);
}

/* Pane-tier layout. Mirrors the single-window SM rules, keyed on the pane. */
@container pane (max-width: 719px) {
	.wga-pane-split { flex-direction: column; gap: 30px; }
	.wga-pane-aside { width: 100%; }
	.wga-pane-grid-4 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
	.wga-pane-grid-3 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}

/* Each window scrolls on its own — that independence is the whole feature. */
.wga-dual-body {
	flex: 1;
	min-height: 0;
	overflow-y: auto;
	overflow-x: hidden;
	padding: 22px 28px 60px;
}

@media (min-width: 1080px) {
	.wga-dual-bar { display: flex; }
	.wga-dual-split { display: flex; flex: 1; min-height: 0; }
	.wga-dual-narrow { display: none; }
}

/* The query measures CSS pixels, so browser zoom reads as a small screen: a wide
   display at 200% reports a tablet's width and the notice appears. `?wide=1` is
   the visitor overruling a measurement that cannot tell large type from a small
   display. */
.wga-dual[data-wide] .wga-dual-bar { display: flex; }
.wga-dual[data-wide] .wga-dual-split { display: flex; flex: 1; min-height: 0; }
.wga-dual[data-wide] .wga-dual-narrow { display: none; }

.wga-kbd-bar {
	position: fixed;
	right: 0;
	bottom: 0;
	left: 0;
	z-index: 52;
	display: none;
	height: 30px;
	align-items: center;
	gap: 14px;
	overflow-x: auto;
	padding: 0 16px;
	border-top: 1px solid color-mix(in oklab, var(--color-base-content) 14%, transparent);
	background: var(--color-base-100);
	scrollbar-width: none;
}

.wga-kbd-bar::-webkit-scrollbar {
	display: none;
}

@media (hover: hover) and (pointer: fine) {
	html[data-kbd-on] .wga-kbd-bar {
		display: flex;
	}
}

.wga-kbd-key {
	padding: 4px 6px;
	border: 1px solid color-mix(in oklab, var(--color-base-content) 25%, transparent);
	font-family: ui-monospace, "SF Mono", Menlo, monospace;
	font-size: 9.5px;
	letter-spacing: 1px;
	line-height: 1;
	white-space: nowrap;
}

.wga-kbd-caret {
	position: absolute;
	top: 11px;
	left: -18px;
	color: var(--color-primary);
	font-family: ui-monospace, "SF Mono", Menlo, monospace;
	font-size: 12px;
	opacity: 0;
	pointer-events: none;
	transition: opacity 0.12s ease;
	user-select: none;
}

[data-kbd-idx] {
	position: relative;
}

[data-kbd-caret] > .wga-kbd-caret {
	opacity: 1;
}

[data-kbd-cols]:not([data-kbd-cols="1"]) .wga-kbd-caret {
	top: -2px;
	left: -15px;
}

.wga-kbd-dialog {
	max-width: none;
	max-height: none;
	padding: 0;
	border: 0;
	background: transparent;
}

.wga-kbd-dialog::backdrop {
	background: color-mix(in oklab, var(--color-base-content) 32%, transparent);
}

/* Preferences follows the reference as a full-height sheet: edge-to-edge on a
 * phone, and a 400px panel from the right on wider screens. Its header remains
 * sticky within the panel's own scrollport. */
.wga-preferences {
	inset: 0 0 0 auto;
	width: 100vw;
	max-width: 100vw;
	height: 100dvh;
	max-height: 100dvh;
	margin: 0;
	overflow-y: auto;
	overscroll-behavior: contain;
	border: 0;
}

@media (min-width: 45rem) {
	.wga-preferences {
		width: 400px;
		border-left: 1px solid var(--color-base-content);
	}
}

.wga-kbd-palette,
.wga-kbd-help {
	border: 1px solid var(--color-base-content);
	background: var(--color-base-100);
}

.wga-kbd-palette {
	width: min(620px, calc(100vw - 32px));
	margin: 10vh auto auto;
}

.wga-kbd-help {
	width: min(760px, calc(100vw - 32px));
	margin: 8vh auto auto;
	padding: 28px;
}

@media (min-width: 768px) {
	.wga-kbd-dialog[open] {
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100vw;
		height: 100vh;
		margin: 0;
	}

	.wga-kbd-palette,
	.wga-kbd-help {
		margin: 0;
	}
}

.wga-kbd-row {
	display: flex;
	align-items: center;
	gap: 14px;
	padding: 11px 18px;
	border-bottom: 1px solid color-mix(in oklab, var(--color-base-content) 10%, transparent);
}

.wga-kbd-row:hover,
.wga-kbd-row[data-kbd-pick] {
	background: color-mix(in oklab, var(--color-primary) 7%, transparent);
}

.artwork-year-range-track,
.artwork-year-range-fill {
	position: absolute;
	top: 9px;
	height: 1px;
}

.artwork-year-range-track {
	left: 0;
	right: 0;
	background: color-mix(in oklab, var(--color-base-content) 30%, transparent);
}

.artwork-year-range-fill {
	left: var(--range-start, 0%);
	width: var(--range-width, 100%);
}

.artwork-year-range-input {
	position: absolute;
	inset: 0;
	width: 100%;
	margin: 0;
	appearance: none;
	background: transparent;
	pointer-events: none;
}

.artwork-year-range-input::-webkit-slider-thumb {
	width: 12px;
	height: 12px;
	appearance: none;
	border: 1px solid var(--color-base-content);
	border-radius: 9999px;
	background: var(--color-base-100);
	pointer-events: auto;
}

.artwork-year-range-input::-moz-range-thumb {
	width: 10px;
	height: 10px;
	border: 1px solid var(--color-base-content);
	border-radius: 9999px;
	background: var(--color-base-100);
	pointer-events: auto;
}

@theme {
	--font-sans: -apple-system, "Helvetica Neue", Arial, sans-serif;
	--font-mono: ui-monospace, "SF Mono", Menlo, monospace;
	--breakpoint-md: 45rem;
	--breakpoint-lg: 67.5rem;
}

@plugin "daisyui/theme" {
  name: "wga_light";
  default: true;
  prefersdark: false;
  color-scheme: "light";
  --color-base-100: #f4f2ed;
  --color-base-200: #e9e6df;
  --color-base-300: #e4e0d7;
  --color-base-content: #1c1c1a;
  --color-primary: #003366;
  --color-primary-content: #f4f2ed;
  --color-secondary: #6b6660;
  --color-secondary-content: #f4f2ed;
  --color-accent: #1c1c1a;
  --color-accent-content: #f4f2ed;
  --color-neutral: #1c1c1a;
  --color-neutral-content: #f4f2ed;
  --color-info: #003366;
  --color-info-content: #f4f2ed;
  --color-success: #2e5b4a;
  --color-success-content: #f4f2ed;
  --color-warning: #8a6d1f;
  --color-warning-content: #ffffff;
  --color-error: #6b3a2e;
  --color-error-content: #f4f2ed;
  --radius-selector: 0;
  --radius-field: 0;
  --radius-box: 0;
  --size-selector: 0.25rem;
  --size-field: 0.25rem;
  --border: 1px;
  --depth: 0;
  --noise: 0;
}

@plugin "daisyui/theme" {
  name: "wga_dark";
  default: false;
  prefersdark: true;
  color-scheme: "dark";
  --color-base-100: #1a1814;
  --color-base-200: #211f1a;
  --color-base-300: #302d26;
  --color-base-content: #edeae1;
  --color-primary: #2e5a8c;
  --color-primary-content: #f1eee6;
  --color-secondary: #948e82;
  --color-secondary-content: #17160f;
  --color-accent: #948e82;
  --color-accent-content: #17160f;
  --color-neutral: #33302a;
  --color-neutral-content: #f1eee6;
  --color-info: #8fb6de;
  --color-info-content: #17160f;
  --color-success: #7fae98;
  --color-success-content: #17160f;
  --color-warning: #d8b455;
  --color-warning-content: #17160f;
  --color-error: #d08a76;
  --color-error-content: #17160f;
  --radius-selector: 0;
  --radius-field: 0;
  --radius-box: 0;
  --size-selector: 0.25rem;
  --size-field: 0.25rem;
  --border: 1px;
  --depth: 0;
  --noise: 0;
}

[data-theme="wga-rams"] {
	color-scheme: light;
}

[data-theme="wga-rams-dark"] {
	color-scheme: dark;
}

