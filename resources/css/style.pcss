    left: 38%;
    height: 12rem;
    width: 12rem;
    background: color-mix(in oklab, var(--color-accent) 42%, white);
  }
} */

.home-kicker {
  font-family: "Lexend", sans-serif;
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  /* color: color-mix(in oklab, var(--color-primary) 70%, black); */
  margin-bottom: 0.25rem;
}

.home-card {
  @apply rounded-box border border-base-300 bg-base-100 p-6 shadow-sm;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  position: relative;
  overflow: hidden;
  transition:
    transform 180ms ease,
    box-shadow 180ms ease,
    border-color 180ms ease;

  &::after {
    content: "";
    position: absolute;
    inset: auto 1.5rem 1.25rem;
    height: 2px;
    /* background: linear-gradient(90deg, var(--color-primary), transparent); */
    opacity: 0;
    transition: opacity 180ms ease;
  }

  &:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 35px color-mix(in oklab, var(--color-primary) 10%, transparent);
    border-color: color-mix(in oklab, var(--color-secondary) 45%, var(--color-base-300));
  }

  &:hover::after {
    opacity: 1;
  }
}

.home-card__eyebrow {
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--color-secondary);
}

.home-inline-card {
  @apply rounded-box border border-base-300 bg-base-100 px-4 py-3 text-base-content shadow-sm;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  transition:
    transform 160ms ease,
    border-color 160ms ease,
    background-color 160ms ease;

  & strong {
    display: block;
    font-family: "Merriweather", serif;
    font-size: 1.05rem;
    color: var(--color-primary);
  }

  & small {
    display: block;
    margin-top: 0.2rem;
    font-size: 0.82rem;
    line-height: 1.5;
    color: color-mix(in oklab, var(--color-base-content) 72%, transparent);
  }

  &:hover {
    transform: translateX(4px);
    border-color: color-mix(in oklab, var(--color-secondary) 45%, var(--color-base-300));
    background-color: color-mix(in oklab, var(--color-base-100) 82%, var(--color-secondary) 18%);
  }
}

.home-prose {
  @apply text-base leading-8 text-base-content;

  & > :first-child {
    margin-top: 0;
  }

  & > * + * {
    margin-top: 1rem;
  }

  & h1,
  & h2,
  & h3 {
    font-family: "Merriweather", serif;
    color: var(--color-primary);
  }

  & a {
    color: var(--color-primary);
    text-decoration: underline;
    text-decoration-color: color-mix(in oklab, var(--color-secondary) 60%, transparent);
    text-underline-offset: 0.15em;
  }

  & strong {
    color: var(--color-primary);
  }

  & blockquote {
    border-left: 3px solid var(--color-secondary);
    padding-left: 1rem;
    color: color-mix(in oklab, var(--color-base-content) 82%, transparent);
  }

  & ul {
    padding-left: 1.25rem;
    list-style: disc;
  }
}

figure.hidden-caption {
  & figcaption {
    display: none;
  }
}

/* Honeypot field */
.hpt {
  opacity: 0;
  position: absolute;
  top: 0;
  left: 0;
  height: 0;
  width: 0;
  z-index: -1;
}

#cc-main {
  --cc-font-family: var(--font-sans);
  --cc-modal-border-radius: 0;
  --cc-btn-border-radius: 0;
  --cc-bg: var(--color-base-100);
  --cc-primary-color: var(--color-base-content);
  --cc-secondary-color: color-mix(in srgb, var(--color-base-content) 72%, transparent);
  --cc-separator-border-color: color-mix(in srgb, var(--color-base-content) 15%, transparent);
  --cc-btn-primary-bg: var(--color-primary);
  --cc-btn-primary-color: var(--color-primary-content);
  --cc-btn-primary-border-color: var(--color-primary);
  --cc-btn-primary-hover-bg: #00264d;
  --cc-btn-primary-hover-border-color: #00264d;
  --cc-btn-secondary-bg: transparent;
  --cc-btn-secondary-color: var(--color-base-content);
  --cc-btn-secondary-border-color: color-mix(in srgb, var(--color-base-content) 30%, transparent);
  --cc-btn-secondary-hover-bg: var(--color-base-200);
  --cc-btn-secondary-hover-border-color: var(--color-base-content);
}

#cc-main .cm,
#cc-main .pm {
  border: 1px solid var(--color-base-content);
  box-shadow: none;
}

#cc-main .cm {
  max-width: 32.5rem;
}

#cc-main .cm__title,
#cc-main .pm__title {
  font-family: var(--font-mono);
  font-size: 0.6875rem;
  letter-spacing: 0.15em;
}

#cc-main .cm__desc,
#cc-main .pm__body {
  font-size: 0.9375rem;
  line-height: 1.6;
}

#cc-main .cm__btn,
#cc-main .pm__btn {
  font-family: var(--font-mono);
  font-size: 0.6875rem;
  font-weight: 400;
  letter-spacing: 0.1em;
}

/* fix for cookie consent title hover jumping */
.c-bl .title {
  margin-bottom: 0;
}

/* progress indicator */

.progress-indicator {
  position: fixed;
  top: 0;
  z-index: 1000;
  height: 4px;
  width: 100%;
  border-radius: 2px;
  background-clip: padding-box;
  overflow: hidden;
  display: none;

  & .indeterminate:before {
    content: "";
    position: absolute;
    background-color: inherit;
    top: 0;
    left: 0;
    bottom: 0;
    will-change: left, right;
    -webkit-animation: indeterminate 2.1s
      cubic-bezier(0.65, 0.815, 0.735, 0.395) infinite;
    animation: indeterminate 2.1s cubic-bezier(0.65, 0.815, 0.735, 0.395)
      infinite;
  }

  & .indeterminate:after {
    content: "";
    position: absolute;
    background-color: inherit;
    top: 0;
    left: 0;
    bottom: 0;
    will-change: left, right;
    -webkit-animation: indeterminate-short 2.1s
      cubic-bezier(0.165, 0.84, 0.44, 1) infinite;
    animation: indeterminate-short 2.1s cubic-bezier(0.165, 0.84, 0.44, 1)
      infinite;
    -webkit-animation-delay: 1.15s;
    animation-delay: 1.15s;
  }
}

.htmx-request {
  &.progress-indicator {
    display: inline;
  }
}

@-webkit-keyframes indeterminate {
  0% {
    left: -35%;
    right: 100%;
  }
  60% {
    left: 100%;
    right: -90%;
  }
  100% {
    left: 100%;
    right: -90%;
  }
}
@keyframes indeterminate {
  0% {
    left: -35%;
    right: 100%;
  }
  60% {
    left: 100%;
    right: -90%;
  }
  100% {
    left: 100%;
    right: -90%;
  }
}
@-webkit-keyframes indeterminate-short {
  0% {
    left: -200%;
    right: 100%;
  }
  60% {
    left: 107%;
    right: -8%;
  }
  100% {
    left: 107%;
    right: -8%;
  }
}
@keyframes indeterminate-short {
  0% {
    left: -200%;
    right: 100%;
  }
  60% {
    left: 107%;
    right: -8%;
  }
  100% {
    left: 107%;
    right: -8%;
  }
}

