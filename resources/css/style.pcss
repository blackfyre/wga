/* Alternative palettes. The reference daisyUI theme blocks define base, primary,
   secondary and neutral (with their content pairs) plus info/success/warning/
   error grounds only. The six content roles below are derived, not reference
   values: `accent` reuses neutral (light) / secondary (dark), and each form-
   feedback `*-content` is chosen so it clears the 4.5:1 text floor against its
   own ground (white ink on the darker markers and bone warning, near-black ink
   on Catppuccin's bright greens/oranges, and a slightly deepened ink on the two
   period warnings whose gold ground would otherwise fall short). */
@plugin "daisyui/theme" {
	name: "wga-classic";
	color-scheme: light;
	--color-base-100: #f0f6ff;
	--color-base-200: #e4eefb;
	--color-base-300: #d8e6f8;
	--color-base-content: #0a1626;
	--color-primary: #003366;
	--color-primary-content: #f0f6ff;
	--color-secondary: #445c79;
	--color-secondary-content: #f0f6ff;
	--color-accent: #002a54;
	--color-accent-content: #f0f6ff;
	--color-neutral: #002a54;
	--color-neutral-content: #f0f6ff;
	--color-info: #003366;
	--color-info-content: #f0f6ff;
	--color-success: #2f5c3f;
	--color-success-content: #f0f6ff;
	--color-warning: #b24700;
	--color-warning-content: #f0f6ff;
	--color-error: #a32020;
	--color-error-content: #f0f6ff;
	--radius-selector: 0;
	--radius-field: 0;
	--radius-box: 0;
	--border: 1px;
	--depth: 0;
	--noise: 0;
}

@plugin "daisyui/theme" {
	name: "wga-classic-dark";
	color-scheme: dark;
	--color-base-100: #0b1220;
	--color-base-200: #101a2b;
	--color-base-300: #1d2c42;
	--color-base-content: #e4edfa;
	--color-primary: #1f4e85;
	--color-primary-content: #ffffff;
	--color-secondary: #98a9c0;
	--color-secondary-content: #0b1220;
	--color-accent: #98a9c0;
	--color-accent-content: #0b1220;
	--color-neutral: #16294a;
	--color-neutral-content: #eaf2fd;
	--color-info: #7fb2e8;
	--color-info-content: #0b1220;
	--color-success: #8fb89b;
	--color-success-content: #0b1220;
	--color-warning: #f08a3c;
	--color-warning-content: #0b1220;
	--color-error: #e59288;
	--color-error-content: #0b1220;
	--radius-selector: 0;
	--radius-field: 0;
	--radius-box: 0;
	--border: 1px;
	--depth: 0;
	--noise: 0;
}

