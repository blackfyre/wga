  position: absolute;
  border-radius: 9999px;
  filter: blur(50px);
  opacity: 0.55;
  pointer-events: none;

  &.home-hero__orb--one {
    right: -4rem;
    top: -3rem;
    height: 14rem;
    width: 14rem;
