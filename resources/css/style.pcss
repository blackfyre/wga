@plugin "daisyui/theme" {
	name: "wga-renaissance";
	color-scheme: light;
	--color-base-100: #f3ede1;
	--color-base-200: #eae2d2;
	--color-base-300: #dfd5c2;
	--color-base-content: #2b2117;
	--color-primary: #8a3324;
	--color-primary-content: #f3ede1;
	--color-secondary: #5c4c36;
	--color-secondary-content: #f3ede1;
	--color-accent: #2b2117;
	--color-accent-content: #f3ede1;
	--color-neutral: #2b2117;
	--color-neutral-content: #f3ede1;
	--color-info: #2b5f8f;
	--color-info-content: #f3ede1;
	--color-success: #4e7042;
	--color-success-content: #f3ede1;
	--color-warning: #a8801f;
	--color-warning-content: #201911;
	--color-error: #8a3324;
