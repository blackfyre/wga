@charset "UTF-8";
@import "tailwindcss";

@import "animate.css";
@import "../../node_modules/trix/dist/trix.css";
@import "../../node_modules/vanilla-cookieconsent/dist/cookieconsent.css";
@import "../../node_modules/viewerjs/dist/viewer.css";
@source "../../internal/assets/templ";
@source "../../resources/js";
@plugin "@tailwindcss/typography";
@plugin "daisyui";

.artwork-year-range {
	position: relative;
	height: 20px;
}

.artwork-year-range-track,
.artwork-year-range-fill {
	position: absolute;
	top: 9px;
	height: 1px;
}

.artwork-year-range-track {
	left: 0;
	right: 0;
	background: color-mix(in oklab, var(--color-base-content) 30%, transparent);
}

.artwork-year-range-fill {
	left: var(--range-start, 0%);
	width: var(--range-width, 100%);
}

.artwork-year-range-input {
	position: absolute;
	inset: 0;
	width: 100%;
	margin: 0;
	appearance: none;
	background: transparent;
	pointer-events: none;
}

.artwork-year-range-input::-webkit-slider-thumb {
	width: 12px;
	height: 12px;
	appearance: none;
	border: 1px solid var(--color-base-content);
	border-radius: 9999px;
	background: var(--color-base-100);
	pointer-events: auto;
}

.artwork-year-range-input::-moz-range-thumb {
	width: 10px;
	height: 10px;
	border: 1px solid var(--color-base-content);
	border-radius: 9999px;
	background: var(--color-base-100);
	pointer-events: auto;
}

@theme {
  --font-sans: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Arial, sans-serif;
  --font-mono: ui-monospace, "SF Mono", Menlo, monospace;
}

@plugin "daisyui/theme" {
  name: "wga_light";
  default: true;
  prefersdark: false;
  color-scheme: "light";
  --color-base-100: #f4f2ed;
  --color-base-200: #e9e6df;
  --color-base-300: #e4e0d7;
  --color-base-content: #1c1c1a;
  --color-primary: #003366;
  --color-primary-content: #f4f2ed;
  --color-secondary: #6b6660;
  --color-secondary-content: #f4f2ed;
  --color-accent: #1c1c1a;
  --color-accent-content: #f4f2ed;
  --color-neutral: #1c1c1a;
  --color-neutral-content: #f4f2ed;
  --color-info: #003366;
  --color-info-content: #f4f2ed;
  --color-success: #2e5b4a;
  --color-success-content: #f4f2ed;
  --color-warning: #8a6d1f;
  --color-warning-content: #1c1c1a;
  --color-error: #6b3a2e;
  --color-error-content: #f4f2ed;
  --radius-selector: 0;
  --radius-field: 0;
  --radius-box: 0;
  --size-selector: 0.25rem;
  --size-field: 0.25rem;
  --border: 1px;
  --depth: 0;
  --noise: 0;
}

@plugin "daisyui/theme" {
  name: "wga_dark";
  default: false;
  prefersdark: true;
  color-scheme: "dark";
  --color-base-100: oklch(20% 0.025 250);
  --color-base-200: oklch(24% 0.025 250);
  --color-base-300: oklch(29% 0.025 250);
  --color-base-content: oklch(94% 0.01 250);
  --color-primary: oklch(78% 0.1 250);
  --color-primary-content: oklch(20% 0.025 250);
  --color-secondary: oklch(78% 0.14 350);
  --color-secondary-content: oklch(21% 0.03 350);
  --color-accent: oklch(84% 0.14 100);
  --color-accent-content: oklch(23% 0.04 100);
  --color-neutral: oklch(30% 0.02 250);
  --color-neutral-content: oklch(93% 0.01 250);
  --color-info: oklch(75% 0.09 220);
  --color-info-content: oklch(20% 0.02 220);
  --color-success: oklch(76% 0.14 155);
  --color-success-content: oklch(20% 0.03 155);
  --color-warning: oklch(82% 0.15 85);
  --color-warning-content: oklch(24% 0.04 85);
  --color-error: oklch(74% 0.16 25);
  --color-error-content: oklch(20% 0.03 25);
  --radius-selector: 0;
  --radius-field: 0;
  --radius-box: 0;
  --size-selector: 0.25rem;
  --size-field: 0.25rem;
  --border: 1px;
  --depth: 0;
  --noise: 0;
}

@layer base {
  html {
    background: var(--color-base-100);
    color: var(--color-base-content);
    font-family: var(--font-sans);
  }

  body {
    min-width: 320px;
    background: var(--color-base-100);
  }

  ::selection {
    background: var(--color-primary);
    color: var(--color-primary-content);
  }

  :focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 3px;
  }
}

@layer components {
  .wga-enter {
    animation: wga-rise 280ms cubic-bezier(0.22, 0.61, 0.36, 1) both;
  }

  .wga-meta {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.15em;
  }
}

@keyframes wga-rise {
  from {
    transform: translateY(10px);
  }

  to {
    transform: translateY(0);
  }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    scroll-behavior: auto !important;
    transition-duration: 0.01ms !important;
  }
}


.btn.is-feedback {
  position: fixed;
  bottom: 5rem;
  right: 0;
  transform: rotate(-90deg) translate(0, 93%);
}

.jump.back-to-top {
  position: fixed;
  bottom: 2rem;
  right: 2rem;
  z-index: 1000;
}

.content {
  @apply text-lg text-base-content leading-normal;
  & > * + *,
  & li + li,
  & li > p + p {
    @apply mt-6;
  }
  & strong {
    @apply text-base-content font-bold;
  }
  & a {
    @apply text-base-content font-semibold;
  }
  & strong a {
    @apply font-bold;
  }
  & h2 {
    @apply leading-tight text-xl font-bold text-base-content mb-2 mt-10;
  }
  & h3 {
    @apply leading-tight text-lg font-bold text-base-content mt-8 -mb-2;
  }
  & code {
    @apply font-mono text-sm inline bg-base-300 px-1;
  }
  & pre code {
    @apply block bg-neutral text-neutral-content p-4 rounded;
  }
  & blockquote {
    @apply border-l-4 border-base-300 pl-4 italic;
  }
  & ul,
  & ol {
    @apply pl-5;
    @screen sm {
      @apply pl-10;
    }
  }

  & ul {
    @apply list-disc;
  }
}

.font-display {
  font-family: "Merriweather", serif;
}

.font-ui {
  font-family: "Lexend", sans-serif;
}

.home-page {
  position: relative;
  overflow: clip;

  &::before {
    content: "";
    position: absolute;
    inset: 0;
    /* background:
      radial-gradient(circle at top left, color-mix(in oklab, var(--color-secondary) 28%, white) 0%, transparent 36%),
      radial-gradient(circle at 85% 18%, color-mix(in oklab, var(--color-accent) 30%, white) 0%, transparent 28%),
      linear-gradient(180deg, color-mix(in oklab, var(--color-base-200) 70%, white) 0%, transparent 42%); */
    pointer-events: none;
  }
}

.home-hero {
  position: relative;
  overflow: hidden;
  /* backdrop-filter: blur(10px);
  background-image:
    linear-gradient(135deg, color-mix(in oklab, var(--color-base-100) 92%, white) 0%, color-mix(in oklab, var(--color-base-200) 80%, white) 100%),
    linear-gradient(90deg, transparent 0%, color-mix(in oklab, var(--color-secondary) 4%, transparent) 100%); */
}

