[data-theme="wga_light"],
[data-theme="wga-rams"],
:root {
	--t-9: 0.5625rem;
	--t-95: 0.59375rem;
	--t-10: 0.625rem;
	--t-105: 0.65625rem;
	--t-11: 0.6875rem;
	--t-115: 0.71875rem;
	--t-12: 0.75rem;
	--t-125: 0.78125rem;
	--t-13: 0.8125rem;
	--t-135: 0.84375rem;
	--t-14: 0.875rem;
	--t-15: 0.9375rem;
	--t-16: 1rem;
	--t-17: 1.0625rem;
	--t-18: 1.125rem;
	--t-19: 1.1875rem;
	--t-20: 1.25rem;
	--t-21: 1.3125rem;
	--t-22: 1.375rem;
	--t-26: 1.625rem;
	--t-27: 1.6875rem;
	--t-28: 1.75rem;
	--t-30: 1.875rem;
	--t-32: 2rem;
	--t-34: 2.125rem;
	--t-36: 2.25rem;
	--t-38: 2.375rem;
	--t-40: 2.5rem;
	--t-44: 2.75rem;
	--t-46: 2.875rem;
	--t-48: 3rem;
	--t-52: 3.25rem;
	--t-56: 3.5rem;
	--wga-bg: #f4f2ed;
	--wga-surface: #fbfaf7;
	--wga-surface-2: #efede7;
	--wga-fill: #e4e0d7;
	--wga-fill-line: #c4bfb5;
	--wga-ink: #1c1c1a;
	--wga-inv-bg: #1c1c1a;
	--wga-inv-fg: #f4f2ed;
	--wga-text: #2a2822;
	--wga-text-2: #4a463f;
	--wga-muted: #5f5a54;
	--wga-faint: #68625b;
	--wga-faint-2: #7a746c;
	--wga-accent: #003366;
	--wga-accent-2: #00264d;
	--wga-accent-tint: rgb(0 51 102 / 0.05);
	--wga-accent-tint-2: rgb(0 51 102 / 0.07);
	--wga-accent-soft: rgb(0 51 102 / 0.4);
	--wga-accent-soft-2: rgb(0 51 102 / 0.55);
	--wga-accent-strong: rgb(0 51 102 / 0.9);
	--wga-rule-soft: rgb(28 28 26 / 0.06);
	--wga-rule: rgb(28 28 26 / 0.14);
	--wga-rule-2: rgb(28 28 26 / 0.2);
	--wga-rule-3: rgb(28 28 26 / 0.25);
	--wga-rule-4: rgb(28 28 26 / 0.3);
	--wga-rule-control: rgb(28 28 26 / 0.55);
	--wga-scrim: rgb(28 28 26 / 0.45);
	--wga-series-0: #003366;
	--wga-series-1: #1f5488;
	--wga-series-2: #3d7aae;
	--wga-series-3: #6699c4;
	--wga-series-4: #8fb3d4;
	--wga-series-5: #b4cbe2;
	--wga-series-6: #d5e0ec;
	--wga-lane-movements: #003366;
	--wga-lane-movements-fg: #f4f2ed;
	--wga-lane-artists: #1f5488;
	--wga-lane-artists-fg: #f4f2ed;
	--wga-lane-works: #3d7aae;
	--wga-lane-works-fg: #f4f2ed;
	--wga-lane-buildings: #6699c4;
	--wga-lane-buildings-fg: #1c1c1a;
	--wga-lane-events: #5f5a54;
	--wga-lane-events-fg: #f4f2ed;
	--wga-lane-music: #8fb3d4;
	--wga-lane-music-fg: #1c1c1a;
}

[data-theme="wga_dark"],
[data-theme="wga-rams-dark"] {
	--wga-bg: #1a1814;
	--wga-surface: #211f1a;
	--wga-surface-2: #262420;
	--wga-fill: #302d26;
	--wga-fill-line: #4a463d;
	--wga-ink: #edeae1;
	--wga-inv-bg: #33302a;
	--wga-inv-fg: #f1eee6;
