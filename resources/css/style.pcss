@charset "UTF-8";
@import "tailwindcss";
@import "animate.css";
@import url("https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&family=Lexend:wght@100..900&family=Merriweather:ital,wght@0,300;0,400;0,700;0,900;1,300;1,400;1,700;1,900&family=Source+Serif+4:opsz,wght@8..60,400;600;700&display=swap");
@import "../../node_modules/trix/dist/trix.css";
@import "../../node_modules/vanilla-cookieconsent/dist/cookieconsent.css";
@import "../../node_modules/viewerjs/dist/viewer.css";
@source "../../internal/assets/templ";
@source "../../resources/js";
@plugin "@tailwindcss/typography";

:root {
  color-scheme: light;
  --wga-base-100: #ffffff;
  --wga-base-200: #f0f6ff;
  --wga-base-300: #e5e7eb;
  --wga-base-content: #1f2937;
  --wga-primary: #003366;
  --wga-primary-content: #ffffff;
  --wga-secondary: #a92e55;
  --wga-secondary-content: #ffffff;
  --wga-accent: #f2b134;
  --wga-accent-content: #332300;
  --wga-neutral: #374151;
  --wga-neutral-content: #f3f4f6;
  --wga-info: #3b82a0;
  --wga-info-content: #0c2533;
  --wga-success: #168052;
  --wga-success-content: #e8fff4;
  --wga-warning: #d97706;
  --wga-warning-content: #2d1700;
  --wga-error: #c2413b;
  --wga-error-content: #fff0ef;
  --wga-page-surface: #faf9f6;
  --wga-page-surface-muted: #f0f1f2;
  --wga-page-ink: #182027;
  --wga-page-muted: #55616b;
  --wga-page-border: #cbd2d8;
  --wga-page-focus: #f2b134;
  --wga-content-width: 1440px;
}

html[data-theme="wga_dark"] {
  color-scheme: dark;
  --wga-base-100: #1e293b;
  --wga-base-200: #263447;
  --wga-base-300: #334155;
  --wga-base-content: #edf2f7;
  --wga-primary: #a7c8ff;
  --wga-primary-content: #1e293b;
  --wga-secondary: #f29ab5;
  --wga-secondary-content: #30121e;
  --wga-accent: #f7ce6b;
  --wga-accent-content: #2d2408;
  --wga-neutral: #475569;
  --wga-neutral-content: #f8fafc;
  --wga-info: #7cc7e4;
  --wga-info-content: #132c37;
  --wga-success: #75d5a5;
  --wga-success-content: #133426;
  --wga-warning: #f3c15e;
  --wga-warning-content: #352300;
  --wga-error: #f19a95;
  --wga-error-content: #391513;
  --wga-page-surface: #182027;
  --wga-page-surface-muted: #26323b;
  --wga-page-ink: #f2f1ee;
  --wga-page-muted: #c3c6d1;
  --wga-page-border: #55616b;
  --wga-page-focus: #fdbb3e;
}

@media (prefers-color-scheme: dark) {
  html:not([data-theme]) {
    color-scheme: dark;
    --wga-base-100: #1e293b;
    --wga-base-200: #263447;
    --wga-base-300: #334155;
    --wga-base-content: #edf2f7;
    --wga-primary: #a7c8ff;
    --wga-primary-content: #1e293b;
    --wga-secondary: #f29ab5;
    --wga-secondary-content: #30121e;
    --wga-accent: #f7ce6b;
    --wga-accent-content: #2d2408;
    --wga-neutral: #475569;
    --wga-neutral-content: #f8fafc;
    --wga-info: #7cc7e4;
    --wga-info-content: #132c37;
    --wga-success: #75d5a5;
    --wga-success-content: #133426;
    --wga-warning: #f3c15e;
    --wga-warning-content: #352300;
    --wga-error: #f19a95;
    --wga-error-content: #391513;
    --wga-page-surface: #182027;
    --wga-page-surface-muted: #26323b;
    --wga-page-ink: #f2f1ee;
    --wga-page-muted: #c3c6d1;
    --wga-page-border: #55616b;
    --wga-page-focus: #fdbb3e;
  }
}

@theme inline {
  --color-base-100: var(--wga-base-100);
  --color-base-200: var(--wga-base-200);
  --color-base-300: var(--wga-base-300);
  --color-base-content: var(--wga-base-content);
  --color-primary: var(--wga-primary);
  --color-primary-content: var(--wga-primary-content);
  --color-secondary: var(--wga-secondary);
  --color-secondary-content: var(--wga-secondary-content);
  --color-accent: var(--wga-accent);
  --color-accent-content: var(--wga-accent-content);
  --color-neutral: var(--wga-neutral);
  --color-neutral-content: var(--wga-neutral-content);
  --color-info: var(--wga-info);
  --color-info-content: var(--wga-info-content);
  --color-success: var(--wga-success);
  --color-success-content: var(--wga-success-content);
  --color-warning: var(--wga-warning);
  --color-warning-content: var(--wga-warning-content);
  --color-error: var(--wga-error);
  --color-error-content: var(--wga-error-content);
}

@layer components {
  html,
  body {
    background: var(--wga-base-100);
    color: var(--wga-base-content);
  }

  .btn {
    display: inline-flex;
    min-height: 2.5rem;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    border: 1px solid transparent;
    border-radius: 0.25rem;
    background: var(--wga-base-200);
    color: var(--wga-base-content);
    cursor: pointer;
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.2;
    padding: 0.5rem 1rem;
    text-decoration: none;
  }

  .btn:hover { background: var(--wga-base-300); }
  .btn:focus-visible,
  .input:focus-visible,
  .textarea:focus-visible,
  .select:focus-visible,
  .toggle:focus-visible { outline: 3px solid var(--wga-accent); outline-offset: 2px; }
  .btn-primary { background: var(--wga-primary); color: var(--wga-primary-content); }
  .btn-primary:hover { background: color-mix(in srgb, var(--wga-primary) 85%, #000); }
  .btn-secondary { background: var(--wga-secondary); color: var(--wga-secondary-content); }
  .btn-neutral { background: var(--wga-neutral); color: var(--wga-neutral-content); }
  .btn-outline { border-color: currentColor; background: transparent; }
  .btn-ghost { background: transparent; }
  .btn-link { min-height: auto; background: transparent; color: var(--wga-primary); padding: 0; text-decoration: underline; }
  .btn-circle { width: 2.5rem; padding: 0; border-radius: 9999px; }
  .btn-xs { min-height: 1.5rem; font-size: 0.75rem; padding: 0.25rem 0.5rem; }
  .btn-sm { min-height: 2rem; font-size: 0.8125rem; padding: 0.375rem 0.75rem; }
  .btn-lg { min-height: 3rem; font-size: 1rem; padding: 0.75rem 1.25rem; }
  .btn:disabled,
  .btn-disabled { cursor: not-allowed; opacity: 0.5; }
  a.btn-disabled { pointer-events: none; }

  .input,
  .textarea,
  .select {
    width: 100%;
    border: 1px solid var(--wga-base-300);
    border-radius: 0.25rem;
    background: var(--wga-base-100);
    color: var(--wga-base-content);
    font: inherit;
    padding: 0.625rem 0.75rem;
  }

  .textarea { min-height: 7rem; resize: vertical; }
  .input-bordered,
  .textarea-bordered,
  .select-bordered { border-color: var(--wga-base-300); }
  .input-sm { min-height: 2rem; padding: 0.375rem 0.625rem; font-size: 0.875rem; }
  .form-control { display: grid; gap: 0.375rem; }
  .label { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; }
  .label-text { font-size: 0.875rem; }

  .badge {
    display: inline-flex;
    min-height: 1.5rem;
    align-items: center;
    border: 1px solid var(--wga-base-300);
    border-radius: 9999px;
    background: var(--wga-base-200);
    color: var(--wga-base-content);
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.125rem 0.5rem;
  }

  .badge-primary { background: var(--wga-primary); border-color: var(--wga-primary); color: var(--wga-primary-content); }
  .badge-secondary { background: var(--wga-secondary); border-color: var(--wga-secondary); color: var(--wga-secondary-content); }
  .badge-neutral { background: var(--wga-neutral); border-color: var(--wga-neutral); color: var(--wga-neutral-content); }
  .badge-outline { background: transparent; }
  .badge-lg { min-height: 1.875rem; font-size: 0.875rem; padding-inline: 0.75rem; }

  .card {
    border: 1px solid var(--wga-base-300);
    border-radius: 0.25rem;
    background: var(--wga-base-100);
    color: var(--wga-base-content);
  }

  .card-body { display: flex; flex-direction: column; gap: 0.75rem; padding: 1.25rem; }
  .card-title { margin: 0; font-size: 1.125rem; font-weight: 700; }
  .card-actions { display: flex; flex-wrap: wrap; gap: 0.5rem; }

  .alert {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    border: 1px solid var(--wga-info);
    border-radius: 0.25rem;
    background: color-mix(in srgb, var(--wga-info) 18%, var(--wga-base-100));
    color: var(--wga-base-content);
    padding: 1rem;
  }

  .alert-warning { border-color: var(--wga-warning); background: color-mix(in srgb, var(--wga-warning) 20%, var(--wga-base-100)); }
  .alert-error { border-color: var(--wga-error); background: color-mix(in srgb, var(--wga-error) 16%, var(--wga-base-100)); }
  .alert-success { border-color: var(--wga-success); background: color-mix(in srgb, var(--wga-success) 16%, var(--wga-base-100)); }

  .navbar {
    display: flex;
    min-height: 4rem;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    background: var(--wga-base-100);
    color: var(--wga-base-content);
    padding-inline: 1rem;
  }

  .navbar-start,
  .navbar-center,
  .navbar-end { display: flex; flex: 1; align-items: center; }
  .navbar-center { justify-content: center; }
  .navbar-end { justify-content: flex-end; }
  .menu { display: flex; margin: 0; padding: 0; list-style: none; }
  .menu li { list-style: none; }
  .menu a,
  .menu summary { display: block; border-radius: 0.25rem; cursor: pointer; padding: 0.5rem 0.75rem; text-decoration: none; }
  .menu a:hover,
  .menu summary:hover { background: var(--wga-base-200); }
  .menu-horizontal { flex-direction: row; }
  @media (min-width: 1024px) {
    .menu-horizontal > li { position: relative; }
    .menu-horizontal > li > details > ul { display: none; position: absolute; z-index: 20; top: 100%; left: 0; min-width: 13rem; border: 1px solid var(--wga-base-300); border-radius: 0.25rem; background: var(--wga-base-100); padding: 0.5rem; }
    .menu-horizontal > li > details[open] > ul { display: block; }
  }
  .dropdown { position: relative; }
  .dropdown-content { display: none; position: absolute; z-index: 20; min-width: 13rem; border: 1px solid var(--wga-base-300); border-radius: 0.25rem; background: var(--wga-base-100); padding: 0.5rem; }
  .dropdown:focus-within .dropdown-content,
  .dropdown:hover .dropdown-content { display: block; }
  .dropdown-content .menu { flex-direction: column; }

  .toggle {
    width: 2.25rem;
    height: 1.25rem;
    appearance: none;
    border: 1px solid var(--wga-base-300);
    border-radius: 9999px;
    background: var(--wga-base-300);
    cursor: pointer;
    padding: 0.125rem;
    transition: background-color 150ms ease;
  }

  .toggle::before { display: block; width: 0.875rem; height: 0.875rem; border-radius: 9999px; background: var(--wga-base-100); content: ""; transition: transform 150ms ease; }
  .toggle:checked { background: var(--wga-primary); }
  .toggle:checked::before { transform: translateX(1rem); }
  .toggle-sm { width: 1.875rem; height: 1rem; }
  .toggle-sm::before { width: 0.625rem; height: 0.625rem; }
  .toggle-sm:checked::before { transform: translateX(0.75rem); }

  .modal { max-width: min(100% - 2rem, 42rem); max-height: calc(100dvh - 2rem); overflow-y: auto; border: 0; border-radius: 0.25rem; background: var(--wga-base-100); color: var(--wga-base-content); padding: 0; }
  .modal::backdrop { background: rgb(0 0 0 / 55%); }
  .modal-bottom { margin: auto auto 1rem; }
  .modal-middle { margin: auto; }
  .modal-box { position: relative; z-index: 1; padding: 1.5rem; }
  .modal-backdrop { position: fixed; z-index: 0; inset: 0; margin: 0; padding: 0; }
  .modal-backdrop button { position: fixed; inset: 0; width: 100%; height: 100%; cursor: default; }

  .toast { position: fixed; right: 1rem; bottom: 1rem; z-index: 60; display: grid; gap: 0.75rem; max-width: min(24rem, calc(100vw - 2rem)); }
  .footer { display: grid; gap: 1.5rem; }
  .stats { display: grid; }
  .stat { padding: 1.25rem; }
  .stat-title { color: var(--wga-base-content); font-size: 0.875rem; }
  .stat-value { color: var(--wga-primary); font-size: 2rem; font-weight: 700; }
  .stat-desc { color: color-mix(in srgb, var(--wga-base-content) 70%, transparent); font-size: 0.875rem; }
  .stat-figure { color: var(--wga-primary); }
  .table { width: 100%; border-collapse: collapse; }
  .table :is(th, td) { border-bottom: 1px solid var(--wga-base-300); padding: 0.75rem; text-align: left; }
  .table-sm :is(th, td) { padding: 0.5rem; font-size: 0.875rem; }
  .rounded-box { border-radius: 0.25rem; }
  .skeleton { background: var(--wga-base-200); }

  @media (min-width: 640px) {
    .sm\:footer-horizontal { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .sm\:modal-middle { margin: auto; }
  }
}


.btn.is-feedback {
  position: fixed;
  bottom: 5rem;
  right: 0;
  transform: rotate(-90deg) translate(0, 93%);
}

.environment-status {
  display: block;
  position: fixed;
  z-index: 41;
  right: 0;
  bottom: 12rem;
  min-width: 6rem;
  padding: 0.625rem 1rem;
  transform: rotate(-90deg) translate(0, 100%);
  font-family: "Inter", sans-serif;
  font-size: 0.6875rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-align: center;
  text-decoration: none;
  text-transform: uppercase;
}

.environment-status--development,
.environment-status--dev {
  background: var(--wga-info);
  color: var(--wga-info-content);
}

.environment-status--test {
  background: var(--wga-secondary);
  color: var(--wga-secondary-content);
}

.environment-status--staging {
  background: var(--wga-warning);
  color: var(--wga-warning-content);
}

.jump.back-to-top {
  position: fixed;
  bottom: 2rem;
  right: 2rem;
  z-index: 1000;
}

.content {
  @apply text-lg text-base-content leading-normal;
  & > * + *,
  & li + li,
  & li > p + p {
    @apply mt-6;
  }
  & strong {
    @apply text-base-content font-bold;
  }
  & a {
    @apply text-base-content font-semibold;
  }
  & strong a {
    @apply font-bold;
  }
  & h2 {
    @apply leading-tight text-xl font-bold text-base-content mb-2 mt-10;
  }
  & h3 {
    @apply leading-tight text-lg font-bold text-base-content mt-8 -mb-2;
  }
  & code {
    @apply font-mono text-sm inline bg-base-300 px-1;
  }
  & pre code {
    @apply block bg-neutral text-neutral-content p-4 rounded;
  }
  & blockquote {
    @apply border-l-4 border-base-300 pl-4 italic;
  }
  & ul,
  & ol {
    @apply pl-5;
    @screen sm {
      @apply pl-10;
    }
  }

  & ul {
    @apply list-disc;
  }
}

.font-display {
  font-family: "Merriweather", serif;
}

.font-ui {
  font-family: "Lexend", sans-serif;
}

.site-header {
  position: fixed;
  z-index: 40;
  top: 0;
  right: 0;
  left: 0;
  border-bottom: 1px solid var(--wga-page-border);
  background: color-mix(in srgb, var(--wga-page-surface) 94%, transparent);
  color: var(--wga-page-ink);
  font-family: "Inter", sans-serif;
  backdrop-filter: blur(12px);
}

.site-header__inner {
  display: grid;
  min-height: 5rem;
  grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
  align-items: center;
  max-width: var(--wga-content-width);
  margin: 0 auto;
  padding: 0 2rem;
}

.site-header__identity,
.site-header__theme {
  display: flex;
  align-items: center;
}

.site-header__identity {
  gap: 1rem;
}

.site-header__brand {
  display: flex;
  align-items: baseline;
  /*gap: 0.75rem;*/
  color: var(--wga-primary);
  text-decoration: none;
}

.site-header__brand > span {
  font-family: "Source Serif 4", serif;
  font-size: 1.5rem;
  font-weight: 700;
  letter-spacing: -0.04em;
}

.site-header__brand small,
.site-header__theme > span {
  color: var(--wga-page-muted);
  font-size: 0.6875rem;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.site-header__links {
  align-items: center;
  gap: 0.25rem;
  margin: 0;
  padding: 0;
  list-style: none;
}

.site-header__links a,
.site-header__links summary {
  display: block;
  padding: 0.5rem 0.75rem;
  border-radius: 999px;
  color: inherit;
  cursor: pointer;
  font-size: 0.8125rem;
  font-weight: 600;
  text-decoration: none;
}

.site-header__links a:hover,
.site-header__links summary:hover,
.site-header__links a:focus-visible,
.site-header__links summary:focus-visible {
  background: var(--wga-page-surface-muted);
}

.site-header__more {
  position: relative;
}

.site-header__more summary {
  list-style: none;
}

.site-header__more summary::after {
  margin-left: 0.35rem;
  content: "⌄";
}

.site-header__more summary::-webkit-details-marker,
.site-header__mobile-menu summary::-webkit-details-marker {
  display: none;
}

.site-header__more details[open] summary::after {
  content: "⌃";
}

.site-header__more ul,
.site-header__mobile-menu ul {
  margin: 0;
  list-style: none;
}

.site-header__more ul {
  position: absolute;
  z-index: 1;
  top: calc(100% + 0.5rem);
  right: 0;
  min-width: 11rem;
  border: 1px solid var(--wga-page-border);
  background: var(--wga-page-surface);
  box-shadow: 0 0.75rem 2rem rgb(24 32 39 / 12%);
  padding: 0.5rem;
}

.site-header__more ul a {
  border-radius: 0.2rem;
}

.site-header__theme {
  justify-self: end;
  gap: 0.625rem;
  cursor: pointer;
}

.site-header__mobile-menu {
  position: relative;
}

.site-header__mobile-menu summary {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  color: var(--wga-primary);
  cursor: pointer;
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  list-style: none;
  text-transform: uppercase;
}

.site-header__mobile-menu summary svg {
  width: 1.25rem;
  height: 1.25rem;
}

.site-header__mobile-menu ul {
  position: absolute;
  z-index: 1;
  top: calc(100% + 1.25rem);
  left: -1rem;
  width: min(18rem, calc(100vw - 2rem));
  border: 1px solid var(--wga-page-border);
  background: var(--wga-page-surface);
  box-shadow: 0 0.75rem 2rem rgb(24 32 39 / 12%);
  padding: 0.5rem;
}

.site-header__mobile-menu a {
  display: block;
  padding: 0.875rem 0.75rem;
  color: inherit;
  font-size: 0.875rem;
  font-weight: 600;
  text-decoration: none;
}

.site-header__mobile-menu a:hover,
.site-header__mobile-menu a:focus-visible {
  background: var(--wga-page-surface-muted);
}

.site-footer {
  margin-top: 3rem;
  border-top: 1px solid var(--wga-page-border);
  background: var(--wga-page-surface-muted);
  color: var(--wga-page-ink);
  font-family: "Inter", sans-serif;
}

.site-footer__inner {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  max-width: var(--wga-content-width);
  margin: 0 auto;
  padding: 1.5rem 2rem;
}

.site-footer__brand {
  display: grid;
  align-content: start;
  gap: 0.25rem;
  color: var(--wga-primary);
  text-decoration: none;
}

.site-footer__brand span {
  font-family: "Source Serif 4", serif;
  font-size: 1.25rem;
  font-weight: 600;
}

.site-footer__brand small,
.site-footer__meta {
  color: var(--wga-page-muted);
  font-size: 0.75rem;
  line-height: 1.5;
}

.site-footer__links {
  display: grid;
  grid-template-columns: repeat(2, minmax(8rem, 1fr));
  gap: 0.375rem 2rem;
}

.site-footer__links a {
  color: inherit;
  font-size: 0.75rem;
  font-weight: 600;
  text-decoration: none;
}

.site-footer__links a:hover,
.site-footer__links a:focus-visible,
.site-footer__meta a:hover,
.site-footer__meta a:focus-visible {
  color: var(--wga-primary);
  text-decoration: underline;
}

.site-footer__meta {
  display: flex;
  grid-column: 1 / -1;
  flex-wrap: wrap;
  gap: 0.5rem 1.5rem;
  margin-top: 1.5rem;
  padding-top: 1rem;
  border-top: 1px solid var(--wga-page-border);
}

.site-footer__meta p {
  margin: 0;
}

.site-footer__meta a {
  color: inherit;
}

@media (max-width: 1023px) {
  .site-header__inner {
    grid-template-columns: minmax(0, 1fr) auto;
    padding: 0 1rem;
  }

  .site-header__brand small {
    display: none;
  }

  .site-footer__inner {
    padding: 1.5rem 1rem;
  }
}

@media (max-width: 479px) {
  .site-header__theme > span {
    display: none;
  }

  .site-footer__inner {
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  .site-footer__links {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .site-footer__meta {
    margin-top: 0;
  }
}

.homepage {
  --homepage-surface: var(--wga-page-surface);
  --homepage-surface-muted: var(--wga-page-surface-muted);
  --homepage-ink: var(--wga-page-ink);
  --homepage-muted: var(--wga-page-muted);
  --homepage-primary: var(--wga-primary);
  --homepage-border: var(--wga-page-border);
  --homepage-focus: var(--wga-page-focus);
  max-width: var(--wga-content-width);
  margin: 0 auto;
  background: var(--homepage-surface);
  color: var(--homepage-ink);
  font-family: "Inter", sans-serif;
}

.homepage__hero,
.homepage__entries,
.homepage__feature,
.homepage__about {
  max-width: var(--wga-content-width);
  margin: 0 auto;
  border-bottom: 1px solid var(--homepage-border);
}

.homepage__hero {
  display: grid;
  min-height: 30rem;
  place-items: center;
  padding: 5rem 2rem;
  background: var(--homepage-surface-muted);
  text-align: center;
}

.homepage__hero-content {
  width: min(100%, 42rem);
}

.homepage__eyebrow,
.homepage__entry > span,
.homepage__statistics dt {
  margin: 0;
  color: var(--homepage-muted);
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.homepage h1,
.homepage h2 {
  color: var(--homepage-primary);
  font-family: "Source Serif 4", serif;
}

.homepage h1 {
  max-width: 40rem;
  margin: 0.75rem auto 2rem;
  font-size: clamp(2.5rem, 6vw, 4.5rem);
  font-weight: 700;
  letter-spacing: -0.03em;
  line-height: 1.05;
}

.homepage__search {
  display: grid;
  grid-template-columns: 1fr auto;
  border: 1px solid var(--homepage-border);
  background: var(--homepage-surface);
}

.homepage__search label {
  position: absolute;
  width: 1px;
  height: 1px;
  overflow: hidden;
  clip: rect(0 0 0 0);
  white-space: nowrap;
}

.homepage__search input {
  min-width: 0;
  border: 0;
  background: transparent;
  color: inherit;
  font: inherit;
  padding: 1.25rem;
}

.homepage__search input:focus {
  outline: 3px solid var(--homepage-focus);
  outline-offset: -3px;
}

.homepage__search button,
.homepage__button {
  border: 0;
  background: var(--homepage-primary);
  color: var(--homepage-surface);
  cursor: pointer;
  font: inherit;
  font-size: 0.875rem;
  font-weight: 600;
  letter-spacing: 0.04em;
  padding: 0.875rem 1.25rem;
  text-decoration: none;
  text-transform: uppercase;
}

.homepage__search button:hover,
.homepage__button:hover {
  background: color-mix(in srgb, var(--homepage-primary) 85%, #000);
}

.homepage__search button:focus-visible,
.homepage__button:focus-visible,
.homepage__entry:focus-visible,
.homepage__prose a:focus-visible {
  outline: 3px solid var(--homepage-focus);
  outline-offset: 3px;
}

.homepage__search-note {
  margin: 1rem 0 0;
  color: var(--homepage-muted);
  font-size: 0.75rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.homepage__entries {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
}

.homepage__entry {
  display: grid;
  min-height: 16rem;
  grid-template-rows: auto 1fr auto;
  gap: 0.5rem;
  padding: 2rem;
  border-right: 1px solid var(--homepage-border);
  color: inherit;
  text-decoration: none;
}

.homepage__entry:last-child {
  border-right: 0;
}

.homepage__entry:hover {
  background: var(--homepage-surface-muted);
}

.homepage__entry h2 {
  margin: 0.25rem 0;
  font-size: 2rem;
  line-height: 1.2;
}

.homepage__entry p {
  max-width: 15rem;
  margin: 0;
  color: var(--homepage-muted);
  font-size: 0.875rem;
  line-height: 1.5;
}

.homepage__entry strong {
  justify-self: end;
  color: var(--homepage-primary);
  font-size: 1.5rem;
}

.homepage__feature {
  display: grid;
  grid-template-columns: minmax(0, 2fr) minmax(20rem, 1fr);
}

.homepage__image-well {
  display: grid;
  min-height: 28rem;
  place-items: center;
  background: var(--homepage-surface-muted);
  padding: 1.5rem;
  border-right: 1px solid var(--homepage-border);
}

.homepage__image-well img {
  display: block;
  max-height: 34rem;
  max-width: 100%;
  border: 1px solid var(--homepage-border);
  object-fit: contain;
}

.homepage__feature-copy {
  align-self: center;
  padding: 2rem;
}

.homepage__feature-copy h2 {
  margin: 0.75rem 0 1rem;
  font-size: clamp(2rem, 3vw, 3rem);
  line-height: 1.1;
}

.homepage__feature-copy > p:not(.homepage__eyebrow) {
  margin: 0 0 2rem;
  color: var(--homepage-muted);
  line-height: 1.6;
}

.homepage__button {
  display: inline-block;
}

.homepage__about {
  display: grid;
  grid-template-columns: minmax(0, 2fr) minmax(18rem, 1fr);
}

.homepage__welcome,
.homepage__statistics {
  margin: 0;
  padding: 2rem;
}

.homepage__statistics {
  display: grid;
  align-content: center;
  gap: 1.5rem;
  border-left: 1px solid var(--homepage-border);
  background: color-mix(in srgb, var(--homepage-surface-muted) 55%, var(--homepage-surface));
}

.homepage__statistics div {
  border-bottom: 1px solid var(--homepage-border);
  padding-bottom: 1rem;
}

.homepage__statistics div:last-child {
  border-bottom: 0;
  padding-bottom: 0;
}

.homepage__statistics dd {
  margin: 0.25rem 0 0;
  color: var(--homepage-primary);
  font-family: "Source Serif 4", serif;
  font-size: 2.25rem;
  font-weight: 600;
}

.homepage__prose {
  max-width: 72ch;
  color: var(--homepage-muted);
  font-size: 1rem;
  line-height: 1.7;
}

.homepage__prose > :first-child {
  margin-top: 0.75rem;
}

.homepage__prose > * + * {
  margin-top: 1rem;
}

.homepage__prose a {
  color: var(--homepage-primary);
  font-weight: 600;
  text-decoration-thickness: 1px;
  text-underline-offset: 0.18em;
}

@media (max-width: 767px) {
  .homepage__hero {
    min-height: 24rem;
    padding: 3rem 1rem;
  }

  .homepage__search {
    grid-template-columns: 1fr;
  }

  .homepage__search button {
    width: 100%;
  }

  .homepage__entries,
  .homepage__feature,
  .homepage__about {
    grid-template-columns: 1fr;
  }

  .homepage__entry {
    min-height: 13rem;
    border-right: 0;
    border-bottom: 1px solid var(--homepage-border);
  }

  .homepage__entry:last-child {
    border-bottom: 0;
  }

  .homepage__image-well {
    min-height: 18rem;
  }

  .homepage__statistics {
    border-top: 1px solid var(--homepage-border);
    border-left: 0;
  }
}

.explore-artworks {
  --explore-surface: var(--wga-page-surface);
  --explore-surface-muted: var(--wga-page-surface-muted);
  --explore-ink: var(--wga-page-ink);
  --explore-muted: var(--wga-page-muted);
  --explore-primary: var(--wga-primary);
  --explore-border: var(--wga-page-border);
  --explore-focus: var(--wga-page-focus);
  display: grid;
  grid-template-columns: 17rem minmax(0, 1fr);
  max-width: var(--wga-content-width);
  margin: 0 auto;
  background: var(--explore-surface);
  color: var(--explore-ink);
  font-family: "Inter", sans-serif;
}

.explore-artworks__sidebar {
  border-right: 1px solid var(--explore-border);
  background: var(--explore-surface-muted);
  padding: 1.5rem 1rem;
}

.explore-artworks__content {
  min-width: 0;
  padding: 2rem;
}

.explore-artworks__heading {
  display: grid;
  gap: 0.4rem;
  margin-bottom: 2rem;
  padding-bottom: 1.5rem;
  border-bottom: 1px solid var(--explore-border);
}

.explore-artworks__heading p,
.explore-filters__heading p,
.explore-artwork-card__copy p {
  margin: 0;
  color: var(--explore-muted);
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.explore-artworks__heading h1,
.explore-filters__heading h2,
.explore-results__empty h2,
.explore-artwork-card__copy h2 {
  margin: 0;
  color: var(--explore-primary);
  font-family: "Source Serif 4", serif;
}

.explore-artworks__heading h1 {
  font-size: clamp(2.25rem, 4vw, 3.5rem);
  line-height: 1.1;
}

.explore-artworks__heading span {
  color: var(--explore-muted);
  font-size: 0.875rem;
}

.explore-filters {
  display: grid;
  gap: 1.25rem;
}

.explore-filters__heading {
  padding-bottom: 1.25rem;
  border-bottom: 1px solid var(--explore-border);
}

.explore-filters__heading h2 {
  margin-top: 0.35rem;
  font-size: 1.75rem;
}

.explore-filters__field {
  display: grid;
  gap: 0.5rem;
  color: var(--explore-primary);
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.explore-filters__field input,
.explore-filters__field select {
  width: 100%;
  border: 1px solid var(--explore-border);
  border-radius: 0;
  background: var(--explore-surface);
  color: var(--explore-ink);
  font: 400 0.875rem "Inter", sans-serif;
  letter-spacing: normal;
  padding: 0.75rem;
  text-transform: none;
}

.explore-filters__field input:focus,
.explore-filters__field select:focus {
  outline: 3px solid var(--explore-focus);
  outline-offset: -3px;
}

.explore-filters__actions {
  display: grid;
  gap: 0.75rem;
  padding-top: 0.5rem;
}

.explore-filters__actions button,
.explore-filters__actions a {
  border: 1px solid var(--explore-primary);
  background: var(--explore-primary);
  color: var(--explore-surface);
  cursor: pointer;
  font: 600 0.75rem "Inter", sans-serif;
  letter-spacing: 0.08em;
  padding: 0.875rem;
  text-align: center;
  text-decoration: none;
  text-transform: uppercase;
}

.explore-filters__actions a {
  background: transparent;
  color: var(--explore-primary);
}

.explore-filters__actions button:hover {
  background: color-mix(in srgb, var(--explore-primary) 85%, #000);
}

.explore-filters__actions a:hover {
  background: var(--explore-surface);
}

.explore-filters__actions button:focus-visible,
.explore-filters__actions a:focus-visible,
.explore-artwork-card:focus-visible {
  outline: 3px solid var(--explore-focus);
  outline-offset: 3px;
}

.explore-filters__indicator {
  border: 1px solid var(--explore-border);
  color: var(--explore-muted);
  font-size: 0.875rem;
  padding: 0.75rem;
}

.explore-results {
  display: grid;
  gap: 1.5rem;
}

.explore-results__summary {
  margin: 0;
  color: var(--explore-muted);
  font-size: 0.875rem;
  letter-spacing: 0.05em;
  text-transform: uppercase;
}

.explore-results__grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 1.5rem;
}

.explore-artwork-card {
  color: inherit;
  text-decoration: none;
}

.explore-artwork-card__image {
  display: grid;
  aspect-ratio: 4 / 3;
  place-items: center;
  margin: 0;
  border: 1px solid var(--explore-border);
  background: var(--explore-surface-muted);
  overflow: hidden;
  padding: 1rem;
}

.explore-artwork-card__image img {
  display: block;
  max-height: 100%;
  max-width: 100%;
  border: 1px solid color-mix(in srgb, var(--explore-border) 45%, transparent);
  object-fit: contain;
  transition: transform 180ms ease;
}

.explore-artwork-card:hover .explore-artwork-card__image img {
  transform: scale(1.02);
}

.explore-artwork-card__copy {
  display: grid;
  gap: 0.35rem;
  padding-top: 0.75rem;
}

.explore-artwork-card__copy h2 {
  font-size: 1.25rem;
  font-style: italic;
  line-height: 1.25;
}

.explore-artwork-card__copy span {
  color: var(--explore-muted);
  font-size: 0.75rem;
  line-height: 1.5;
}

.explore-results__empty {
  border: 1px solid var(--explore-border);
  background: var(--explore-surface-muted);
  padding: 2rem;
}

.explore-results__empty h2 {
  font-size: 2rem;
}

.explore-results__empty p {
  max-width: 40rem;
  margin: 0.75rem 0 0;
  color: var(--explore-muted);
  line-height: 1.6;
}

.explore-results__pagination {
  border-top: 1px solid var(--explore-border);
  padding-top: 1.5rem;
}

@media (max-width: 1023px) {
  .explore-artworks {
    grid-template-columns: 1fr;
  }

  .explore-artworks__sidebar {
    border-right: 0;
    border-bottom: 1px solid var(--explore-border);
  }

  .explore-filters {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .explore-filters__heading,
  .explore-filters__actions,
  .explore-filters__indicator {
    grid-column: 1 / -1;
  }

  .explore-filters__actions {
    grid-template-columns: repeat(2, max-content);
  }
}

@media (max-width: 767px) {
  .explore-artworks__content {
    padding: 1.5rem 1rem;
  }

  .explore-artworks__sidebar {
    padding: 1.5rem 1rem;
  }

  .explore-filters,
  .explore-results__grid {
    grid-template-columns: 1fr;
  }

  .explore-filters__actions {
    grid-template-columns: 1fr;
  }
}

@media (min-width: 1441px) {
  .homepage__hero,
  .homepage__entries,
  .homepage__feature,
  .homepage__about {
    border-inline: 1px solid var(--homepage-border);
  }
}

figure.hidden-caption {
  & figcaption {
    display: none;
  }
}

/* Honeypot field */
.hpt {
  opacity: 0;
  position: absolute;
  top: 0;
  left: 0;
  height: 0;
  width: 0;
  z-index: -1;
}

/* fix for cookie consent title hover jumping */
.c-bl .title {
  margin-bottom: 0;
}

/* progress indicator */

.progress-indicator {
  position: fixed;
  top: 0;
  z-index: 1000;
  height: 4px;
  width: 100%;
  border-radius: 2px;
  background-clip: padding-box;
  overflow: hidden;
  display: none;

  & .indeterminate:before {
    content: "";
    position: absolute;
    background-color: inherit;
    top: 0;
    left: 0;
    bottom: 0;
    will-change: left, right;
    -webkit-animation: indeterminate 2.1s
      cubic-bezier(0.65, 0.815, 0.735, 0.395) infinite;
    animation: indeterminate 2.1s cubic-bezier(0.65, 0.815, 0.735, 0.395)
      infinite;
  }

  & .indeterminate:after {
    content: "";
    position: absolute;
    background-color: inherit;
    top: 0;
    left: 0;
    bottom: 0;
    will-change: left, right;
    -webkit-animation: indeterminate-short 2.1s
      cubic-bezier(0.165, 0.84, 0.44, 1) infinite;
    animation: indeterminate-short 2.1s cubic-bezier(0.165, 0.84, 0.44, 1)
      infinite;
    -webkit-animation-delay: 1.15s;
    animation-delay: 1.15s;
  }
}

.htmx-request {
  &.progress-indicator {
    display: inline;
  }
}

@-webkit-keyframes indeterminate {
  0% {
    left: -35%;
    right: 100%;
  }
  60% {
    left: 100%;
    right: -90%;
  }
  100% {
    left: 100%;
    right: -90%;
  }
}
@keyframes indeterminate {
  0% {
    left: -35%;
    right: 100%;
  }
  60% {
    left: 100%;
    right: -90%;
  }
  100% {
    left: 100%;
    right: -90%;
  }
}
@-webkit-keyframes indeterminate-short {
  0% {
    left: -200%;
    right: 100%;
  }
  60% {
    left: 107%;
    right: -8%;
  }
  100% {
    left: 107%;
    right: -8%;
  }
}
@keyframes indeterminate-short {
  0% {
    left: -200%;
    right: 100%;
  }
  60% {
    left: 107%;
    right: -8%;
  }
  100% {
    left: 107%;
    right: -8%;
  }
}

/* Dialog */

/* dialog {
  @apply z-50;
  display: block;
  inset: 0;
  transition: opacity 0.5s;
  animation: scale-down 0.5s cubic-bezier(0.25, 0, 0.3, 1) forwards;
  animation-timing-function: cubic-bezier(0.5, -0.5, 0.1, 1.5);

  &[open] {
    animation: slide-in-up 0.5s cubic-bezier(0.25, 0, 0.3, 1) forwards;
  }

  &:not([open]) {
    pointer-events: none;
    opacity: 0;
  }

  &::backdrop {
    backdrop-filter: blur(0.35rem);
  }

  .close-dialog {
    position: absolute;
    right: 1rem;
    top: 1rem;
  }
} */

@keyframes slide-in-up {
  0% {
    transform: translateY(100%);
  }
}

@keyframes scale-down {
  to {
    transform: scale(0.75);
  }
}

/* @media (min-width: $tablet) {
  dialog {
    max-width: 70vw;
  }
} */

a:not([class]) {
  @apply font-semibold underline;
}

.menu {
  a:not([class]) {
    @apply font-normal no-underline;
  }
}

a[href]:not(:where(
  [href^="#"],
  [href^="?"],
  [href^="/"]:not([href^="//"]),
  [onclick]
)):not(.has-sm-icon):after {
  content: "↗";
}

@keyframes fade-in {
  from {
    opacity: 0;
  }
}

@keyframes fade-out {
  to {
    opacity: 0;
  }
}

@keyframes slide-from-right {
  from {
    transform: translateX(90px);
  }
}

@keyframes slide-to-left {
  to {
    transform: translateX(-90px);
  }
}

/* define animations for the old and new content */
::view-transition-old(slide-it) {
  animation: 180ms cubic-bezier(0.4, 0, 1, 1) both fade-out,
    600ms cubic-bezier(0.4, 0, 0.2, 1) both slide-to-left;
}
::view-transition-new(slide-it) {
  animation: 420ms cubic-bezier(0, 0, 0.2, 1) 90ms both fade-in,
    600ms cubic-bezier(0.4, 0, 0.2, 1) both slide-from-right;
}

/* tie the view transition to a given CSS class */
.sample-transition {
  view-transition-name: slide-it;
}

.choices {
  @apply relative overflow-hidden;
}

.choices:focus {
  @apply outline-0;
}

.choices:last-child {
  @apply mb-0;
}

.choices.is-open {
  @apply overflow-visible;
}

.choices.is-disabled .choices__inner,
.choices.is-disabled .choices__input {
  @apply bg-base-200 cursor-not-allowed select-none;
}

.choices.is-disabled .choices__item {
  @apply cursor-not-allowed;
}

.choices [hidden] {
  @apply !hidden;
}

.choices[data-type*="select-one"] {
  @apply cursor-pointer;
}

.choices[data-type*="select-one"] .choices__input {
  @apply w-full ring-transparent ring-0 border-0 border-b border-b-base-300;
}

.choices[data-type*="select-one"] .choices__button {
  @apply w-2 ml-0 p-2 bg-center;

  background-image: url(data:image/svg+xml;base64,);
  background-size: 8px;
}

.choices[data-type*="select-one"] .choices__button:focus,
.choices[data-type*="select-one"] .choices__button:hover {
  @apply opacity-100;
}

.choices[data-type*="select-one"] .choices__button:focus {
  box-shadow: 0 0 0 2px #00bcd4;
}

.choices[data-type*="select-one"]
  .choices__item[data-value=""]
  .choices__button {
  @apply hidden;
}

.choices[data-type*="select-one"].is-open::after {
  border-color: transparent transparent #333;
  margin-top: -7.5px;
}

.choices[data-type*="select-one"][dir="rtl"]::after {
  @apply left-3 right-auto;
}

.choices[data-type*="select-one"][dir="rtl"] .choices__button {
  @apply left-0 right-auto ml-6 mr-0;
}

.choices[data-type*="select-multiple"] .choices__inner,
.choices[data-type*="text"] .choices__inner {
  @apply cursor-text inline-table;
}

.choices[data-type*="select-multiple"] .choices__button,
.choices[data-type*="text"] .choices__button {
  @apply relative inline-block w-2;

  background-image: url(data:image/svg+xml;base64,);
  background-size: 8px;
}

.choices[data-type*="select-multiple"] .choices__button:focus,
.choices[data-type*="select-multiple"] .choices__button:hover,
.choices[data-type*="text"] .choices__button:focus,
.choices[data-type*="text"] .choices__button:hover {
  @apply opacity-100;
}

.choices__inner {
  @apply border px-3 py-2 rounded-lg border-base-300;
}

/* .choices__inner:has(select) {
  @apply select select-bordered w-full;
} */

.choices:has(select) .choices__input {
  @apply inline-block text-sm border-0 px-3 ring-0 border-base-300 py-2 !ring-transparent;
}

.choices:has(select[multiple]) .choices__input {
  @apply px-0 py-0;
}

.is-open .choices__inner {
  @apply border rounded-t-lg rounded-b-none;
}

.is-flipped.is-open .choices__inner {
  @apply rounded-b-lg;
}

.choices__list {
  @apply m-0 pl-0 list-none bg-base-100;
}

.choices__list--single {
  @apply flex flex-col justify-center w-full;
}

[dir="rtl"] .choices__list--single {
  @apply pl-4 pr-2;
}

.choices__list--single .choices__item {
  @apply w-full flex items-center justify-between;
}

.choices__list--multiple {
  @apply inline;
}

.choices__list--multiple .choices__item {
  @apply rounded-lg mr-1 break-all box-border inline-flex inline-table;
  background: var(--wga-primary);
  color: var(--wga-primary-content);
  padding: 0.125rem 0.5rem;
}

.choices__list--multiple .choices__item[data-deletable] {
  @apply pr-2;
}

[dir="rtl"] .choices__list--multiple .choices__item {
  @apply mr-0 ml-1;
}

.choices__list--multiple .choices__item.is-highlighted {
  background: var(--wga-secondary);
  color: var(--wga-secondary-content);
}

.is-disabled .choices__list--multiple .choices__item {
  @apply opacity-50;
}

.choices__list--dropdown,
.choices__list[aria-expanded] {
  @apply invisible z-[1] absolute w-full border top-full -mt-px overflow-hidden break-all will-change-auto;
}

.is-open .choices__list--dropdown,
.is-open .choices__list[aria-expanded] {
  @apply border-base-300;
}

.is-active.choices__list--dropdown,
.is-active.choices__list[aria-expanded] {
  @apply visible;
}

.is-open .choices__list--dropdown,
.is-open .choices__list[aria-expanded] {
  @apply border-base-300 rounded-b-lg;
}

.is-flipped .choices__list--dropdown,
.is-flipped .choices__list[aria-expanded] {
  @apply bottom-full mt-0 -mb-px;
}

.choices__list--dropdown .choices__list,
.choices__list[aria-expanded] .choices__list {
  @apply relative max-h-[300px] overflow-auto will-change-auto;
}

.choices__item--choice.is-selected {
  @apply bg-base-200;
}

.choices__list--dropdown .choices__item,
.choices__list[aria-expanded] .choices__item {
  @apply transition duration-300 ease-in-out text-sm px-4 py-2 hover:bg-base-200;
}

[dir="rtl"] .choices__list--dropdown .choices__item,
[dir="rtl"] .choices__list[aria-expanded] .choices__item {
  @apply text-right;
}

@media (min-width: 640px) {
  .choices__list--dropdown .choices__item--selectable,
  .choices__list[aria-expanded] .choices__item--selectable {
    /* @apply pr-[100px]; */
  }

  .choices__list--dropdown .choices__item--selectable::after,
  .choices__list[aria-expanded] .choices__item--selectable::after {
    @apply text-xs opacity-0 absolute right-2 top-1/2 -translate-y-1/2;
  }

  [dir="rtl"] .choices__list--dropdown .choices__item--selectable,
  [dir="rtl"] .choices__list[aria-expanded] .choices__item--selectable {
    @apply text-right pl-[100px] pr-2;
  }

  [dir="rtl"] .choices__list--dropdown .choices__item--selectable::after,
  [dir="rtl"] .choices__list[aria-expanded] .choices__item--selectable::after {
    @apply right-auto left-2;
  }
}

.choices__input {
  @apply inline-block text-sm border-0 px-1 ring-0 border-base-300 py-[0.315rem] !ring-transparent;
}

.choices__list--dropdown .choices__item--selectable.is-highlighted,
.choices__list[aria-expanded] .choices__item--selectable.is-highlighted {
  @apply bg-base-200;
}

.choices__list--dropdown .choices__item--selectable.is-highlighted::after,
.choices__list[aria-expanded] .choices__item--selectable.is-highlighted::after {
  @apply opacity-50;
}

.choices__item {
  @apply cursor-default;
}

.choices__item--selectable {
  @apply cursor-pointer;
}

.choices__item--disabled {
  @apply cursor-not-allowed select-none opacity-50;
}

.choices__heading {
  @apply font-medium text-xs p-2 border-b border-base-300;
}

.choices__button {
  @apply -indent-[9999px] appearance-none border-0 bg-transparent cursor-pointer bg-no-repeat h-2 ml-2;
}

.choices__button:focus,
.choices__input:focus {
  @apply outline-0;
}

.choices__input::-webkit-search-cancel-button,
.choices__input::-webkit-search-decoration,
.choices__input::-webkit-search-results-button,
.choices__input::-webkit-search-results-decoration {
  @apply hidden;
}

.choices__input::-ms-clear,
.choices__input::-ms-reveal {
  @apply hidden w-0 h-0;
}

[dir="rtl"] .choices__input {
  @apply pr-1 pl-0;
}

.choices__placeholder {
  @apply opacity-50;
}

/* Glossary term inline styling */
.glossary-term {
  border-bottom: 1px dotted;
  @apply border-secondary cursor-help;

  &:focus-visible {
    @apply outline-2 outline-offset-2 outline-secondary;
  }
}

/* Glossary popup */
.glossary-popup {
  @apply absolute z-50 max-w-sm max-h-60 overflow-y-auto
    rounded border border-base-300 bg-base-100 p-4 shadow-lg
    text-sm leading-relaxed;
}

.glossary-popup a {
  @apply text-primary underline;
}

.glossary-popup-close {
  @apply absolute top-1 right-1;
  width: 1.5rem;
  height: 1.5rem;
  border: 0;
  border-radius: 9999px;
  background: transparent;
  color: var(--wga-base-content);
  cursor: pointer;
}

.artist-index {
  width: min(var(--wga-content-width, 1440px), calc(100% - 3rem));
  margin: 0 auto;
  padding: 3rem 0 4rem;
}

.artist-index__header {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 2rem;
  padding-bottom: 2rem;
  border-bottom: 1px solid var(--color-base-300);
}

.artist-index__eyebrow {
  margin-bottom: 0.5rem;
  color: var(--color-primary);
  font-family: "Lexend", sans-serif;
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.16em;
  text-transform: uppercase;
}

.artist-index h1 {
  margin: 0;
  color: var(--color-primary);
  font-family: "Merriweather", serif;
  font-size: clamp(2.25rem, 5vw, 3.75rem);
  line-height: 1;
}

.artist-index__summary {
  max-width: 38rem;
  margin: 1rem 0 0;
  color: color-mix(in oklab, var(--color-base-content) 72%, transparent);
}

.artist-index__search {
  display: block;
  width: min(100%, 20rem);
}

.artist-index__search input {
  width: 100%;
  border: 1px solid var(--color-base-300);
  border-radius: 0;
  background: var(--color-base-100);
  padding: 0.75rem 1rem;
  font: inherit;
}

.artist-index__search input:focus {
  outline: 2px solid var(--color-primary);
  outline-offset: 2px;
}

.artist-index__alphabet {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(2.5rem, 1fr));
  gap: 0.5rem;
  margin: 1.5rem 0;
}

.artist-index__alphabet a {
  display: grid;
  min-height: 2.5rem;
  place-items: center;
  border: 1px solid var(--color-base-300);
  background: var(--color-base-100);
  color: var(--color-base-content);
  font-family: "JetBrains Mono", monospace;
  font-size: 0.75rem;
  font-weight: 700;
  text-decoration: none;
}

.artist-index__alphabet a:first-child {
  padding: 0 0.75rem;
}

.artist-index__alphabet a[aria-current="page"],
.artist-index__alphabet a:hover,
.artist-index__alphabet a:focus-visible {
  border-color: var(--color-primary);
  background: var(--color-primary);
  color: var(--color-primary-content);
  outline: none;
}

.artist-index__table-wrap {
  overflow-x: auto;
  border: 1px solid var(--color-base-300);
}

.artist-index__table {
  width: 100%;
  min-width: 38rem;
  border-collapse: collapse;
}

.artist-index__table th,
.artist-index__table td {
  padding: 0.9rem 1rem;
  border-bottom: 1px solid var(--color-base-300);
  text-align: left;
}

.artist-index__table th {
  background: var(--color-base-200);
  color: color-mix(in oklab, var(--color-base-content) 72%, transparent);
  font-family: "JetBrains Mono", monospace;
  font-size: 0.7rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.artist-index__table th:nth-child(2),
.artist-index__table td:nth-child(2) {
  width: 10rem;
  font-family: "JetBrains Mono", monospace;
  font-size: 0.8rem;
}

.artist-index__table th:last-child,
.artist-index__table td:last-child {
  width: 20%;
  text-align: right;
}

.artist-index__table tbody tr:hover {
  background: var(--color-base-200);
}

.artist-index__table tbody tr:last-child td {
  border-bottom: 0;
}

.artist-index__table a {
  color: var(--color-primary);
  font-family: "Merriweather", serif;
  font-size: 1.05rem;
  font-weight: 700;
  text-decoration: none;
}

.artist-index__table a:hover,
.artist-index__table a:focus-visible {
  text-decoration: underline;
  text-underline-offset: 0.18em;
}

.artist-index__table mark {
  background: color-mix(in oklab, var(--color-secondary) 35%, transparent);
  color: inherit;
}

.artist-index__empty {
  color: color-mix(in oklab, var(--color-base-content) 72%, transparent);
  font-style: italic;
  text-align: center !important;
}

.artist-index__pagination {
  display: flex;
  justify-content: center;
  margin-top: 1.5rem;
}

.artist-index__pagination .pagination {
  justify-content: center;
}

@media (max-width: 640px) {
  .artist-index {
    width: min(100% - 2rem, var(--wga-content-width, 1440px));
    padding-top: 2rem;
  }

  .artist-index__header {
    align-items: stretch;
    flex-direction: column;
    gap: 1.25rem;
  }

  .artist-index__search {
    width: 100%;
  }

  .artist-index__alphabet {
    grid-template-columns: repeat(7, 1fr);
  }

  .artist-index__alphabet a:first-child {
    grid-column: span 2;
  }
}
