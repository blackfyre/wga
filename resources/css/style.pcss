	--wga-text-2: #b8b2a5;
	--wga-muted: #a49e90;
	--wga-faint: #9c9689;
	--wga-faint-2: #837d71;
	--wga-accent: #8fb6de;
	--wga-accent-2: #b2cfee;
	--wga-accent-tint: rgb(143 182 222 / 0.1);
	--wga-accent-tint-2: rgb(143 182 222 / 0.15);
	--wga-accent-soft: rgb(143 182 222 / 0.4);
	--wga-accent-soft-2: rgb(143 182 222 / 0.55);
	--wga-accent-strong: rgb(46 90 140 / 0.92);
	--wga-rule-soft: rgb(237 234 225 / 0.08);
	--wga-rule: rgb(237 234 225 / 0.14);
	--wga-rule-2: rgb(237 234 225 / 0.2);
	--wga-rule-3: rgb(237 234 225 / 0.28);
	--wga-rule-4: rgb(237 234 225 / 0.36);
	--wga-rule-control: rgb(237 234 225 / 0.55);
	--wga-scrim: rgb(0 0 0 / 0.62);
	--wga-series-0: #e4edf5;
	--wga-series-1: #c6d8e8;
	--wga-series-2: #a8c2db;
	--wga-series-3: #89a9cb;
	--wga-series-4: #6e90b8;
	--wga-series-5: #57779f;
	--wga-series-6: #4c6e96;
	--wga-lane-movements: #a8c2db;
	--wga-lane-movements-fg: #17160f;
	--wga-lane-artists: #89a9cb;
	--wga-lane-artists-fg: #17160f;
	--wga-lane-works: #6e90b8;
	--wga-lane-works-fg: #17160f;
	--wga-lane-buildings: #8fb3d4;
